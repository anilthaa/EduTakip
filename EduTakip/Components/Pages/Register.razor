@page "/register"
@rendermode InteractiveServer
@layout EmptyLayout
@inject IAuthService AuthService
@inject AuthStateService AuthStateService
@inject NavigationManager Navigation
@inject NotificationService NotificationService
@inject EduTakipDBContext DbContext

<PageTitle>Kayıt Ol</PageTitle>

<style>
    html, body {
        overflow: hidden !important;
        height: 100% !important;
    }
</style>

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <h2>Kayıt Ol</h2>
            <p>Yeni hesap oluşturun</p>
        </div>

        <RadzenTabs SelectedIndex="@selectedUserTypeIndex" SelectedIndexChanged="@OnSelectedIndexChanged" class="w-100" Style="margin-bottom: 0.75rem; margin-top: 0;">
            <Tabs>
                <RadzenTabsItem Text="Öğrenci" />
                <RadzenTabsItem Text="Öğretmen" />
            </Tabs>
        </RadzenTabs>

        <RadzenTemplateForm Data="@registerModel" TItem="RegisterModel" Submit="@OnRegister" class="auth-form">
            <RadzenFieldset Text="Kayıt Bilgileri" class="w-100">
                <RadzenStack Gap="1rem">
                        <RadzenFormField Text="Ad" class="w-100">
                            <RadzenTextBox @bind-Value="registerModel.Adi" Placeholder="Adınızı girin" class="w-100" />
                            <RadzenFormFieldValidator />
                        </RadzenFormField>
                   
                        <RadzenFormField Text="Soyad" class="w-100">
                            <RadzenTextBox @bind-Value="registerModel.Soyadi" Placeholder="Soyadınızı girin" class="w-100" />
                            <RadzenFormFieldValidator />
                        </RadzenFormField>
                    
                        <RadzenFormField Text="E-posta" class="w-100">
                            <RadzenTextBox @bind-Value="registerModel.EPosta" Placeholder="ornek@email.com" class="w-100" />
                            <RadzenFormFieldValidator />
                        </RadzenFormField>
                   
                        <RadzenFormField Text="Şifre" class="w-100">
                            <RadzenPassword @bind-Value="registerModel.Sifre" Placeholder="En az 6 karakter" class="w-100" />
                            <RadzenFormFieldValidator />
                        </RadzenFormField>
                    

                    @if (selectedUserType == "ogrenci")
                    {
                            <RadzenFormField Text="Öğrenci No" class="w-100">
                                <RadzenTextBox @bind-Value="registerModel.OgrenciNo" Placeholder="Öğrenci numaranızı girin" class="w-100" />
                                <RadzenFormFieldValidator />
                            </RadzenFormField>
                    }

                    @if (selectedUserType == "ogretmen")
                    {
                            <RadzenFormField Text="Birim" class="w-100">
                                <RadzenDropDown Data="@birimler" TextProperty="Adi" ValueProperty="ID" 
                                               @bind-Value="registerModel.Birim_ID" 
                                               Placeholder="Birim seçin" class="w-100" />
                                <RadzenFormFieldValidator />
                            </RadzenFormField>
                    }

                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" class="w-100">
                        <RadzenButton ButtonType="ButtonType.Submit" 
                                     Text="Kayıt Ol" 
                                     Icon="person_add" 
                                     IsBusy="@isLoading"
                                     ButtonStyle="ButtonStyle.Primary" 
                                     class="w-100"
                                      Style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);" />
                    </RadzenStack>

                    <div class="text-center w-100" style="margin-top: 0.5rem;">
                        <span>Zaten hesabınız var mı? </span>
                        <RadzenLink Path="/login" Text="Giriş Yap" />
                    </div>
                </RadzenStack>
            </RadzenFieldset>
        </RadzenTemplateForm>
    </div>
</div>

@code {
    private RegisterModel registerModel = new();
    private int? kullaniciTip_ID = null;
    
    private bool isLoading = false;
    private bool isInitialized = false;
    private int selectedUserTypeIndex = 0; // Varsayılan olarak Öğrenci seçili
    private string selectedUserType = "ogrenci";
    private List<ItemBirim> birimler = new();
    private List<ItemKullaniciTip> kullaniciTipleri = new();

    public class RegisterModel
    {
        public string Adi { get; set; } = "";
        public string Soyadi { get; set; } = "";
        public string EPosta { get; set; } = "";
        public string Sifre { get; set; } = "";
        public int? Sinif_ID { get; set; }
        public string OgrenciNo { get; set; } = "";
        public int? Birim_ID { get; set; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AuthStateService.InitializeAsync();
            
            if (AuthStateService.IsAuthenticated)
            {
                Navigation.NavigateTo("/dashboard");
                return;
            }
            
            // Kullanıcı tiplerini ve birimleri yükle (sınıflar artık gerekli değil)
            kullaniciTipleri = await DbContext.KullaniciTipleri
                .Where(kt => kt.Aktif && kt.DelDate == null)
                .ToListAsync();
            
            birimler = await DbContext.Birimler
                .Where(b => b.Aktif && b.DelDate == null)
                .OrderBy(b => b.Adi)
                .ToListAsync();
            
            // Varsayılan kullanıcı tipini ayarla
            OnUserTypeChanged();
            
            isInitialized = true;
            StateHasChanged();
        }
    }

    private void OnSelectedIndexChanged(int value)
    {
        selectedUserTypeIndex = value;
        OnUserTypeChanged();
    }

    private void OnUserTypeChanged()
    {
        // Index'e göre kullanıcı tipini belirle
        if (selectedUserTypeIndex == 0)
        {
            selectedUserType = "ogrenci";
        }
        else if (selectedUserTypeIndex == 1)
        {
            selectedUserType = "ogretmen";
        }
        
        // Kullanıcı tipi ID'sini ayarla - Türkçe karakterleri normalize et
        var normalizedUserType = selectedUserType.ToLower()
            .Replace("ö", "o")
            .Replace("ğ", "g")
            .Replace("ü", "u")
            .Replace("ş", "s")
            .Replace("ı", "i")
            .Replace("ç", "c");
        
        var kullaniciTip = kullaniciTipleri.FirstOrDefault(kt => 
        {
            var normalizedAdi = kt.Adi.ToLower()
                .Replace("ö", "o")
                .Replace("ğ", "g")
                .Replace("ü", "u")
                .Replace("ş", "s")
                .Replace("ı", "i")
                .Replace("ç", "c");
            return normalizedAdi.Contains(normalizedUserType) || normalizedUserType.Contains(normalizedAdi);
        });
        
        if (kullaniciTip != null)
        {
            kullaniciTip_ID = kullaniciTip.ID;
        }
        
        // Diğer tipin alanlarını temizle
        if (selectedUserType == "ogrenci")
        {
            registerModel.Birim_ID = null;
            registerModel.Sinif_ID = null; // Sınıf seçimi kaldırıldı
        }
        else if (selectedUserType == "ogretmen")
        {
            registerModel.Sinif_ID = null;
            registerModel.OgrenciNo = "";
        }
        
        StateHasChanged();
    }

    private bool IsValidEmail(string email)
    {
        if (string.IsNullOrWhiteSpace(email))
            return false;

        try
        {
            var emailRegex = new System.Text.RegularExpressions.Regex(
                @"^[^@\s]+@[^@\s]+\.[^@\s]+$",
                System.Text.RegularExpressions.RegexOptions.IgnoreCase | 
                System.Text.RegularExpressions.RegexOptions.Compiled);
            return emailRegex.IsMatch(email.Trim());
        }
        catch
        {
            return false;
        }
    }

    private bool IsValidName(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return false;
        
        // Ad/soyad en az 2 karakter olmalı ve sadece harf, boşluk, tire, nokta içerebilir
        var nameRegex = new System.Text.RegularExpressions.Regex(
            @"^[a-zA-ZçğıöşüÇĞIİÖŞÜ\s\-\.]{2,50}$",
            System.Text.RegularExpressions.RegexOptions.Compiled);
        return nameRegex.IsMatch(name.Trim());
    }

    private bool IsValidOgrenciNo(string ogrenciNo)
    {
        if (string.IsNullOrWhiteSpace(ogrenciNo))
            return false;
        
        // Öğrenci numarası sadece harf, rakam ve tire içerebilir, 3-20 karakter arası
        var ogrenciNoRegex = new System.Text.RegularExpressions.Regex(
            @"^[a-zA-Z0-9\-]{3,20}$",
            System.Text.RegularExpressions.RegexOptions.Compiled);
        return ogrenciNoRegex.IsMatch(ogrenciNo.Trim());
    }

    private async Task OnRegister(RegisterModel model)
    {
        if (isLoading) return;

        // Validasyon
        if (string.IsNullOrEmpty(selectedUserType))
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Uyarı",
                Detail = "Lütfen kullanıcı tipi seçin.",
                Duration = 4000
            });
            return;
        }

        // Kullanıcı tipi ID kontrolü
        if (!kullaniciTip_ID.HasValue || kullaniciTip_ID.Value <= 0)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Uyarı",
                Detail = "Geçerli bir kullanıcı tipi seçin.",
                Duration = 4000
            });
            return;
        }

        // Ad validasyonu
        if (string.IsNullOrWhiteSpace(model.Adi))
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Uyarı",
                Detail = "Lütfen adınızı girin.",
                Duration = 4000
            });
            return;
        }

        if (!IsValidName(model.Adi))
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Uyarı",
                Detail = "Ad en az 2 karakter olmalı ve sadece harf içermelidir.",
                Duration = 4000
            });
            return;
        }

        // Soyad validasyonu
        if (string.IsNullOrWhiteSpace(model.Soyadi))
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Uyarı",
                Detail = "Lütfen soyadınızı girin.",
                Duration = 4000
            });
            return;
        }

        if (!IsValidName(model.Soyadi))
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Uyarı",
                Detail = "Soyad en az 2 karakter olmalı ve sadece harf içermelidir.",
                Duration = 4000
            });
            return;
        }

        // E-posta validasyonu
        if (string.IsNullOrWhiteSpace(model.EPosta))
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Uyarı",
                Detail = "Lütfen e-posta adresinizi girin.",
                Duration = 4000
            });
            return;
        }

        if (!IsValidEmail(model.EPosta))
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Uyarı",
                Detail = "Lütfen geçerli bir e-posta adresi girin.",
                Duration = 4000
            });
            return;
        }

        // Şifre validasyonu
        if (string.IsNullOrWhiteSpace(model.Sifre))
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Uyarı",
                Detail = "Lütfen şifrenizi girin.",
                Duration = 4000
            });
            return;
        }

        if (model.Sifre.Length < 6)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Uyarı",
                Detail = "Şifre en az 6 karakter olmalıdır.",
                Duration = 4000
            });
            return;
        }

        if (model.Sifre.Length > 100)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Uyarı",
                Detail = "Şifre en fazla 100 karakter olabilir.",
                Duration = 4000
            });
            return;
        }

        // Öğrenci için özel kontroller
        if (selectedUserType == "ogrenci")
        {
            if (string.IsNullOrWhiteSpace(model.OgrenciNo))
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Warning,
                    Summary = "Uyarı",
                    Detail = "Lütfen öğrenci numarası bilgisini girin.",
                    Duration = 4000
                });
                return;
            }

            if (!IsValidOgrenciNo(model.OgrenciNo))
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Warning,
                    Summary = "Uyarı",
                    Detail = "Öğrenci numarası 3-20 karakter arası olmalı ve sadece harf, rakam ve tire içermelidir.",
                    Duration = 4000
                });
                return;
            }
        }
        else if (selectedUserType == "ogretmen")
        {
            if (!model.Birim_ID.HasValue)
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Warning,
                    Summary = "Uyarı",
                    Detail = "Lütfen birim bilgisini girin.",
                    Duration = 4000
                });
                return;
            }
        }

        isLoading = true;
        StateHasChanged();
        
        try
        {
            var request = new RegisterRequest(
                model.Adi,
                model.Soyadi,
                model.EPosta,
                model.Sifre,
                kullaniciTip_ID,
                model.Sinif_ID,
                model.OgrenciNo,
                model.Birim_ID
            );

            var result = await AuthService.RegisterAsync(request);
            
            if (result != null)
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Kayıt Başarılı",
                    Detail = "Kayıt başarıyla oluşturuldu. E-postanıza gönderilen doğrulama kodunu girin. E-posta onayından sonra admin onayı beklenmektedir.",
                    Duration = 5000
                });
                
                // E-posta doğrulama sayfasına yönlendir
                await Task.Delay(2000);
                Navigation.NavigateTo($"/confirm-email?email={Uri.EscapeDataString(model.EPosta)}");
            }
            else
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Hata",
                    Detail = "Kayıt oluşturulamadı. Lütfen tekrar deneyin.",
                    Duration = 4000
                });
            }
        }
        catch (HttpRequestException ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Hata",
                Detail = ex.Message,
                Duration = 5000
            });
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Hata",
                Detail = $"Bir hata oluştu: {ex.Message}",
                Duration = 5000
            });
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}

