@page "/register"

@layout EmptyLayout

<PageTitle>Kayıt Ol</PageTitle>

<div class="auth-container">
    <div class="auth-card">

        <div class="auth-header">
            <h2>Hesap Oluştur</h2>
            <p>EduTakip'e katılın</p>
        </div>

        <div class="auth-tabs">
            <div class="tabs">
                <button class="tab-item @(selectedUserTypeIndex == 0 ? "active" : "")" @onclick='() => OnSelectedIndexChanged(0)'>Öğrenci</button>
                <button class="tab-item @(selectedUserTypeIndex == 1 ? "active" : "")" @onclick='() => OnSelectedIndexChanged(1)'>Öğretmen</button>
            </div>
        </div>

        <form @onsubmit="() => OnRegister(registerModel)" @onsubmit:preventDefault class="auth-form">
            <div class="auth-form-inner">
                <div class="form-group">
                    <label class="form-label">Ad</label>
                    <input type="text" class="form-control" @bind="registerModel.Adi" placeholder="Adınızı girin" />
                </div>

                <div class="form-group">
                    <label class="form-label">Soyad</label>
                    <input type="text" class="form-control" @bind="registerModel.Soyadi" placeholder="Soyadınızı girin" />
                </div>

                <div class="form-group">
                    <label class="form-label">E-posta</label>
                    <input type="text" class="form-control" @bind="registerModel.EPosta" placeholder="ornek@email.com" />
                </div>

                <div class="form-group">
                    <label class="form-label">Şifre</label>
                    <PasswordInput @bind-Value="registerModel.Sifre" Placeholder="En az 6 karakter" />
                </div>

                @if (selectedUserType == "ogrenci")
                {
                    <div class="form-group">
                        <label class="form-label">Öğrenci No</label>
                        <input type="text" class="form-control" @bind="registerModel.OgrenciNo" placeholder="Öğrenci numaranızı girin" />
                    </div>
                }

                @if (selectedUserType == "ogretmen")
                {
                    <div class="form-group">
                        <label class="form-label">Birim</label>
                        <select class="form-select" @bind="registerModel.Birim_ID">
                            <option value="">Birim seçin</option>
                            @foreach (var birim in birimler)
                            {
                                <option value="@birim.ID">@birim.Adi</option>
                            }
                        </select>
                    </div>
                }

                <div class="auth-actions">
                    <button type="submit"
                            class="btn btn-gradient btn-auth-primary @(isLoading ? "btn-loading" : "")"
                            disabled="@isLoading">
                        Kayıt Ol
                    </button>
                </div>
            </div>
        </form>

        <div class="auth-footer">
            <span>Zaten hesabınız var mı? </span>
            <a href="/login">Giriş Yap</a>
        </div>
    </div>
</div>

@code {
    private RegisterModel registerModel = new();
    private int? kullaniciTip_ID = null;
    
    private bool isLoading = false;
    private bool isInitialized = false;
    private int selectedUserTypeIndex = 0; // Varsayılan olarak Öğrenci seçili
    private string selectedUserType = "ogrenci";
    private List<ItemBirim> birimler = new();
    private List<ItemKullaniciTip> kullaniciTipleri = new();

    public class RegisterModel
    {
        public string Adi { get; set; } = "";
        public string Soyadi { get; set; } = "";
        public string EPosta { get; set; } = "";
        public string Sifre { get; set; } = "";
        public int? Sinif_ID { get; set; }
        public string OgrenciNo { get; set; } = "";
        public int? Birim_ID { get; set; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AuthStateService.InitializeAsync();
            
            if (AuthStateService.IsAuthenticated)
            {
                NavigationManager.NavigateTo("/dashboard");
                return;
            }
            
            // Kullanıcı tiplerini ve birimleri yükle (sınıflar artık gerekli değil)
            kullaniciTipleri = await DbContext.KullaniciTipleri
                .Where(kt => kt.Aktif && (kt.DelDate == null || kt.DelDate == default(DateTime)))
                .ToListAsync();
            
            birimler = await DbContext.Birimler
                .Where(b => b.Aktif && (b.DelDate == null || b.DelDate == default(DateTime)))
                .OrderBy(b => b.Adi)
                .ToListAsync();
            
            // Varsayılan kullanıcı tipini ayarla
            OnUserTypeChanged();
            
            isInitialized = true;
            StateHasChanged();
        }
    }

    private void OnSelectedIndexChanged(int value)
    {
        selectedUserTypeIndex = value;
        OnUserTypeChanged();
    }

    private void OnUserTypeChanged()
    {
        // Index'e göre kullanıcı tipini belirle
        if (selectedUserTypeIndex == 0)
        {
            selectedUserType = "ogrenci";
        }
        else if (selectedUserTypeIndex == 1)
        {
            selectedUserType = "ogretmen";
        }
        
        // Kullanıcı tipi ID'sini ayarla - Türkçe karakterleri normalize et
        var normalizedUserType = selectedUserType.ToLower()
            .Replace("ö", "o")
            .Replace("ğ", "g")
            .Replace("ü", "u")
            .Replace("ş", "s")
            .Replace("ı", "i")
            .Replace("ç", "c");
        
        var kullaniciTip = kullaniciTipleri.FirstOrDefault(kt => 
        {
            var normalizedAdi = kt.Adi.ToLower()
                .Replace("ö", "o")
                .Replace("ğ", "g")
                .Replace("ü", "u")
                .Replace("ş", "s")
                .Replace("ı", "i")
                .Replace("ç", "c");
            return normalizedAdi.Contains(normalizedUserType) || normalizedUserType.Contains(normalizedAdi);
        });
        
        if (kullaniciTip != null)
        {
            kullaniciTip_ID = kullaniciTip.ID;
        }
        
        // Diğer tipin alanlarını temizle
        if (selectedUserType == "ogrenci")
        {
            registerModel.Birim_ID = null;
            registerModel.Sinif_ID = null; // Sınıf seçimi kaldırıldı
        }
        else if (selectedUserType == "ogretmen")
        {
            registerModel.Sinif_ID = null;
            registerModel.OgrenciNo = "";
        }
        
        StateHasChanged();
    }

    private bool IsValidEmail(string email)
    {
        if (string.IsNullOrWhiteSpace(email))
            return false;

        try
        {
            var emailRegex = new System.Text.RegularExpressions.Regex(
                @"^[^@\s]+@[^@\s]+\.[^@\s]+$",
                System.Text.RegularExpressions.RegexOptions.IgnoreCase | 
                System.Text.RegularExpressions.RegexOptions.Compiled);
            return emailRegex.IsMatch(email.Trim());
        }
        catch
        {
            return false;
        }
    }

    private bool IsValidName(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return false;
        
        // Ad/soyad en az 2 karakter olmalı ve sadece harf, boşluk, tire, nokta içerebilir
        var nameRegex = new System.Text.RegularExpressions.Regex(
            @"^[a-zA-ZçğıöşüÇĞIİÖŞÜ\s\-\.]{2,50}$",
            System.Text.RegularExpressions.RegexOptions.Compiled);
        return nameRegex.IsMatch(name.Trim());
    }

    private bool IsValidOgrenciNo(string ogrenciNo)
    {
        if (string.IsNullOrWhiteSpace(ogrenciNo))
            return false;
        
        // Öğrenci numarası sadece harf, rakam ve tire içerebilir, 3-20 karakter arası
        var ogrenciNoRegex = new System.Text.RegularExpressions.Regex(
            @"^[a-zA-Z0-9\-]{3,20}$",
            System.Text.RegularExpressions.RegexOptions.Compiled);
        return ogrenciNoRegex.IsMatch(ogrenciNo.Trim());
    }

    private async Task OnRegister(RegisterModel model)
    {
        if (isLoading) return;

        // Validasyon
        if (string.IsNullOrEmpty(selectedUserType))
        {
            ToastService.Notify(ToastSeverity.Warning, "Uyarı", "Lütfen kullanıcı tipi seçin.", 4000);
            return;
        }

        // Kullanıcı tipi ID kontrolü
        if (!kullaniciTip_ID.HasValue || kullaniciTip_ID.Value <= 0)
        {
            ToastService.Notify(ToastSeverity.Warning, "Uyarı", "Geçerli bir kullanıcı tipi seçin.", 4000);
            return;
        }

        // Ad validasyonu
        if (string.IsNullOrWhiteSpace(model.Adi))
        {
            ToastService.Notify(ToastSeverity.Warning, "Uyarı", "Lütfen adınızı girin.", 4000);
            return;
        }

        if (!IsValidName(model.Adi))
        {
            ToastService.Notify(ToastSeverity.Warning, "Uyarı", "Ad en az 2 karakter olmalı ve sadece harf içermelidir.", 4000);
            return;
        }

        // Soyad validasyonu
        if (string.IsNullOrWhiteSpace(model.Soyadi))
        {
            ToastService.Notify(ToastSeverity.Warning, "Uyarı", "Lütfen soyadınızı girin.", 4000);
            return;
        }

        if (!IsValidName(model.Soyadi))
        {
            ToastService.Notify(ToastSeverity.Warning, "Uyarı", "Soyad en az 2 karakter olmalı ve sadece harf içermelidir.", 4000);
            return;
        }

        // E-posta validasyonu
        if (string.IsNullOrWhiteSpace(model.EPosta))
        {
            ToastService.Notify(ToastSeverity.Warning, "Uyarı", "Lütfen e-posta adresinizi girin.", 4000);
            return;
        }

        if (!IsValidEmail(model.EPosta))
        {
            ToastService.Notify(ToastSeverity.Warning, "Uyarı", "Lütfen geçerli bir e-posta adresi girin.", 4000);
            return;
        }

        // Şifre validasyonu
        if (string.IsNullOrWhiteSpace(model.Sifre))
        {
            ToastService.Notify(ToastSeverity.Warning, "Uyarı", "Lütfen şifrenizi girin.", 4000);
            return;
        }

        if (model.Sifre.Length < 6)
        {
            ToastService.Notify(ToastSeverity.Warning, "Uyarı", "Şifre en az 6 karakter olmalıdır.", 4000);
            return;
        }

        if (model.Sifre.Length > 100)
        {
            ToastService.Notify(ToastSeverity.Warning, "Uyarı", "Şifre en fazla 100 karakter olabilir.", 4000);
            return;
        }

        // Öğrenci için özel kontroller
        if (selectedUserType == "ogrenci")
        {
            if (string.IsNullOrWhiteSpace(model.OgrenciNo))
            {
                ToastService.Notify(ToastSeverity.Warning, "Uyarı", "Lütfen öğrenci numarası bilgisini girin.", 4000);
                return;
            }

            if (!IsValidOgrenciNo(model.OgrenciNo))
            {
                ToastService.Notify(ToastSeverity.Warning, "Uyarı", "Öğrenci numarası 3-20 karakter arası olmalı ve sadece harf, rakam ve tire içermelidir.", 4000);
                return;
            }
        }
        else if (selectedUserType == "ogretmen")
        {
            if (!model.Birim_ID.HasValue)
            {
                ToastService.Notify(ToastSeverity.Warning, "Uyarı", "Lütfen birim bilgisini girin.", 4000);
                return;
            }
        }

        isLoading = true;
        StateHasChanged();
        
        try
        {
            var request = new RegisterRequest(
                model.Adi,
                model.Soyadi,
                model.EPosta,
                model.Sifre,
                kullaniciTip_ID,
                model.Sinif_ID,
                model.OgrenciNo,
                model.Birim_ID
            );

            var result = await AuthService.RegisterAsync(request);
            
            if (result != null)
            {
                ToastService.Notify(ToastSeverity.Success, "Kayıt Başarılı", "Kayıt başarıyla oluşturuldu. E-posta gelmezse doğrulama sayfasındaki 'Kodu Tekrar Gönder' butonunu kullanabilirsiniz.", 7000);
                
                // E-posta doğrulama sayfasına yönlendir
                await Task.Delay(2500);
                NavigationManager.NavigateTo($"/confirm-email?email={Uri.EscapeDataString(model.EPosta)}");
            }
            else
            {
                ToastService.Notify(ToastSeverity.Error, "Hata", "Kayıt oluşturulamadı. Lütfen tekrar deneyin.", 4000);
            }
        }
        catch (HttpRequestException ex)
        {
            ToastService.Notify(ToastSeverity.Error, "Hata", ex.Message, 5000);
        }
        catch (Exception ex)
        {
            ToastService.Notify(ToastSeverity.Error, "Hata", $"Bir hata oluştu: {ex.Message}", 5000);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}
