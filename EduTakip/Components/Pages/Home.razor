@page "/dashboard"

<PageTitle>Dashboard</PageTitle>

@if (AuthStateService.CurrentUser == null)
{
    <div class="container mt-4">
        <p>Yükleniyor...</p>
    </div>
}
else
{
    var kullaniciTip = AuthStateService.CurrentUser.KullaniciTip?.ToLower() ?? "";
    
    @if (kullaniciTip.Contains("admin"))
    {
        @* Admin Dashboard *@
        <h3>Admin Dashboard</h3>
        <div style="width: 100%; margin-top: 20px;">
            <RadzenRow Gap="10px" Style="width: 100%; margin: 0; display: flex; flex-wrap: nowrap; box-sizing: border-box;">
                <RadzenColumn Style="flex: 1 1 0; min-width: 0; padding: 0 5px;">
                    <RadzenCard class="admin-stat-card" Style="border-left:4px solid blue; cursor: pointer; padding: 1rem; width: 100%; box-sizing: border-box;" @onclick="GitSinifListesine">
                        <h5 style="margin: 0 0 0.5rem 0; font-size: 0.9rem;">Toplam Sınıf</h5>
                        <h3 style="margin: 0; font-size: 1.75rem;">@toplamSinif</h3>
                    </RadzenCard>
                </RadzenColumn>

                <RadzenColumn Style="flex: 1 1 0; min-width: 0; padding: 0 5px;">
                    <RadzenCard class="admin-stat-card" Style="border-left:4px solid red; cursor: pointer; padding: 1rem; width: 100%; box-sizing: border-box;" @onclick="GitKullaniciListesine">
                        <h5 style="margin: 0 0 0.5rem 0; font-size: 0.9rem;">Toplam Öğretmen</h5>
                        <h3 style="margin: 0; font-size: 1.75rem;">@toplamOgretmen</h3>
                    </RadzenCard>
                </RadzenColumn>

                <RadzenColumn Style="flex: 1 1 0; min-width: 0; padding: 0 5px;">
                    <RadzenCard class="admin-stat-card" Style="border-left:4px solid yellow; cursor: pointer; padding: 1rem; width: 100%; box-sizing: border-box;" @onclick="GitKullaniciListesine">
                        <h5 style="margin: 0 0 0.5rem 0; font-size: 0.9rem;">Toplam Öğrenci</h5>
                        <h3 style="margin: 0; font-size: 1.75rem;">@toplamOgrenci</h3>
                    </RadzenCard>
                </RadzenColumn>

                <RadzenColumn Style="flex: 1 1 0; min-width: 0; padding: 0 5px;">
                    <RadzenCard class="admin-stat-card" Style="border-left:4px solid green; cursor: pointer; padding: 1rem; width: 100%; box-sizing: border-box;" @onclick="GitDersProgramiListesine">
                        <h5 style="margin: 0 0 0.5rem 0; font-size: 0.9rem;">Bugünkü Katılım %</h5>
                        <h3 style="margin: 0; font-size: 1.75rem;">@bugunkuKatilimYuzdesi.ToString("F1")%</h3>
                    </RadzenCard>
                </RadzenColumn>

                <RadzenColumn Style="flex: 1 1 0; min-width: 0; padding: 0 5px;">
                    <RadzenCard class="admin-stat-card" Style="border-left:4px solid purple; cursor: pointer; padding: 1rem; width: 100%; box-sizing: border-box;" @onclick="GitDersProgramiListesine">
                        <h5 style="margin: 0 0 0.5rem 0; font-size: 0.9rem;">Aktif Ders Programı</h5>
                        <h3 style="margin: 0; font-size: 1.75rem;">@aktifDersProgrami</h3>
                    </RadzenCard>
                </RadzenColumn>

                <RadzenColumn Style="flex: 1 1 0; min-width: 0; padding: 0 5px;">
                    <RadzenCard class="admin-stat-card" Style="border-left:4px solid orange; cursor: pointer; padding: 1rem; width: 100%; box-sizing: border-box;" @onclick="GitBekleyenHesaplara">
                        <h5 style="margin: 0 0 0.5rem 0; font-size: 0.9rem;">Onay Bekleyen</h5>
                        <h3 style="margin: 0; font-size: 1.75rem;">@onayBekleyenHesapSayisi</h3>
                    </RadzenCard>
                </RadzenColumn>
            </RadzenRow>
        </div>

        @* Grafikler *@
        <RadzenRow Gap="20px" Style="margin-top: 30px;">
            <RadzenColumn Size="6">
                <RadzenCard>
                    <h4 style="margin-bottom: 1rem;">Son 7 Gün Katılım Grafiği</h4>
                    <RadzenChart>
                        <RadzenLineSeries Data="@son7GunKatilim" CategoryProperty="Tarih" ValueProperty="KatilimYuzdesi" Title="Katılım %">
                            <RadzenMarkers />
                        </RadzenLineSeries>
                        <RadzenCategoryAxis Padding="20" />
                        <RadzenValueAxis>
                            <RadzenGridLines />
                            <RadzenAxisTitle Text="Katılım %" />
                        </RadzenValueAxis>
                    </RadzenChart>
                </RadzenCard>
            </RadzenColumn>

            <RadzenColumn Size="6">
                <RadzenCard>
                    <h4 style="margin-bottom: 1rem;">Sınıf Bazlı Öğrenci Dağılımı</h4>
                    <RadzenChart>
                        <RadzenPieSeries Data="@sinifBazliOgrenciDagilimi" CategoryProperty="SinifAdi" ValueProperty="OgrenciSayisi" />
                        <RadzenLegend />
                    </RadzenChart>
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>

        @* Uyarı Tablosu *@
        <RadzenCard Style="margin-top: 30px;">
            <h4 style="margin-bottom: 1rem;">Sistem Uyarıları</h4>
            <RadzenRow Gap="20px">
                <RadzenColumn Size="4">
                    <h5 style="margin-bottom: 0.75rem; color: #ff9800;">Öğretmeni Olmayan Dersler</h5>
                    @if (toplamDers == 0)
                    {
                        <p style="color: #999; font-style: italic; padding: 10px;">Henüz ders tanımlanmamış</p>
                    }
                    else if (ogretmeniOlmayanDersler.Any())
                    {
                        <RadzenDataGrid Data="@ogretmeniOlmayanDersler" TItem="ItemDers" AllowPaging="false" Style="max-height: 200px;">
                            <Columns>
                                <RadzenDataGridColumn Property="Adi" Title="Ders Adı" />
                            </Columns>
                        </RadzenDataGrid>
                    }
                    else
                    {
                        <p style="color: #4caf50; font-style: italic; padding: 10px;">Tüm derslerin öğretmeni var</p>
                    }
                </RadzenColumn>

                <RadzenColumn Size="4">
                    <h5 style="margin-bottom: 0.75rem; color: #ff9800;">Öğrencisi Olmayan Sınıflar</h5>
                    @if (toplamSinif == 0)
                    {
                        <p style="color: #999; font-style: italic; padding: 10px;">Henüz sınıf tanımlanmamış</p>
                    }
                    else if (ogrencisiOlmayanSiniflar.Any())
                    {
                        <RadzenDataGrid Data="@ogrencisiOlmayanSiniflar" TItem="ItemSinif" AllowPaging="false" Style="max-height: 200px;">
                            <Columns>
                                <RadzenDataGridColumn Property="Adi" Title="Sınıf Adı" />
                            </Columns>
                        </RadzenDataGrid>
                    }
                    else
                    {
                        <p style="color: #4caf50; font-style: italic; padding: 10px;">Tüm sınıflarda öğrenci var</p>
                    }
                </RadzenColumn>

                <RadzenColumn Size="4">
                    <h5 style="margin-bottom: 0.75rem; color: #ff9800;">Ders Programı Olmayan Sınıflar</h5>
                    @if (toplamSinif == 0)
                    {
                        <p style="color: #999; font-style: italic; padding: 10px;">Henüz sınıf tanımlanmamış</p>
                    }
                    else if (dersProgramiOlmayanSiniflar.Any())
                    {
                        <RadzenDataGrid Data="@dersProgramiOlmayanSiniflar" TItem="ItemSinif" AllowPaging="false" Style="max-height: 200px;">
                            <Columns>
                                <RadzenDataGridColumn Property="Adi" Title="Sınıf Adı" />
                            </Columns>
                        </RadzenDataGrid>
                    }
                    else
                    {
                        <p style="color: #4caf50; font-style: italic; padding: 10px;">Tüm sınıfların ders programı var</p>
                    }
                </RadzenColumn>
            </RadzenRow>
        </RadzenCard>

        @* Bugünkü Dersler Tablosu *@
        <RadzenCard Style="margin-top: 30px; margin-bottom:20px">
            <h4 style="margin-bottom: 1rem;">Bugünkü Dersler</h4>
            @if (bugunkuDerslerAdmin.Any())
            {
                <RadzenDataGrid Data="@bugunkuDerslerAdmin" TItem="ItemDersProgrami" AllowPaging="true" PageSize="10">
                    <Columns>
                        <RadzenDataGridColumn Title="Ders">
                            <Template Context="item">
                                @item.Ders.Adi
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Title="Sınıf">
                            <Template Context="item">
                                @item.Sinif.Adi
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Title="Başlangıç Saati">
                            <Template Context="item">
                                @item.BaslangicSaati.ToString(@"hh\:mm")
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Title="Bitiş Saati">
                            <Template Context="item">
                                @item.BitisSaati.ToString(@"hh\:mm")
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Property="Aktif" Title="Aktif">
                            <Template Context="item">
                                @if (item.Aktif)
                                {
                                    <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Aktif" />
                                }
                                else
                                {
                                    <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="Pasif" />
                                }
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            }
            else
            {
                <p style="color: #666; font-style: italic; padding: 20px; text-align: center;">Bugün ders programı bulunmamaktadır</p>
            }
        </RadzenCard>
    }
    else if (kullaniciTip.Contains("öğrenci") || kullaniciTip.Contains("ogrenci") || kullaniciTip.Contains("student"))
    {
        @* Öğrenci Dashboard *@
        <RadzenRow Gap="20px" Style="margin-bottom:15px;">
            <RadzenColumn Size="3">
                <RadzenCard Style="background:#f44336; color:white; cursor: pointer;" @onclick="GitOdevlerime">
                    <h5>Bekleyen Ödevler</h5>
                    <h2>@bekleyenOdevSayisi</h2>
                </RadzenCard>
            </RadzenColumn>

            <RadzenColumn Size="3">
                <RadzenCard Style="background:#ff9800; color:white; cursor: pointer;" @onclick="GitOdevlerime">
                    <h5>Yaklaşan Teslimler</h5>
                    <h2>@yaklasanTeslimSayisi</h2>
                </RadzenCard>
            </RadzenColumn>

            <RadzenColumn Size="3">
                <RadzenCard Style="background:#2196f3; color:white; cursor: pointer;" @onclick="GitDersProgramima">
                    <h5>Bugünkü Dersler</h5>
                    <h2>@bugunkuDersSayisi</h2>
                </RadzenCard>
            </RadzenColumn>

            <RadzenColumn Size="3">
                <RadzenCard Style="background:#4caf50; color:white; cursor: pointer;" @onclick="GitNotlarima">
                    <h5>Not Ortalaması</h5>
                    <h2>@ortalamaNot.ToString("F2")</h2>
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>

       @*  <RadzenRow Gap="20px" Style="margin-bottom: 20px;">
            <RadzenColumn Size="12">
                <RadzenButton Text="Sınıfa Katıl" Icon="group_add" ButtonStyle="ButtonStyle.Success" 
                             Size="ButtonSize.Large" Click="@GitSinifaKatil" 
                             Style="width: 100%; padding: 1rem;" />
            </RadzenColumn>
        </RadzenRow> *@

        <RadzenRow Gap="20px">
            <RadzenColumn Size="6">
                <RadzenCard>
                    <h4>Bugünkü Ders Programı</h4>
                    <RadzenDataGrid TItem="ItemDersProgrami" Data="@bugunkuDersler" AllowPaging="true" PageSize="5">
                        <Columns>
                            <RadzenDataGridColumn Title="Ders">
                                <Template Context="item">
                                    @item.Ders.Adi
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn Title="Saat">
                                <Template Context="item">
                                    @item.BaslangicSaati.ToString(@"hh\:mm") - @item.BitisSaati.ToString(@"hh\:mm")
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                </RadzenCard>
            </RadzenColumn>
            <RadzenColumn Size="6">
                <RadzenCard>
                    <h4>Son Ödevler</h4>
                    <RadzenDataGrid TItem="ItemOdev" Data="@sonOdevler" AllowPaging="true" PageSize="5">
                        <Columns>
                            <RadzenDataGridColumn Title="Ödev Adı" Property="Baslik"></RadzenDataGridColumn>
                            <RadzenDataGridColumn Title="Teslim Tarihi">
                                <Template Context="item">
                                    @item.SonTeslimTarihi.ToString("dd.MM.yyyy HH:mm")
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>
    }
    else if (kullaniciTip.Contains("öğretmen") || kullaniciTip.Contains("ogretmen") || kullaniciTip.Contains("teacher"))
    {
        @* Öğretmen Dashboard *@
        <RadzenRow Gap="20px" class="mb-4">
            <RadzenColumn Size="3">
                <RadzenCard class="stat-card" Style="border-left:4px solid aqua; cursor: pointer;" @onclick="GitDerslerime">
                    <div class="stat-content">
                        <div>
                            <h6>Dersler</h6>
                            <h2>@dersSayisi</h2>
                        </div>
                        <RadzenIcon Icon="menu_book" class="stat-icon"></RadzenIcon>
                    </div>
                </RadzenCard>
            </RadzenColumn>

            <RadzenColumn Size="3">
                <RadzenCard class="stat-card" Style="border-left:4px solid green; cursor: pointer;" @onclick="GitOdevlerimeOgretmen">
                    <div class="stat-content">
                        <div>
                            <h6>Odevler</h6>
                            <h2>@odevSayisi</h2>
                        </div>
                        <RadzenIcon Icon="assignment" class="stat-icon"></RadzenIcon>
                    </div>
                </RadzenCard>
            </RadzenColumn>

            <RadzenColumn Size="3">
                <RadzenCard class="stat-card" Style="border-left:4px solid orange; cursor: pointer;" @onclick="GitBekleyenTeslimlere">
                    <div class="stat-content">
                        <div>
                            <h6>Bekleyen Teslimler</h6>
                            <h2>@bekleyenTeslim</h2>
                        </div>
                        <RadzenIcon Icon="hourglass_empty" class="stat-icon" />
                    </div>
                </RadzenCard>
            </RadzenColumn>

            <RadzenColumn Size="3">
                <RadzenCard class="stat-card" Style="cursor: pointer; border-left:4px solid purple" @onclick="GitOgrenciListesine">
                    <div class="stat-content">
                        <div>
                            <h6>Sınıflarımdaki Öğrenciler</h6>
                            <h2>@ogrenciSayisi</h2>
                        </div>
                        <RadzenIcon Icon="groups" class="stat-icon" />
                    </div>
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>

        @* <RadzenRow Gap="20px" Style="margin-bottom: 20px; margin-top: 20px;">
            <RadzenColumn Size="12">
                <RadzenButton Text="Sınıfa Katıl" Icon="group_add" ButtonStyle="ButtonStyle.Success" 
                             Size="ButtonSize.Large" Click="@GitSinifaKatil" 
                             Style="width: 100%; padding: 1rem;" />
            </RadzenColumn>
        </RadzenRow> *@

        <RadzenCard Style="margin:0; margin-left:0; padding:20px; width:100%; max-width:none; box-sizing:border-box; border-left:4px solid aqua">
            <h5>Bugünkü Dersler</h5>
            @if (bugunkuDersler.Any())
            {
                <RadzenDataGrid Data="@bugunkuDersler" TItem="ItemDersProgrami">
                    <Columns>
                        <RadzenDataGridColumn Property="Ders.Adi" Title="Ders Adı"></RadzenDataGridColumn>
                        <RadzenDataGridColumn Title="Sınıf">
                            <Template Context="item">
                                @item.Sinif?.Adi
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Title="Başlangıç Saati">
                            <Template Context="item">
                                @item.BaslangicSaati.ToString(@"hh\:mm")
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Title="Bitiş Saati">
                            <Template Context="item">
                                @item.BitisSaati.ToString(@"hh\:mm")
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            }
            else
            {
                <p class="text-muted text-center" style="font-style:italic; padding:10px">Bugün Dersiniz Yok</p>
            }
        </RadzenCard>

        <RadzenCard Style="margin:0; margin-left:0; margin-top:30px; padding:20px; width:100%; max-width:none; box-sizing:border-box; border-left:4px solid orange">
            <h5>Not Bekleyen Teslimler</h5>
            @if (bekleyenTeslimler.Any())
            {
                <RadzenDataGrid Data="@bekleyenTeslimler" TItem="ItemOdevTeslim">
                    <Columns>
                        <RadzenDataGridColumn Title="Öğrenci">
                            <Template Context="item">
                                @item.Ogrenci.Adi @item.Ogrenci.Soyadi
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Property="Odev.Baslik" Title="Ödev"></RadzenDataGridColumn>
                        <RadzenDataGridColumn Title="İşlem">
                            <Template Context="item">
                                <RadzenButton Text="Not Ver" Size="ButtonSize.Small" Click="@(() => GitTeslimlere(item.Odev_ID))"></RadzenButton>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            }
            else
            {
                <p class="text-muted text-center" style="font-style:italic; padding:10px">Not Bekleyen Teslim Yok</p>
            }
        </RadzenCard>
    }
    else
    {
        @* Varsayılan Dashboard *@
        <div class="container mt-4">
            <h1>Hoş Geldiniz, @AuthStateService.CurrentUser.Adi @AuthStateService.CurrentUser.Soyadi!</h1>
            <p>EduTakip sistemine başarıyla giriş yaptınız.</p>
        </div>
    }
}

@code {
    // Admin için
    int toplamSinif;
    int toplamOgretmen;
    int toplamOgrenci;
    int toplamDers;
    decimal bugunkuKatilimYuzdesi;
    int aktifDersProgrami;
    int onayBekleyenHesapSayisi;
    List<GunlukKatilimDto> son7GunKatilim = new();
    List<SinifOgrenciDagilimDto> sinifBazliOgrenciDagilimi = new();
    List<ItemDers> ogretmeniOlmayanDersler = new();
    List<ItemSinif> ogrencisiOlmayanSiniflar = new();
    List<ItemSinif> dersProgramiOlmayanSiniflar = new();
    List<ItemDersProgrami> bugunkuDerslerAdmin = new();

    // Öğrenci için
    int bekleyenOdevSayisi;
    int yaklasanTeslimSayisi;
    int bugunkuDersSayisi;
    decimal ortalamaNot;
    List<ItemDersProgrami> bugunkuDersler = new();
    List<ItemOdev> sonOdevler = new();
    int? ogrenciId;

    // Öğretmen için
    List<ItemOdevTeslim> bekleyenTeslimler = new();
    List<ItemDersProgrami> bugunkuDerslerOgretmen = new();
    int? ogretmenId;
    int dersSayisi;
    int odevSayisi;
    int bekleyenTeslim;
    int ogrenciSayisi;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateService.CurrentUser == null)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        await Yukle();
    }

    async Task Yukle()
    {
        if (AuthStateService.CurrentUser == null) return;

        var kullaniciTip = AuthStateService.CurrentUser.KullaniciTip?.ToLower() ?? "";

        if (kullaniciTip.Contains("admin"))
        {
            await YukleAdmin();
        }
        else if (kullaniciTip.Contains("öğrenci") || kullaniciTip.Contains("ogrenci") || kullaniciTip.Contains("student"))
        {
            await YukleOgrenci();
        }
        else if (kullaniciTip.Contains("öğretmen") || kullaniciTip.Contains("ogretmen") || kullaniciTip.Contains("teacher"))
        {
            await YukleOgretmen();
        }
    }

    // Yardımcı: Soft delete kontrolü (hem null hem default DateTime destekler)
    static bool SilinmemisMi(DateTime? delDate) => delDate == null || delDate == default(DateTime);

    async Task YukleAdmin()
    {
        toplamSinif = await DbContext.Siniflar.CountAsync(x => x.DelDate == null || x.DelDate == default(DateTime));
        toplamOgretmen = await DbContext.Ogretmenler.CountAsync(x => x.DelDate == null || x.DelDate == default(DateTime));
        toplamOgrenci = await DbContext.Ogrenciler.CountAsync(x => x.DelDate == null || x.DelDate == default(DateTime));
        
        // Onay bekleyen hesaplar (EmailConfirmed = true ama Aktif = false ve Reddedildi = false)
        onayBekleyenHesapSayisi = await DbContext.Kullanicilar
            .CountAsync(x => (x.DelDate == null || x.DelDate == default(DateTime)) && x.EmailConfirmed && !x.Aktif && !x.Reddedildi);
        
        // Aktif Ders Programı sayısı
        aktifDersProgrami = await DbContext.DersProgramlari
            .CountAsync(x => (x.DelDate == null || x.DelDate == default(DateTime)) && x.Aktif);
        
        // Bugünkü Katılım % hesaplama
        var bugun = DateTime.Today;
        var bugunGunu = bugun.DayOfWeek;
        
        // Bugünkü ders programlarını al
        var bugunkuDersProgramlari = await DbContext.DersProgramlari
            .Include(x => x.Ders)
            .Where(x => (x.DelDate == null || x.DelDate == default(DateTime)) && x.Gun == bugunGunu && x.Aktif)
            .ToListAsync();
        
        if (bugunkuDersProgramlari.Any())
        {
            // Bugünkü ders ID'lerini al
            var bugunkuDersIdleri = bugunkuDersProgramlari
                .Select(x => x.Ders_ID)
                .Distinct()
                .ToList();
            
            // Bugünkü derslerin toplam katılımcı sayısını hesapla
            var toplamKatilimciSayisi = await DbContext.DersKatilimcilar
                .Where(x => bugunkuDersIdleri.Contains(x.Ders_ID) && (x.DelDate == null || x.DelDate == default(DateTime)))
                .CountAsync();
            
            // Bugünkü katılım kayıtlarını say (bugünün tarihinde giriş yapanlar)
            var bugunkuKatilimSayisi = await DbContext.DersKatilimlar
                .Where(x => bugunkuDersIdleri.Contains(x.Ders_ID) && 
                           (x.DelDate == null || x.DelDate == default(DateTime)) &&
                           x.GirisZamani.Date == bugun.Date)
                .CountAsync();
            
            // Yüzde hesapla
            if (toplamKatilimciSayisi > 0)
            {
                bugunkuKatilimYuzdesi = (decimal)bugunkuKatilimSayisi / toplamKatilimciSayisi * 100;
            }
            else
            {
                bugunkuKatilimYuzdesi = 0;
            }
        }
        else
        {
            bugunkuKatilimYuzdesi = 0;
        }

        // Son 7 gün katılım verilerini çek
        await YukleSon7GunKatilim();

        // Sınıf bazlı öğrenci dağılımını çek
        await YukleSinifBazliOgrenciDagilimi();

        // Uyarı verilerini çek
        await YukleUyariVerileri();

        // Bugünkü ders programlarını çek
        await YukleBugunkuDersler();
    }

    async Task YukleBugunkuDersler()
    {
        var bugun = DateTime.Today;
        var bugunGunu = bugun.DayOfWeek;

        bugunkuDerslerAdmin = await DbContext.DersProgramlari
            .Include(x => x.Ders)
            .Include(x => x.Sinif)
            .Where(x => (x.DelDate == null || x.DelDate == default(DateTime)) && x.Gun == bugunGunu)
            .OrderBy(x => x.BaslangicSaati)
            .ToListAsync();
    }

    async Task YukleUyariVerileri()
    {
        // Öğretmeni olmayan dersler (Ogretmen_ID'si geçersiz veya öğretmen silinmiş)
        var tumDersler = await DbContext.Dersler
            .Where(x => x.DelDate == null || x.DelDate == default(DateTime))
            .ToListAsync();

        toplamDers = tumDersler.Count;

        var aktifOgretmenIdleri = await DbContext.Ogretmenler
            .Where(o => o.DelDate == null || o.DelDate == default(DateTime))
            .Select(o => o.ID)
            .ToListAsync();

        ogretmeniOlmayanDersler = tumDersler
            .Where(d => !aktifOgretmenIdleri.Contains(d.Ogretmen_ID))
            .ToList();

        // Öğrencisi olmayan sınıflar
        var tumSiniflar = await DbContext.Siniflar
            .Where(x => x.DelDate == null || x.DelDate == default(DateTime))
            .ToListAsync();

        ogrencisiOlmayanSiniflar = new List<ItemSinif>();
        foreach (var sinif in tumSiniflar)
        {
            var ogrenciSayisi = await DbContext.Ogrenciler
                .CountAsync(o => o.Sinif_ID == sinif.ID && (o.DelDate == null || o.DelDate == default(DateTime)));
            
            if (ogrenciSayisi == 0)
            {
                ogrencisiOlmayanSiniflar.Add(sinif);
            }
        }

        // Ders programı olmayan sınıflar
        var dersProgramiOlanSinifIdleri = await DbContext.DersProgramlari
            .Where(x => x.DelDate == null || x.DelDate == default(DateTime))
            .Select(x => x.Sinif_ID)
            .Distinct()
            .ToListAsync();

        dersProgramiOlmayanSiniflar = tumSiniflar
            .Where(s => !dersProgramiOlanSinifIdleri.Contains(s.ID))
            .ToList();
    }

    async Task YukleSon7GunKatilim()
    {
        son7GunKatilim = new List<GunlukKatilimDto>();
        var bugun = DateTime.Today;

        // Son 7 günü oluştur
        for (int i = 6; i >= 0; i--)
        {
            var tarih = bugun.AddDays(-i);
            var gun = tarih.DayOfWeek;

            // O günkü ders programlarını al
            var oGunDersProgramlari = await DbContext.DersProgramlari
                .Where(x => (x.DelDate == null || x.DelDate == default(DateTime)) && x.Gun == gun && x.Aktif)
                .ToListAsync();

            if (oGunDersProgramlari.Any())
            {
                var oGunDersIdleri = oGunDersProgramlari
                    .Select(x => x.Ders_ID)
                    .Distinct()
                    .ToList();

                // Toplam katılımcı sayısı
                var toplamKatilimciSayisi = await DbContext.DersKatilimcilar
                    .Where(x => oGunDersIdleri.Contains(x.Ders_ID) && (x.DelDate == null || x.DelDate == default(DateTime)))
                    .CountAsync();

                // O günkü katılım kayıtları
                var oGunKatilimSayisi = await DbContext.DersKatilimlar
                    .Where(x => oGunDersIdleri.Contains(x.Ders_ID) &&
                               (x.DelDate == null || x.DelDate == default(DateTime)) &&
                               x.GirisZamani.Date == tarih.Date)
                    .CountAsync();

                decimal katilimYuzdesi = 0;
                if (toplamKatilimciSayisi > 0)
                {
                    katilimYuzdesi = (decimal)oGunKatilimSayisi / toplamKatilimciSayisi * 100;
                }

                son7GunKatilim.Add(new GunlukKatilimDto
                {
                    Tarih = tarih.ToString("dd.MM"),
                    KatilimYuzdesi = katilimYuzdesi
                });
            }
            else
            {
                son7GunKatilim.Add(new GunlukKatilimDto
                {
                    Tarih = tarih.ToString("dd.MM"),
                    KatilimYuzdesi = 0
                });
            }
        }
    }

    async Task YukleSinifBazliOgrenciDagilimi()
    {
        var siniflar = await DbContext.Siniflar
            .Where(x => x.DelDate == null || x.DelDate == default(DateTime))
            .ToListAsync();

        sinifBazliOgrenciDagilimi = new List<SinifOgrenciDagilimDto>();

        foreach (var sinif in siniflar)
        {
            var ogrenciSayisi = await DbContext.Ogrenciler
                .CountAsync(o => o.Sinif_ID == sinif.ID && (o.DelDate == null || o.DelDate == default(DateTime)));

            if (ogrenciSayisi > 0)
            {
                sinifBazliOgrenciDagilimi.Add(new SinifOgrenciDagilimDto
                {
                    SinifAdi = sinif.Adi,
                    OgrenciSayisi = ogrenciSayisi
                });
            }
        }

        sinifBazliOgrenciDagilimi = sinifBazliOgrenciDagilimi
            .OrderByDescending(x => x.OgrenciSayisi)
            .ToList();
    }

