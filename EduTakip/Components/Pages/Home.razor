@page "/dashboard"

<PageTitle>Dashboard</PageTitle>

@if (AuthStateService.CurrentUser == null)
{
    <div class="container mt-4">
        <p>Yükleniyor...</p>
    </div>
}
else
{
    var kullaniciTip = AuthStateService.CurrentUser.KullaniciTip?.ToLower() ?? "";
    
    @if (kullaniciTip.Contains("admin"))
    {
        @* Admin Dashboard *@
        <h3 style="margin-bottom: 1rem; font-weight: 700; color: #1f2937;">Admin Dashboard</h3>
        <div class="dashboard-stats cols-6">
            <div class="stat-card blue" @onclick="GitSinifListesine">
                <div class="stat-icon-wrap">
                    <span class="material-icons">school</span>
                </div>
                <div class="stat-info">
                    <span class="stat-label">Toplam Sınıf</span>
                    <p class="stat-value">@toplamSinif</p>
                </div>
            </div>

            <div class="stat-card red" @onclick="GitKullaniciListesine">
                <div class="stat-icon-wrap">
                    <span class="material-icons">person</span>
                </div>
                <div class="stat-info">
                    <span class="stat-label">Toplam Öğretmen</span>
                    <p class="stat-value">@toplamOgretmen</p>
                </div>
            </div>

            <div class="stat-card yellow" @onclick="GitKullaniciListesine">
                <div class="stat-icon-wrap">
                    <span class="material-icons">groups</span>
                </div>
                <div class="stat-info">
                    <span class="stat-label">Toplam Öğrenci</span>
                    <p class="stat-value">@toplamOgrenci</p>
                </div>
            </div>

            <div class="stat-card green" @onclick="GitDersProgramiListesine">
                <div class="stat-icon-wrap">
                    <span class="material-icons">trending_up</span>
                </div>
                <div class="stat-info">
                    <span class="stat-label">Bugünkü Katılım</span>
                    <p class="stat-value">%@bugunkuKatilimYuzdesi.ToString("F1")</p>
                </div>
            </div>

            <div class="stat-card purple" @onclick="GitDersProgramiListesine">
                <div class="stat-icon-wrap">
                    <span class="material-icons">calendar_today</span>
                </div>
                <div class="stat-info">
                    <span class="stat-label">Aktif Ders Programı</span>
                    <p class="stat-value">@aktifDersProgrami</p>
                </div>
            </div>

            <div class="stat-card orange" @onclick="GitBekleyenHesaplara">
                <div class="stat-icon-wrap">
                    <span class="material-icons">pending_actions</span>
                </div>
                <div class="stat-info">
                    <span class="stat-label">Onay Bekleyen</span>
                    <p class="stat-value">@onayBekleyenHesapSayisi</p>
                </div>
            </div>
        </div>

        @* Grafikler *@
        <div class="grid grid-2" style="margin-top: 30px; gap: 20px;">
            <div>
                <div class="card">
                    <div class="card-body">
                        <h4 style="margin-bottom: 1rem;">Son 7 Gün Katılım Grafiği</h4>
                        <div class="data-table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Tarih</th>
                                        <th>Katılım %</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in son7GunKatilim)
                                    {
                                        <tr>
                                            <td>@item.Tarih</td>
                                            <td>@item.KatilimYuzdesi.ToString("F1")%</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div>
                <div class="card">
                    <div class="card-body">
                        <h4 style="margin-bottom: 1rem;">Sınıf Bazlı Öğrenci Dağılımı</h4>
                        <div class="data-table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Sınıf Adı</th>
                                        <th>Öğrenci Sayısı</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in sinifBazliOgrenciDagilimi)
                                    {
                                        <tr>
                                            <td>@item.SinifAdi</td>
                                            <td>@item.OgrenciSayisi</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* Uyarı Tablosu *@
        <div class="card" style="margin-top: 30px;">
            <div class="card-body">
                <h4 style="margin-bottom: 1rem;">Sistem Uyarıları</h4>
                <div class="grid grid-3" style="gap: 20px;">
                    <div>
                        <h5 style="margin-bottom: 0.75rem; color: #ff9800;">Öğretmeni Olmayan Dersler</h5>
                        @if (toplamDers == 0)
                        {
                            <p style="color: #999; font-style: italic; padding: 10px;">Henüz ders tanımlanmamış</p>
                        }
                        else if (ogretmeniOlmayanDersler.Any())
                        {
                            <div class="data-table-wrapper" style="max-height: 200px; overflow-y: auto;">
                                <table class="data-table">
                                    <thead>
                                        <tr>
                                            <th>Ders Adı</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in ogretmeniOlmayanDersler)
                                        {
                                            <tr>
                                                <td>@item.Adi</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p style="color: #4caf50; font-style: italic; padding: 10px;">Tüm derslerin öğretmeni var</p>
                        }
                    </div>

                    <div>
                        <h5 style="margin-bottom: 0.75rem; color: #ff9800;">Öğrencisi Olmayan Sınıflar</h5>
                        @if (toplamSinif == 0)
                        {
                            <p style="color: #999; font-style: italic; padding: 10px;">Henüz sınıf tanımlanmamış</p>
                        }
                        else if (ogrencisiOlmayanSiniflar.Any())
                        {
                            <div class="data-table-wrapper" style="max-height: 200px; overflow-y: auto;">
                                <table class="data-table">
                                    <thead>
                                        <tr>
                                            <th>Sınıf Adı</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in ogrencisiOlmayanSiniflar)
                                        {
                                            <tr>
                                                <td>@item.Adi</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p style="color: #4caf50; font-style: italic; padding: 10px;">Tüm sınıflarda öğrenci var</p>
                        }
                    </div>

                    <div>
                        <h5 style="margin-bottom: 0.75rem; color: #ff9800;">Ders Programı Olmayan Sınıflar</h5>
                        @if (toplamSinif == 0)
                        {
                            <p style="color: #999; font-style: italic; padding: 10px;">Henüz sınıf tanımlanmamış</p>
                        }
                        else if (dersProgramiOlmayanSiniflar.Any())
                        {
                            <div class="data-table-wrapper" style="max-height: 200px; overflow-y: auto;">
                                <table class="data-table">
                                    <thead>
                                        <tr>
                                            <th>Sınıf Adı</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in dersProgramiOlmayanSiniflar)
                                        {
                                            <tr>
                                                <td>@item.Adi</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p style="color: #4caf50; font-style: italic; padding: 10px;">Tüm sınıfların ders programı var</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        @* Bugünkü Dersler Tablosu *@
        <div class="card" style="margin-top: 30px; margin-bottom:20px">
            <div class="card-body">
                <h4 style="margin-bottom: 1rem;">Bugünkü Dersler</h4>
                @if (bugunkuDerslerAdmin.Any())
                {
                    <div class="data-table-wrapper">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Ders</th>
                                    <th>Sınıf</th>
                                    <th>Başlangıç Saati</th>
                                    <th>Bitiş Saati</th>
                                    <th>Aktif</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in bugunkuDerslerAdmin)
                                {
                                    <tr>
                                        <td>@item.Ders.Adi</td>
                                        <td>@item.Sinif.Adi</td>
                                        <td>@item.BaslangicSaati.ToString(@"hh\:mm")</td>
                                        <td>@item.BitisSaati.ToString(@"hh\:mm")</td>
                                        <td>
                                            @if (item.Aktif)
                                            {
                                                <span class="badge badge-success">Aktif</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-danger">Pasif</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p style="color: #666; font-style: italic; padding: 20px; text-align: center;">Bugün ders bulunmamaktadır</p>
                }
            </div>
        </div>
    }
    else if (kullaniciTip.Contains("öğrenci") || kullaniciTip.Contains("ogrenci") || kullaniciTip.Contains("student"))
    {
        @* Öğrenci Dashboard *@
        <div class="dashboard-stats cols-4">
            <div class="stat-card red" @onclick="GitOdevlerime">
                <div class="stat-icon-wrap">
                    <span class="material-icons">assignment_late</span>
                </div>
                <div class="stat-info">
                    <span class="stat-label">Bekleyen Ödevler</span>
                    <p class="stat-value">@bekleyenOdevSayisi</p>
                </div>
            </div>

            <div class="stat-card orange" @onclick="GitOdevlerime">
                <div class="stat-icon-wrap">
                    <span class="material-icons">schedule</span>
                </div>
                <div class="stat-info">
                    <span class="stat-label">Yaklaşan Teslimler</span>
                    <p class="stat-value">@yaklasanTeslimSayisi</p>
                </div>
            </div>

            <div class="stat-card blue" @onclick="GitDersProgramima">
                <div class="stat-icon-wrap">
                    <span class="material-icons">menu_book</span>
                </div>
                <div class="stat-info">
                    <span class="stat-label">Bugünkü Dersler</span>
                    <p class="stat-value">@bugunkuDersSayisi</p>
                </div>
            </div>

            <div class="stat-card green" @onclick="GitNotlarima">
                <div class="stat-icon-wrap">
                    <span class="material-icons">grade</span>
                </div>
                <div class="stat-info">
                    <span class="stat-label">Not Ortalaması</span>
                    <p class="stat-value">@ortalamaNot.ToString("F2")</p>
                </div>
            </div>
        </div>

        @*  <div style="margin-bottom: 20px;">
            <button class="btn btn-success" @onclick="GitSinifaKatil" style="width: 100%; padding: 1rem;">
                <span class="material-icons">group_add</span> Sınıfa Katıl
            </button>
        </div> *@

        <div class="grid grid-2" style="gap: 20px;">
            <div>
                <div class="card">
                    <div class="card-body">
                        <h4>Bugünkü Ders Programı</h4>
                        <div class="data-table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Ders</th>
                                        <th>Saat</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in bugunkuDersler)
                                    {
                                        <tr>
                                            <td>@item.Ders.Adi</td>
                                            <td>@item.BaslangicSaati.ToString(@"hh\:mm") - @item.BitisSaati.ToString(@"hh\:mm")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div>
                <div class="card">
                    <div class="card-body">
                        <h4>Son Ödevler</h4>
                        <div class="data-table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Ödev Adı</th>
                                        <th>Teslim Tarihi</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in sonOdevler)
                                    {
                                        <tr>
                                            <td>@item.Baslik</td>
                                            <td>@item.SonTeslimTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (kullaniciTip.Contains("öğretmen") || kullaniciTip.Contains("ogretmen") || kullaniciTip.Contains("teacher"))
    {
        @* Öğretmen Dashboard *@
        <div class="dashboard-stats cols-4">
            <div class="stat-card cyan" @onclick="GitDerslerime">
                <div class="stat-icon-wrap">
                    <span class="material-icons">menu_book</span>
                </div>
                <div class="stat-info">
                    <span class="stat-label">Dersler</span>
                    <p class="stat-value">@dersSayisi</p>
                </div>
            </div>

            <div class="stat-card green" @onclick="GitOdevlerimeOgretmen">
                <div class="stat-icon-wrap">
                    <span class="material-icons">assignment</span>
                </div>
                <div class="stat-info">
                    <span class="stat-label">Ödevler</span>
                    <p class="stat-value">@odevSayisi</p>
                </div>
            </div>

            <div class="stat-card orange" @onclick="GitBekleyenTeslimlere">
                <div class="stat-icon-wrap">
                    <span class="material-icons">hourglass_empty</span>
                </div>
                <div class="stat-info">
                    <span class="stat-label">Bekleyen Teslimler</span>
                    <p class="stat-value">@bekleyenTeslim</p>
                </div>
            </div>

            <div class="stat-card purple" @onclick="GitOgrenciListesine">
                <div class="stat-icon-wrap">
                    <span class="material-icons">groups</span>
                </div>
                <div class="stat-info">
                    <span class="stat-label">Sınıflarımdaki Öğrenciler</span>
                    <p class="stat-value">@ogrenciSayisi</p>
                </div>
            </div>
        </div>

        @* <div style="margin-bottom: 20px; margin-top: 20px;">
            <button class="btn btn-success" @onclick="GitSinifaKatil" style="width: 100%; padding: 1rem;">
                <span class="material-icons">group_add</span> Sınıfa Katıl
            </button>
        </div> *@

        <div class="card" style="margin:0; margin-left:0; padding:20px; width:100%; max-width:none; box-sizing:border-box; border-left:4px solid aqua">
            <div class="card-body">
                <h5>Bugünkü Dersler</h5>
                @if (bugunkuDersler.Any())
                {
                    <div class="data-table-wrapper">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Ders Adı</th>
                                    <th>Sınıf</th>
                                    <th>Başlangıç Saati</th>
                                    <th>Bitiş Saati</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in bugunkuDersler)
                                {
                                    <tr>
                                        <td>@item.Ders.Adi</td>
                                        <td>@item.Sinif?.Adi</td>
                                        <td>@item.BaslangicSaati.ToString(@"hh\:mm")</td>
                                        <td>@item.BitisSaati.ToString(@"hh\:mm")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted text-center" style="font-style:italic; padding:10px">Bugün Dersiniz Yok</p>
                }
            </div>
        </div>

        <div class="card" style="margin:0; margin-left:0; margin-top:30px; padding:20px; width:100%; max-width:none; box-sizing:border-box; border-left:4px solid orange">
            <div class="card-body">
                <h5>Not Bekleyen Teslimler</h5>
                @if (bekleyenTeslimler.Any())
                {
                    <div class="data-table-wrapper">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Öğrenci</th>
                                    <th>Ödev</th>
                                    <th>İşlem</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in bekleyenTeslimler)
                                {
                                    <tr>
                                        <td>@item.Ogrenci.Adi @item.Ogrenci.Soyadi</td>
                                        <td>@item.Odev.Baslik</td>
                                        <td>
                                            <button class="btn btn-primary" @onclick="@(() => GitTeslimlere(item.Odev_ID))">Not Ver</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted text-center" style="font-style:italic; padding:10px">Not Bekleyen Teslim Yok</p>
                }
            </div>
        </div>
    }
    else
    {
        @* Varsayılan Dashboard *@
        <div class="container mt-4">
            <h1>Hoş Geldiniz, @AuthStateService.CurrentUser.Adi @AuthStateService.CurrentUser.Soyadi!</h1>
            <p>EduTakip sistemine başarıyla giriş yaptınız.</p>
        </div>
    }
}

@code {
    // Admin için
    int toplamSinif;
    int toplamOgretmen;
    int toplamOgrenci;
    int toplamDers;
    decimal bugunkuKatilimYuzdesi;
    int aktifDersProgrami;
    int onayBekleyenHesapSayisi;
    List<GunlukKatilimDto> son7GunKatilim = new();
    List<SinifOgrenciDagilimDto> sinifBazliOgrenciDagilimi = new();
    List<ItemDers> ogretmeniOlmayanDersler = new();
    List<ItemSinif> ogrencisiOlmayanSiniflar = new();
    List<ItemSinif> dersProgramiOlmayanSiniflar = new();
    List<ItemDersProgrami> bugunkuDerslerAdmin = new();

    // Öğrenci için
    int bekleyenOdevSayisi;
    int yaklasanTeslimSayisi;
    int bugunkuDersSayisi;
    decimal ortalamaNot;
    List<ItemDersProgrami> bugunkuDersler = new();
    List<ItemOdev> sonOdevler = new();
    int? ogrenciId;

    // Öğretmen için
    List<ItemOdevTeslim> bekleyenTeslimler = new();
    List<ItemDersProgrami> bugunkuDerslerOgretmen = new();
    int? ogretmenId;
    int dersSayisi;
    int odevSayisi;
    int bekleyenTeslim;
    int ogrenciSayisi;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateService.CurrentUser == null)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        await Yukle();
    }

    async Task Yukle()
    {
        if (AuthStateService.CurrentUser == null) return;

        var kullaniciTip = AuthStateService.CurrentUser.KullaniciTip?.ToLower() ?? "";

        if (kullaniciTip.Contains("admin"))
        {
            await YukleAdmin();
        }
        else if (kullaniciTip.Contains("öğrenci") || kullaniciTip.Contains("ogrenci") || kullaniciTip.Contains("student"))
        {
            await YukleOgrenci();
        }
        else if (kullaniciTip.Contains("öğretmen") || kullaniciTip.Contains("ogretmen") || kullaniciTip.Contains("teacher"))
        {
            await YukleOgretmen();
        }
    }

    // Yardımcı: Soft delete kontrolü (hem null hem default DateTime destekler)
    static bool SilinmemisMi(DateTime? delDate) => delDate == null || delDate == default(DateTime);

    async Task YukleAdmin()
    {
        toplamSinif = await DbContext.Siniflar.CountAsync(x => x.DelDate == null || x.DelDate == default(DateTime));
        toplamOgretmen = await DbContext.Ogretmenler.CountAsync(x => x.DelDate == null || x.DelDate == default(DateTime));
        toplamOgrenci = await DbContext.Ogrenciler.CountAsync(x => x.DelDate == null || x.DelDate == default(DateTime));
        
        // Onay bekleyen hesaplar (EmailConfirmed = true ama Aktif = false ve Reddedildi = false)
        onayBekleyenHesapSayisi = await DbContext.Kullanicilar
            .CountAsync(x => (x.DelDate == null || x.DelDate == default(DateTime)) && x.EmailConfirmed && !x.Aktif && !x.Reddedildi);
        
        // Aktif Ders Programı sayısı
        aktifDersProgrami = await DbContext.DersProgramlari
            .CountAsync(x => (x.DelDate == null || x.DelDate == default(DateTime)) && x.Aktif);
        
        // Bugünkü Katılım % hesaplama
        var bugun = DateTime.Today;
        var bugunGunu = bugun.DayOfWeek;
        
        // Bugünkü ders programlarını al
        var bugunkuDersProgramlari = await DbContext.DersProgramlari
            .Include(x => x.Ders)
            .Where(x => (x.DelDate == null || x.DelDate == default(DateTime)) && x.Gun == bugunGunu && x.Aktif)
            .ToListAsync();
        
        if (bugunkuDersProgramlari.Any())
        {
            // Bugünkü ders ID'lerini al
            var bugunkuDersIdleri = bugunkuDersProgramlari
                .Select(x => x.Ders_ID)
                .Distinct()
                .ToList();
            
            // Bugünkü derslerin toplam katılımcı sayısını hesapla
            var toplamKatilimciSayisi = await DbContext.DersKatilimcilar
                .Where(x => bugunkuDersIdleri.Contains(x.Ders_ID) && (x.DelDate == null || x.DelDate == default(DateTime)))
                .CountAsync();
            
            // Bugünkü katılım kayıtlarını say (bugünün tarihinde giriş yapanlar)
            var bugunkuKatilimSayisi = await DbContext.DersKatilimlar
                .Where(x => bugunkuDersIdleri.Contains(x.Ders_ID) && 
                           (x.DelDate == null || x.DelDate == default(DateTime)) &&
                           x.GirisZamani.Date == bugun.Date)
                .CountAsync();
            
            // Yüzde hesapla
            if (toplamKatilimciSayisi > 0)
            {
                bugunkuKatilimYuzdesi = (decimal)bugunkuKatilimSayisi / toplamKatilimciSayisi * 100;
            }
            else
            {
                bugunkuKatilimYuzdesi = 0;
            }
        }
        else
        {
            bugunkuKatilimYuzdesi = 0;
        }

        // Son 7 gün katılım verilerini çek
        await YukleSon7GunKatilim();

        // Sınıf bazlı öğrenci dağılımını çek
        await YukleSinifBazliOgrenciDagilimi();

        // Uyarı verilerini çek
        await YukleUyariVerileri();

        // Bugünkü ders programlarını çek
        await YukleBugunkuDersler();
    }

    async Task YukleBugunkuDersler()
    {
        var bugun = DateTime.Today;
        var bugunGunu = bugun.DayOfWeek;

        bugunkuDerslerAdmin = await DbContext.DersProgramlari
            .Include(x => x.Ders)
            .Include(x => x.Sinif)
            .Where(x => (x.DelDate == null || x.DelDate == default(DateTime)) && x.Gun == bugunGunu)
            .OrderBy(x => x.BaslangicSaati)
            .ToListAsync();
    }

    async Task YukleUyariVerileri()
    {
        // Öğretmeni olmayan dersler (Ogretmen_ID'si geçersiz veya öğretmen silinmiş)
        var tumDersler = await DbContext.Dersler
            .Where(x => x.DelDate == null || x.DelDate == default(DateTime))
            .ToListAsync();

        toplamDers = tumDersler.Count;

        var aktifOgretmenIdleri = await DbContext.Ogretmenler
            .Where(o => o.DelDate == null || o.DelDate == default(DateTime))
            .Select(o => o.ID)
            .ToListAsync();

        ogretmeniOlmayanDersler = tumDersler
            .Where(d => !aktifOgretmenIdleri.Contains(d.Ogretmen_ID))
            .ToList();

        // Öğrencisi olmayan sınıflar
        var tumSiniflar = await DbContext.Siniflar
            .Where(x => x.DelDate == null || x.DelDate == default(DateTime))
            .ToListAsync();

        ogrencisiOlmayanSiniflar = new List<ItemSinif>();
        foreach (var sinif in tumSiniflar)
        {
            var ogrenciSayisi = await DbContext.Ogrenciler
                .CountAsync(o => o.Sinif_ID == sinif.ID && (o.DelDate == null || o.DelDate == default(DateTime)));
            
            if (ogrenciSayisi == 0)
            {
                ogrencisiOlmayanSiniflar.Add(sinif);
            }
        }

        // Ders programı olmayan sınıflar
        var dersProgramiOlanSinifIdleri = await DbContext.DersProgramlari
            .Where(x => x.DelDate == null || x.DelDate == default(DateTime))
            .Select(x => x.Sinif_ID)
            .Distinct()
            .ToListAsync();

        dersProgramiOlmayanSiniflar = tumSiniflar
            .Where(s => !dersProgramiOlanSinifIdleri.Contains(s.ID))
            .ToList();
    }

    async Task YukleSon7GunKatilim()
    {
        son7GunKatilim = new List<GunlukKatilimDto>();
        var bugun = DateTime.Today;

        // Son 7 günü oluştur
        for (int i = 6; i >= 0; i--)
        {
            var tarih = bugun.AddDays(-i);
            var gun = tarih.DayOfWeek;

            // O günkü ders programlarını al
            var oGunDersProgramlari = await DbContext.DersProgramlari
                .Where(x => (x.DelDate == null || x.DelDate == default(DateTime)) && x.Gun == gun && x.Aktif)
                .ToListAsync();

            if (oGunDersProgramlari.Any())
            {
                var oGunDersIdleri = oGunDersProgramlari
                    .Select(x => x.Ders_ID)
                    .Distinct()
                    .ToList();

                // Toplam katılımcı sayısı
                var toplamKatilimciSayisi = await DbContext.DersKatilimcilar
                    .Where(x => oGunDersIdleri.Contains(x.Ders_ID) && (x.DelDate == null || x.DelDate == default(DateTime)))
                    .CountAsync();

                // O günkü katılım kayıtları
                var oGunKatilimSayisi = await DbContext.DersKatilimlar
                    .Where(x => oGunDersIdleri.Contains(x.Ders_ID) &&
                               (x.DelDate == null || x.DelDate == default(DateTime)) &&
                               x.GirisZamani.Date == tarih.Date)
                    .CountAsync();

                decimal katilimYuzdesi = 0;
                if (toplamKatilimciSayisi > 0)
                {
                    katilimYuzdesi = (decimal)oGunKatilimSayisi / toplamKatilimciSayisi * 100;
                }

                son7GunKatilim.Add(new GunlukKatilimDto
                {
                    Tarih = tarih.ToString("dd.MM"),
                    KatilimYuzdesi = katilimYuzdesi
                });
            }
            else
            {
                son7GunKatilim.Add(new GunlukKatilimDto
                {
                    Tarih = tarih.ToString("dd.MM"),
                    KatilimYuzdesi = 0
                });
            }
        }
    }

    async Task YukleSinifBazliOgrenciDagilimi()
    {
        var siniflar = await DbContext.Siniflar
            .Where(x => x.DelDate == null || x.DelDate == default(DateTime))
            .ToListAsync();

        sinifBazliOgrenciDagilimi = new List<SinifOgrenciDagilimDto>();

        foreach (var sinif in siniflar)
        {
            var ogrenciSayisi = await DbContext.Ogrenciler
                .CountAsync(o => o.Sinif_ID == sinif.ID && (o.DelDate == null || o.DelDate == default(DateTime)));

            if (ogrenciSayisi > 0)
            {
                sinifBazliOgrenciDagilimi.Add(new SinifOgrenciDagilimDto
                {
                    SinifAdi = sinif.Adi,
                    OgrenciSayisi = ogrenciSayisi
                });
            }
        }

        sinifBazliOgrenciDagilimi = sinifBazliOgrenciDagilimi
            .OrderByDescending(x => x.OgrenciSayisi)
            .ToList();
    }

