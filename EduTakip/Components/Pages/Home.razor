    async Task YukleOgrenci()
    {
        // Öğrenci ID'sini bul
        ogrenciId = await DbContext.Ogrenciler
            .Where(x => x.Kullanici_ID == AuthStateService.CurrentUser!.ID && (x.DelDate == null || x.DelDate == default(DateTime)))
            .Select(x => x.ID)
            .FirstOrDefaultAsync();

        if (!ogrenciId.HasValue) return;

        var kullaniciId = AuthStateService.CurrentUser!.ID;
        var bugun = DateTime.Today;
        var gun = bugun.DayOfWeek;

        // Öğrencinin kayıtlı olduğu sınıfların ID'lerini bul
        // Ana sınıf (nullable olabilir)
        var anaSinifId = await DbContext.Ogrenciler
            .Where(x => x.ID == ogrenciId.Value && (x.DelDate == null || x.DelDate == default(DateTime)))
            .Select(x => x.Sinif_ID)
            .FirstOrDefaultAsync();

        // Ana sınıfın silinmemiş ve aktif olduğunu kontrol et
        bool anaSinifGecerli = false;
        if (anaSinifId.HasValue && anaSinifId.Value > 0)
        {
            anaSinifGecerli = await DbContext.Siniflar
                .AnyAsync(x => x.ID == anaSinifId.Value && (x.DelDate == null || x.DelDate == default(DateTime)) && x.Aktif);
            
            // Eğer ana sınıf silinmiş veya pasifse, öğrencinin Sinif_ID alanını null yap
            if (!anaSinifGecerli)
            {
                var ogrenci = await DbContext.Ogrenciler
                    .Where(x => x.ID == ogrenciId.Value && (x.DelDate == null || x.DelDate == default(DateTime)))
                    .FirstOrDefaultAsync();
                
                if (ogrenci != null && ogrenci.Sinif_ID == anaSinifId.Value)
                {
                    ogrenci.Sinif_ID = null;
                    ogrenci.UpdDate = DateTime.UtcNow;
                    ogrenci.UpdUser = kullaniciId;
                    DbContext.Ogrenciler.Update(ogrenci);
                    await DbContext.SaveChangesAsync();
                    anaSinifId = null; // Artık geçersiz
                }
            }
        }

        // Aktif ve silinmemiş sınıfların ID'lerini al
        var aktifSinifIdleri = await DbContext.Siniflar
            .Where(x => (x.DelDate == null || x.DelDate == default(DateTime)) && x.Aktif)
            .Select(x => x.ID)
            .ToListAsync();

        // Katıldığı diğer sınıflar (SinifKullanicilar tablosundan) - sadece aktif ve silinmemiş olanlar
        var katildigiSinifIdleri = await DbContext.SinifKullanicilar
            .Where(x => x.Kullanici_ID == kullaniciId && 
                       x.Tip == "Öğrenci" && 
                       (x.DelDate == null || x.DelDate == default(DateTime)) &&
                       aktifSinifIdleri.Contains(x.Sinif_ID))
            .Select(x => x.Sinif_ID)
            .ToListAsync();

        // SinifOgrenciler tablosundan katıldığı sınıflar - sadece aktif ve silinmemiş olanlar
        var sinifOgrenciSinifIdleri = await DbContext.SinifOgrenciler
            .Where(x => x.Ogrenci_ID == ogrenciId.Value && 
                       (x.DelDate == null || x.DelDate == default(DateTime)) &&
                       aktifSinifIdleri.Contains(x.Sinif_ID))
            .Select(x => x.Sinif_ID)
            .ToListAsync();

        // Tüm sınıf ID'lerini birleştir (sadece geçerli olanlar)
        var tumSinifIdleri = new List<int>();
        if (anaSinifId.HasValue && anaSinifId.Value > 0 && anaSinifGecerli)
        {
            tumSinifIdleri.Add(anaSinifId.Value);
        }
        tumSinifIdleri.AddRange(katildigiSinifIdleri);
        tumSinifIdleri.AddRange(sinifOgrenciSinifIdleri);
        tumSinifIdleri = tumSinifIdleri.Distinct().ToList();

        // Öğrencinin katıldığı sınıflardaki ders programlarından ders ID'lerini al
        var ogrenciDersIdleri = new List<int>();
        if (tumSinifIdleri.Any())
        {
            ogrenciDersIdleri = await DbContext.DersProgramlari
                .Where(x => tumSinifIdleri.Contains(x.Sinif_ID) && (x.DelDate == null || x.DelDate == default(DateTime)) && x.Aktif)
                .Select(x => x.Ders_ID)
                .Distinct()
                .ToListAsync();
        }

        // ItemOdevTeslim'de Ogrenci_ID aslında Kullanici_ID olarak kullanılıyor
        // Bekleyen ödev sayısı - öğrencinin katıldığı sınıflardaki derslerin ödevleri
        if (ogrenciDersIdleri.Any())
        {
            bekleyenOdevSayisi = await DbContext.Odevler
                .Where(x => ogrenciDersIdleri.Contains(x.Ders_ID) && 
                           !DbContext.OdevTeslimler.Any(t => t.Odev_ID == x.ID && t.Ogrenci_ID == kullaniciId && (t.DelDate == null || t.DelDate == default(DateTime))) && 
                           (x.DelDate == null || x.DelDate == default(DateTime)))
                .CountAsync();

            yaklasanTeslimSayisi = await DbContext.Odevler
                .Where(x => ogrenciDersIdleri.Contains(x.Ders_ID) && 
                           (x.DelDate == null || x.DelDate == default(DateTime)) && 
                           x.SonTeslimTarihi >= bugun && 
                           x.SonTeslimTarihi <= bugun.AddDays(3))
                .CountAsync();
        }
        else
        {
            bekleyenOdevSayisi = 0;
            yaklasanTeslimSayisi = 0;
        }

        // Bugünkü dersler - öğrencinin katıldığı sınıflardaki ders programları
        if (tumSinifIdleri.Any())
        {
            bugunkuDersler = await DbContext.DersProgramlari
                .Include(x => x.Ders)
                .Where(x => tumSinifIdleri.Contains(x.Sinif_ID) && 
                           x.Gun == gun && 
                           (x.DelDate == null || x.DelDate == default(DateTime)) && 
                           x.Aktif)
                .OrderBy(x => x.BaslangicSaati)
                .ToListAsync();
        }
        else
        {
            bugunkuDersler = new List<ItemDersProgrami>();
        }

        bugunkuDersSayisi = bugunkuDersler.Count;

        // ItemOdevTeslim'de Ogrenci_ID aslında Kullanici_ID olarak kullanılıyor
        // Her ödev için sadece en son teslim kaydını al (aynı ödev için birden fazla teslim olabilir)
        // Önce tüm teslimleri çek, sonra memory'de grupla
        var tumTeslimler = await DbContext.OdevTeslimler
            .Where(x => x.Ogrenci_ID == kullaniciId && (x.DelDate == null || x.DelDate == default(DateTime)) && x.Not != null)
            .ToListAsync();
        
        // Her ödev için sadece en son (en yeni) teslim kaydını al
        var ogrenciNotlari = tumTeslimler
            .GroupBy(x => x.Odev_ID)
            .Select(g => g.OrderByDescending(x => x.TeslimTarihi).ThenByDescending(x => x.ID).First().Not!.Value)
            .ToList();
        
        ortalamaNot = ogrenciNotlari.Any() ? (decimal)ogrenciNotlari.Average() : 0;

        // Son ödevler - öğrencinin katıldığı sınıflardaki derslerin ödevleri
        if (ogrenciDersIdleri.Any())
        {
            sonOdevler = await DbContext.Odevler
                .Include(x => x.Ders)
                .Where(x => ogrenciDersIdleri.Contains(x.Ders_ID) && (x.DelDate == null || x.DelDate == default(DateTime)))
                .OrderByDescending(x => x.CreDate)
                .Take(5)
                .ToListAsync();
        }
        else
        {
            sonOdevler = new List<ItemOdev>();
        }
    }

    async Task YukleOgretmen()
    {
        // Öğretmen ID'sini bul
        ogretmenId = await DbContext.Ogretmenler
            .Where(x => x.Kullanici_ID == AuthStateService.CurrentUser!.ID && (x.DelDate == null || x.DelDate == default(DateTime)))
            .Select(x => x.ID)
            .FirstOrDefaultAsync();

        if (!ogretmenId.HasValue) return;

        dersSayisi = await DbContext.Dersler.CountAsync(x => x.Ogretmen_ID == ogretmenId.Value && (x.DelDate == null || x.DelDate == default(DateTime)));
        odevSayisi = await DbContext.Odevler.CountAsync(x => x.Ders.Ogretmen_ID == ogretmenId.Value && (x.DelDate == null || x.DelDate == default(DateTime)));
        bekleyenTeslim = await DbContext.OdevTeslimler.CountAsync(x => x.Odev.Ders.Ogretmen_ID == ogretmenId.Value && x.Not == null && (x.DelDate == null || x.DelDate == default(DateTime)));
        // Öğretmenin ders programlarındaki sınıf ID'lerini bul
        var ogretmenSinifIdleri = await DbContext.DersProgramlari
            .Include(x => x.Ders)
            .Where(x => x.Ders.Ogretmen_ID == ogretmenId.Value && (x.DelDate == null || x.DelDate == default(DateTime)))
            .Select(x => x.Sinif_ID)
            .Distinct()
            .ToListAsync();

        // Bu sınıflardaki öğrencileri say
        ogrenciSayisi = await DbContext.Ogrenciler
            .Where(x => (x.DelDate == null || x.DelDate == default(DateTime)) && x.Sinif_ID.HasValue && ogretmenSinifIdleri.Contains(x.Sinif_ID.Value))
            .CountAsync();

        var bugun = DateTime.Today.DayOfWeek;
        bugunkuDerslerOgretmen = await DbContext.DersProgramlari
            .Include(x => x.Ders)
            .Include(x => x.Sinif)
            .Where(x => x.Ders.Ogretmen_ID == ogretmenId.Value && x.Gun == bugun && (x.DelDate == null || x.DelDate == default(DateTime)) && x.Aktif)
            .OrderBy(x => x.BaslangicSaati)
            .ToListAsync();
        
        // Öğretmen dashboard'ında kullanılan bugunkuDersler değişkenini de doldur
        bugunkuDersler = bugunkuDerslerOgretmen;

        bekleyenTeslimler = await DbContext.OdevTeslimler
            .Include(x => x.Ogrenci)
            .Include(x => x.Odev)
                .ThenInclude(o => o.Ders)
            .Where(x => x.Odev.Ders.Ogretmen_ID == ogretmenId.Value && x.Not == null && (x.DelDate == null || x.DelDate == default(DateTime)))
            .Take(5)
            .ToListAsync();
    }

