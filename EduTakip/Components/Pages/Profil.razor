@page "/profil"
@attribute [Authorize]

<PageTitle>Profilim - EduTakip</PageTitle>

<div class="container" style="max-width: 800px; margin: 0 auto; padding: 20px;">
    <h3 style="margin-bottom: 24px;">Profilim</h3>

    @if (kullanici == null)
    {
        <div style="text-align: center; padding: 40px;">
            <div class="spinner"></div>
            <p style="margin-top: 10px;">Profil bilgileri yükleniyor...</p>
        </div>
    }
    else
    {
        @* Hesap Durumu *@
        <div class="card" style="margin-bottom: 20px;">
            <div class="card-body">
                <h4 style="margin-bottom: 16px;">Hesap Durumu</h4>
                <div style="display: flex; gap: 12px; flex-wrap: wrap;">
                    <span class="badge" style="@($"background: {(kullanici.Aktif ? "#4caf50" : "#f44336")}; font-size: 14px; padding: 6px 14px;")">
                        @(kullanici.Aktif ? "Aktif" : "Pasif")
                    </span>
                    <span class="badge" style="@($"background: {(kullanici.EmailConfirmed ? "#4caf50" : "#ff9800")}; font-size: 14px; padding: 6px 14px;")">
                        @(kullanici.EmailConfirmed ? "E-posta Onaylı" : "E-posta Onaylanmadı")
                    </span>
                    @if (kullanici.Reddedildi)
                    {
                        <span class="badge" style="background: #f44336; font-size: 14px; padding: 6px 14px;">Reddedildi</span>
                    }
                    <span class="badge" style="background: #667eea; font-size: 14px; padding: 6px 14px;">
                        Kullanıcı Tipi: @kullaniciTipAdi
                    </span>
                </div>
                @if (kullanici.CreDate != default)
                {
                    <p style="margin-top: 12px; color: #999; font-size: 13px;">
                        Kayıt tarihi: @kullanici.CreDate.ToString("dd.MM.yyyy HH:mm")
                    </p>
                }
            </div>
        </div>

        @* Profil Bilgileri *@
        <div class="card" style="margin-bottom: 20px;">
            <div class="card-body">
                <h4 style="margin-bottom: 16px;">Profil Bilgileri</h4>
                <form @onsubmit="OnProfilKaydet" @onsubmit:preventDefault>
                    <div class="flex-stack gap-md">
                        <div class="form-group">
                            <label class="form-label">Ad</label>
                            <input type="text" class="form-control" @bind="profilModel.Adi" required />
                        </div>

                        <div class="form-group">
                            <label class="form-label">Soyad</label>
                            <input type="text" class="form-control" @bind="profilModel.Soyadi" required />
                        </div>

                        <div class="form-group">
                            <label class="form-label">E-posta</label>
                            <input type="text" class="form-control" value="@kullanici.EPosta" readonly />
                        </div>

                        <div class="form-group">
                            <label class="form-label">Kullanıcı Tipi</label>
                            <input type="text" class="form-control" value="@kullaniciTipAdi" readonly />
                        </div>

                        <div style="text-align: right; margin-top: 8px;">
                            <button type="submit" class="btn btn-primary" disabled="@profilKaydediliyor">
                                <span class="material-icons">save</span> Bilgileri Güncelle
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        @* Şifre Değiştirme *@
        <div class="card">
            <div class="card-body">
                <h4 style="margin-bottom: 16px;">Şifre Değiştir</h4>
                <form @onsubmit="OnSifreDegistir" @onsubmit:preventDefault>
                    <div class="flex-stack gap-md">
                        <div class="form-group">
                            <label class="form-label">Mevcut Şifre</label>
                            <input type="password" class="form-control" @bind="sifreModel.MevcutSifre" required />
                        </div>

                        <div class="form-group">
                            <label class="form-label">Yeni Şifre</label>
                            <input type="password" class="form-control" @bind="sifreModel.YeniSifre" required />
                        </div>

                        <div class="form-group">
                            <label class="form-label">Yeni Şifre (Tekrar)</label>
                            <input type="password" class="form-control" @bind="sifreModel.YeniSifreTekrar" required />
                        </div>

                        <div style="text-align: right; margin-top: 8px;">
                            <button type="submit" class="btn btn-warning" disabled="@sifreDegistiriliyor">
                                <span class="material-icons">lock</span> Şifreyi Değiştir
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    }
</div>

@code {
    ItemKullanici? kullanici;
    string kullaniciTipAdi = string.Empty;
    ProfilFormModel profilModel = new();
    SifreFormModel sifreModel = new();
    bool profilKaydediliyor = false;
    bool sifreDegistiriliyor = false;

    class ProfilFormModel
    {
        public string Adi { get; set; } = string.Empty;
        public string Soyadi { get; set; } = string.Empty;
    }

    class SifreFormModel
    {
        public string MevcutSifre { get; set; } = string.Empty;
        public string YeniSifre { get; set; } = string.Empty;
        public string YeniSifreTekrar { get; set; } = string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        var currentUser = AuthStateService.CurrentUser;
        if (currentUser == null)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        kullanici = await DbContext.Kullanicilar
            .Include(k => k.KullaniciTip)
            .FirstOrDefaultAsync(k => k.ID == currentUser.ID && (k.DelDate == null || k.DelDate == default(DateTime)));

        if (kullanici != null)
        {
            kullaniciTipAdi = kullanici.KullaniciTip?.Adi ?? "";
            profilModel.Adi = kullanici.Adi;
            profilModel.Soyadi = kullanici.Soyadi;
        }
        else
        {
            ToastService.Notify(ToastSeverity.Error, "Hata", "Kullanıcı bilgileri yüklenemedi.");
            NavigationManager.NavigateTo("/dashboard");
        }
    }

    async Task OnProfilKaydet()
    {
        if (kullanici == null) return;

        if (string.IsNullOrWhiteSpace(profilModel.Adi) || string.IsNullOrWhiteSpace(profilModel.Soyadi))
        {
            ToastService.Notify(ToastSeverity.Warning, "Uyarı", "Ad ve Soyad alanları boş olamaz.");
            return;
        }

        profilKaydediliyor = true;
        StateHasChanged();

        try
        {
            kullanici.Adi = profilModel.Adi.Trim();
            kullanici.Soyadi = profilModel.Soyadi.Trim();
            kullanici.UpdDate = DateTime.UtcNow;
            kullanici.UpdUser = kullanici.ID;

            DbContext.Kullanicilar.Update(kullanici);
            await DbContext.SaveChangesAsync();

            ToastService.Notify(ToastSeverity.Success, "Başarılı", "Profil bilgileri güncellendi.");
        }
        catch (Exception ex)
        {
            ToastService.Notify(ToastSeverity.Error, "Hata", $"Profil güncellenirken hata oluştu: {ex.Message}");
        }
        finally
        {
            profilKaydediliyor = false;
            StateHasChanged();
        }
    }

    async Task OnSifreDegistir()
    {
        if (kullanici == null) return;

        if (string.IsNullOrWhiteSpace(sifreModel.MevcutSifre))
        {
            ToastService.Notify(ToastSeverity.Warning, "Uyarı", "Mevcut şifre zorunludur.");
            return;
        }

        if (string.IsNullOrWhiteSpace(sifreModel.YeniSifre) || sifreModel.YeniSifre.Length < 6)
        {
            ToastService.Notify(ToastSeverity.Warning, "Uyarı", "Yeni şifre en az 6 karakter olmalıdır.");
            return;
        }

        if (sifreModel.YeniSifre != sifreModel.YeniSifreTekrar)
        {
            ToastService.Notify(ToastSeverity.Warning, "Uyarı", "Yeni şifreler eşleşmiyor.");
            return;
        }

        sifreDegistiriliyor = true;
        StateHasChanged();

        try
        {
            // Mevcut şifreyi doğrula
            if (!PasswordHasher.Verify(kullanici.Sifre, sifreModel.MevcutSifre))
            {
                ToastService.Notify(ToastSeverity.Error, "Hata", "Mevcut şifre hatalı.");
                return;
            }

            // Yeni şifreyi hash'le ve kaydet
            kullanici.Sifre = PasswordHasher.Hash(sifreModel.YeniSifre);
            kullanici.UpdDate = DateTime.UtcNow;
            kullanici.UpdUser = kullanici.ID;

            DbContext.Kullanicilar.Update(kullanici);
            await DbContext.SaveChangesAsync();

            // Formu temizle
            sifreModel = new SifreFormModel();

            ToastService.Notify(ToastSeverity.Success, "Başarılı", "Şifre başarıyla değiştirildi.");
        }
        catch (Exception ex)
        {
            ToastService.Notify(ToastSeverity.Error, "Hata", $"Şifre değiştirilirken hata oluştu: {ex.Message}");
        }
        finally
        {
            sifreDegistiriliyor = false;
            StateHasChanged();
        }
    }
}
