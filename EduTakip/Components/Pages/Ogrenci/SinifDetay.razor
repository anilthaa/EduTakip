@page "/ogrenci/sinif/{sinifId:int}"
@attribute [Authorize(Roles ="Öğrenci")]

<h3>@detay?.SinifAdi</h3>

<div class="flex-row gap-sm" style="flex-wrap:wrap;">
	<div style="flex:1; min-width:300px;">
		<div class="card">
			<div class="card-body">
				<h5>Sınıf Bilgileri</h5>

				<p>
					<b>Öğretmen:</b> @detay?.OgretmenAdSoyad <br />
					<b>Öğrenci Sayısı:</b> @detay?.OgrenciSayisi
				</p>
			</div>
		</div>
	</div>

	<div style="flex:1; min-width:300px;">
		<div class="card">
			<div class="card-body">
				<h5>Yaklaşan Ödevler</h5>
				<p class="text-muted">Henüz Ödev Yok</p>
			</div>
		</div>
	</div>
</div>
@code {
	[Parameter] public int sinifId { get; set; }
	SinifDetayDto detay;

	protected override async Task OnInitializedAsync()
	{
		await Yukle();
	}

	async Task Yukle()
	{
		detay = await DbContext.Siniflar
			.Where(s => s.ID == sinifId && (s.DelDate == null || s.DelDate == default(DateTime)))
			.Select(s => new SinifDetayDto
				{
					SinifId = s.ID,
					SinifAdi = s.Adi,

					OgretmenAdSoyad = DbContext.SinifKullanicilar
					.Where(o => o.Sinif_ID == s.ID && o.Tip == "Öğretmen" && (o.DelDate == null || o.DelDate == default(DateTime)))
					.Select(o => o.Kullanici.Adi + " " + o.Kullanici.Soyadi)
					.FirstOrDefault() ?? "-",

					OgrenciSayisi = DbContext.SinifKullanicilar
					.Count(o => o.Sinif_ID == s.ID && o.Tip == "Öğrenci" && (o.DelDate == null || o.DelDate == default(DateTime)))
				}).FirstOrDefaultAsync();
	}
}
