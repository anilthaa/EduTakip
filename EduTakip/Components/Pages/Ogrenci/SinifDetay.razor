@page "/ogrenci/sinif/{sinifId:int}"
@attribute [Authorize(Roles ="Öğrenci")]

<h3>@detay?.SinifAdi</h3>

<div class="flex-row gap-sm" style="flex-wrap:wrap;">
	<div style="flex:1; min-width:300px;">
		<div class="card">
			<div class="card-body">
				<h5>Sınıf Bilgileri</h5>

				<p>
					<b>Öğretmen:</b> @detay?.OgretmenAdSoyad <br />
					<b>Öğrenci Sayısı:</b> @detay?.OgrenciSayisi
				</p>
			</div>
		</div>
	</div>

	<div style="flex:1; min-width:300px;">
		<div class="card">
			<div class="card-body">
				<h5>Yaklaşan Ödevler</h5>
				<p class="text-muted">Henüz Ödev Yok</p>
			</div>
		</div>
	</div>
</div>
@code {
	[Parameter] public int sinifId { get; set; }
	SinifDetayDto detay;

	protected override async Task OnInitializedAsync()
	{
		await Yukle();
	}

	async Task Yukle()
	{
		var sinif = await DbContext.Siniflar
			.Where(s => s.ID == sinifId && (s.DelDate == null || s.DelDate == default(DateTime)))
			.FirstOrDefaultAsync();

		if (sinif == null) return;

		// Öğretmen adını ayrı sorgu ile al
		var ogretmenAdSoyad = await DbContext.SinifKullanicilar
			.Where(o => o.Sinif_ID == sinifId && o.Tip == SinifKullaniciTip.Ogretmen && (o.DelDate == null || o.DelDate == default(DateTime)))
			.Select(o => o.Kullanici.Adi + " " + o.Kullanici.Soyadi)
			.FirstOrDefaultAsync() ?? "-";

		// Öğrenci sayısını ayrı sorgu ile al
		var ogrenciSayisi = await DbContext.SinifKullanicilar
			.CountAsync(o => o.Sinif_ID == sinifId && o.Tip == SinifKullaniciTip.Ogrenci && (o.DelDate == null || o.DelDate == default(DateTime)));

		detay = new SinifDetayDto
		{
			SinifId = sinif.ID,
			SinifAdi = sinif.Adi,
			OgretmenAdSoyad = ogretmenAdSoyad,
			OgrenciSayisi = ogrenciSayisi
		};
	}
}
