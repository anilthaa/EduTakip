@page "/ogrenci/notlarim"
@attribute [Authorize(Roles ="Öğrenci")]
@inject AuthStateService AuthStateService

<RadzenCard>
	<h3>Notlarım</h3>

	<RadzenDataGrid Data="@notlar" TItem="ItemOdevTeslim" PageSize="10" AllowPaging="true">
		<Columns>
			<RadzenDataGridColumn Title="Ders">
				<Template Context="item">
					@item.Odev.Ders.Adi
				</Template>
			</RadzenDataGridColumn>

			<RadzenDataGridColumn Title="Ödev">
				<Template Context="item">
					@item.Odev.Baslik
				</Template>
			</RadzenDataGridColumn>

			<RadzenDataGridColumn Title="Not">
				<Template Context="item">
					@if (item.Not.HasValue)
					{
						<span style="font-weight:bold; color:green">
							@item.Not
						</span>
					}
					else
					{
						<span style="color:orange;">Değerlendiriliyor</span>
					}
				</Template>
			</RadzenDataGridColumn>

			<RadzenDataGridColumn Title="Öğretmen Yorumu">
				<Template Context="item">
					@if (!string.IsNullOrEmpty(item.OgretmenYorumu))
					{
						@item.OgretmenYorumu
					}
					else
					{
						<span style="color:gray;">Yorum Yok</span>
					}
				</Template>
			</RadzenDataGridColumn>
		</Columns>
	</RadzenDataGrid>
</RadzenCard>

@code {
	int? kullaniciId;
	List<ItemOdevTeslim> notlar = new();
	
	protected override async Task OnInitializedAsync()
	{
		if (AuthStateService.CurrentUser == null)
		{
			return;
		}

		kullaniciId = AuthStateService.CurrentUser.ID;
		await Listele();
	}

	async Task Listele()
	{
		if (!kullaniciId.HasValue)
		{
			return;
		}

		// ItemOdevTeslim'de Ogrenci_ID aslında Kullanici_ID olarak kullanılıyor
		// Her ödev için sadece en son teslim kaydını göster
		var tumTeslimler = await DbContext.OdevTeslimler
			.Include(x => x.Odev)
			.ThenInclude(x => x.Ders)
			.Where(x => x.Ogrenci_ID == kullaniciId.Value && x.DelDate == null)
			.OrderByDescending(x => x.TeslimTarihi)
			.ThenByDescending(x => x.ID)
			.ToListAsync();
		
		// Her ödev için sadece en son (en yeni) teslim kaydını al
		notlar = tumTeslimler
			.GroupBy(x => x.Odev_ID)
			.Select(g => g.First())
			.OrderByDescending(x => x.TeslimTarihi)
			.ToList();
	}
}
