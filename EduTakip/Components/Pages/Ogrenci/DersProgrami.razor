@page "/ogrenci/dersprogrami"
@attribute [Authorize(Roles ="Öğrenci")]
<h3>Ders Programım</h3>

<div class="card">
	<div class="card-body">
		@if (list.Any())
		{
			<div class="data-table-wrapper">
				<table class="data-table">
					<thead>
						<tr>
							<th>Gün</th>
							<th>Saat</th>
							<th>Ders</th>
							<th>Sınıf</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var item in list)
						{
							<tr>
								<td>@GetGunAdi(item.Gun)</td>
								<td>@item.BaslangicSaati - @item.BitisSaati</td>
								<td>@item.Ders.Adi</td>
								<td>@item.Sinif.Adi</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		else
		{
			<p class="text-muted">Henüz ders programınız bulunmamaktadır. Bir sınıfa katıldıktan sonra ders programınız burada görünecektir.</p>
		}
	</div>
</div>

@code {
	List<ItemDersProgrami> list = new();
	int? ogrenciId;

	private string GetGunAdi(DayOfWeek gun)
	{
		return gun switch
		{
			DayOfWeek.Monday => "Pazartesi",
			DayOfWeek.Tuesday => "Salı",
			DayOfWeek.Wednesday => "Çarşamba",
			DayOfWeek.Thursday => "Perşembe",
			DayOfWeek.Friday => "Cuma",
			DayOfWeek.Saturday => "Cumartesi",
			DayOfWeek.Sunday => "Pazar",
			_ => gun.ToString()
		};
	}

	protected override async Task OnInitializedAsync()
	{
		if (AuthStateService.CurrentUser == null)
		{
			return;
		}

		// Öğrenci ID'sini bul
		ogrenciId = await DbContext.Ogrenciler
			.Where(x => x.Kullanici_ID == AuthStateService.CurrentUser.ID && (x.DelDate == null || x.DelDate == default(DateTime)))
			.Select(x => x.ID)
			.FirstOrDefaultAsync();

		if (!ogrenciId.HasValue)
		{
			return;
		}

		// Öğrencinin kayıtlı olduğu sınıfların adlarını bul
		// Ana sınıf
		var anaSinifAdi = await DbContext.Ogrenciler
			.Where(x => x.ID == ogrenciId.Value && (x.DelDate == null || x.DelDate == default(DateTime)))
			.Include(x => x.Sinif)
			.Select(x => x.Sinif.Adi)
			.FirstOrDefaultAsync();

		// Katıldığı diğer sınıflar (SinifKullanicilar tablosundan)
		var katildigiSinifAdlari = await DbContext.SinifKullanicilar
			.Where(x => x.Kullanici_ID == AuthStateService.CurrentUser.ID && x.Tip == "Öğrenci" && (x.DelDate == null || x.DelDate == default(DateTime)))
			.Include(x => x.Sinif)
			.Select(x => x.Sinif.Adi)
			.ToListAsync();

		// SinifOgrenciler tablosundan katıldığı sınıflar
		var sinifOgrenciSinifAdlari = await DbContext.SinifOgrenciler
			.Where(x => x.Ogrenci_ID == ogrenciId.Value && (x.DelDate == null || x.DelDate == default(DateTime)))
			.Include(x => x.Sinif)
			.Select(x => x.Sinif.Adi)
			.ToListAsync();

		// Tüm sınıf adlarını birleştir
		var tumSinifAdlari = new List<string>();
		if (!string.IsNullOrEmpty(anaSinifAdi))
		{
			tumSinifAdlari.Add(anaSinifAdi);
		}
		tumSinifAdlari.AddRange(katildigiSinifAdlari);
		tumSinifAdlari.AddRange(sinifOgrenciSinifAdlari);
		tumSinifAdlari = tumSinifAdlari.Distinct().ToList();

		if (!tumSinifAdlari.Any())
		{
			return;
		}

		// Öğrencinin kayıtlı olduğu sınıfların ID'lerini bul
		var tumSinifIdleri = await DbContext.Siniflar
			.Where(s => tumSinifAdlari.Contains(s.Adi) && (s.DelDate == null || s.DelDate == default(DateTime)))
			.Select(s => s.ID)
			.ToListAsync();

		if (!tumSinifIdleri.Any())
		{
			return;
		}

		// Öğrencinin kayıtlı olduğu sınıfların ders programlarını getir
		// Öğrenci, içinde olduğu sınıfların tüm ders programlarını görebilir
		list = await DbContext.DersProgramlari
			.Include(x => x.Ders)
			.Include(x => x.Sinif)
			.Where(x => tumSinifIdleri.Contains(x.Sinif_ID) 
				&& (x.DelDate == null || x.DelDate == default(DateTime)) 
				&& x.Aktif)
			.OrderBy(x => x.Gun)
			.ThenBy(x => x.BaslangicSaati)
			.ToListAsync();
	}
}
