@page "/ogrenci/derslerim"
<h3>Dersler</h3>
@attribute [Authorize(Roles = "Öğrenci")]

<h3>Derslerim</h3>

@if (dersler.Any())
{
	<div class="flex-row gap-sm" style="flex-wrap:wrap;">
		@foreach (var ders in dersler)
		{
			<div style="flex:0 0 auto; width:100%; max-width:33.333%;">
				<div class="card">
					<div class="card-body">
						<h5 class="mb-3">@ders.DersAdi</h5>

						<p>
							<b>Öğretmen:</b>
							<p style="display:inline-block">@ders.OgretmenAdSoyad</p> <br />
							<b>Sınıflar:</b> <p style="display:inline-block">@string.Join(",", ders.Siniflar)</p>
						</p>

						<button class="btn btn-primary btn-sm" @onclick="@(() => OdevlereGit(ders.DersId))"><span class="material-icons">Assignment</span></button>
					</div>
				</div>
			</div>
		}
	</div>
}
else
{
	<div class="card">
		<div class="card-body">
			<p class="text-muted">
				Henuz Herhangi bir derse katilmadiniz.
			</p>
		</div>
	</div>
}
@code {
	List<OgrenciDersDto> dersler = new();

	protected override async Task OnInitializedAsync()
	{
		var kullaniciId = AuthStateService.CurrentUser?.ID;
		if (kullaniciId == null)
			return;

		// Öğrencinin katıldığı sınıflar
		var sinifIdler = await DbContext.SinifKullanicilar
			.Where(x =>
				x.Kullanici_ID == kullaniciId &&
				x.Tip == "Öğrenci" &&
				(x.DelDate == null || x.DelDate == default(DateTime)))
			.Select(x => x.Sinif_ID)
			.ToListAsync();

		if (!sinifIdler.Any())
			return;

		// Ders programlarından dersleri çek
		dersler = await DbContext.DersProgramlari
			.Where(x =>
				sinifIdler.Contains(x.Sinif_ID) &&
				(x.DelDate == null || x.DelDate == default(DateTime)) &&
				x.Aktif)
			.GroupBy(x => x.Ders_ID)
			.Select(g => new OgrenciDersDto
			{
				DersId = g.Key,
				DersAdi = g.First().Ders.Adi,
				OgretmenAdSoyad =
					g.First().Ders.Ogretmen.Kullanici.Adi + " " +
					g.First().Ders.Ogretmen.Kullanici.Soyadi,

				Siniflar = g
					.Select(x => x.Sinif.Adi)
					.Distinct()
					.ToList()
			})
			.OrderBy(x => x.DersAdi)
			.ToListAsync();
	}

	void OdevlereGit(int dersId)
	{
		NavigationManager.NavigateTo("/ogrenci/odevlerim");
	}


}
