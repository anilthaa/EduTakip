@page "/ogrenci/odevlerim"
@attribute [Authorize(Roles ="Öğrenci")]

<div class="card">
	<div class="card-body">
		<h4>Ödevlerim</h4>
		<div class="data-table-wrapper">
			<table class="data-table">
				<thead>
					<tr>
						<th>Ders</th>
						<th>Başlık</th>
						<th>Son Teslim Tarihi</th>
						<th>Durum</th>
						<th>İşlem</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var item in odevlerim)
					{
						<tr>
							<td>@item.Ders.Adi</td>
							<td>@item.Baslik</td>
							<td>@item.SonTeslimTarihi.ToString("dd.MM.yyyy HH:mm")</td>
							<td>
								@if (TeslimEdildi(item.ID))
								{
									<span style="color:green;">Teslim Edildi</span>
								}
								else
								{
									<span style="color:red;">Teslim Edilmedi</span>
								}
							</td>
							<td>
								@if (!TeslimEdildi(item.ID))
								{
									<button class="btn btn-success btn-sm" @onclick="@(() => OdevTeslimEt(item.ID))"><span class="material-icons">upload_file</span></button>
								}
								else
								{
									<button class="btn btn-outline btn-sm" @onclick="@(() => TeslimDetay(item.ID))"><span class="material-icons">description</span></button>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
</div>

@code {
	int? kullaniciId;

	List<ItemOdev> odevlerim = new();
	List<ItemOdevTeslim> odevTeslimler = new();

	protected override async Task OnInitializedAsync()
	{
		if (AuthStateService.CurrentUser == null)
		{
			return;
		}

		kullaniciId = AuthStateService.CurrentUser.ID;
		await Listele();
	}


	async Task Listele()
	{
		if (!kullaniciId.HasValue)
		{
			return;
		}

		// Öğrenci ID'sini bul
		var ogrenciId = await DbContext.Ogrenciler
			.Where(x => x.Kullanici_ID == kullaniciId.Value && (x.DelDate == null || x.DelDate == default(DateTime)))
			.Select(x => x.ID)
			.FirstOrDefaultAsync();

		if (ogrenciId == 0)
		{
			odevlerim = new List<ItemOdev>();
			odevTeslimler = new List<ItemOdevTeslim>();
			return;
		}

		// Öğrencinin kayıtlı olduğu sınıfların ID'lerini bul
		// Ana sınıf (nullable olabilir)
		var anaSinifId = await DbContext.Ogrenciler
			.Where(x => x.ID == ogrenciId && (x.DelDate == null || x.DelDate == default(DateTime)))
			.Select(x => x.Sinif_ID)
			.FirstOrDefaultAsync();

		// Katıldığı diğer sınıflar (SinifKullanicilar tablosundan)
		var katildigiSinifIdleri = await DbContext.SinifKullanicilar
			.Where(x => x.Kullanici_ID == kullaniciId.Value && x.Tip == SinifKullaniciTip.Ogrenci && (x.DelDate == null || x.DelDate == default(DateTime)))
			.Select(x => x.Sinif_ID)
			.ToListAsync();

		// SinifOgrenciler tablosundan katıldığı sınıflar
		var sinifOgrenciSinifIdleri = await DbContext.SinifOgrenciler
			.Where(x => x.Ogrenci_ID == ogrenciId && (x.DelDate == null || x.DelDate == default(DateTime)))
			.Select(x => x.Sinif_ID)
			.ToListAsync();

		// Tüm sınıf ID'lerini birleştir
		var tumSinifIdleri = new List<int>();
		if (anaSinifId.HasValue && anaSinifId.Value > 0)
		{
			tumSinifIdleri.Add(anaSinifId.Value);
		}
		tumSinifIdleri.AddRange(katildigiSinifIdleri);
		tumSinifIdleri.AddRange(sinifOgrenciSinifIdleri);
		tumSinifIdleri = tumSinifIdleri.Distinct().ToList();

		if (!tumSinifIdleri.Any())
		{
			odevlerim = new List<ItemOdev>();
			odevTeslimler = new List<ItemOdevTeslim>();
			return;
		}

		// Öğrencinin katıldığı sınıflardaki ders programlarından ders ID'lerini al
		// Sadece öğrencinin gerçekten katıldığı sınıflardaki ders programlarına bağlı ödevleri göster
		var ogrenciDersIdleri = new List<int>();
		if (tumSinifIdleri.Any())
		{
			ogrenciDersIdleri = await DbContext.DersProgramlari
				.Where(x => tumSinifIdleri.Contains(x.Sinif_ID) && (x.DelDate == null || x.DelDate == default(DateTime)) && x.Aktif)
				.Select(x => x.Ders_ID)
				.Distinct()
				.ToListAsync();
		}

		if (!ogrenciDersIdleri.Any())
		{
			odevlerim = new List<ItemOdev>();
			odevTeslimler = new List<ItemOdevTeslim>();
			return;
		}

		// Sadece öğrencinin katıldığı sınıflardaki ders programlarına bağlı ödevleri göster
		// Öğrenci, sadece kendi katıldığı sınıflardaki derslerin ödevlerini görmeli
		odevlerim = await DbContext.Odevler
			.Include(x => x.Ders)
			.Where(x => ogrenciDersIdleri.Contains(x.Ders_ID) && (x.DelDate == null || x.DelDate == default(DateTime)))
			.OrderByDescending(x => x.SonTeslimTarihi)
			.ToListAsync();
		
		// Ogrenci_ID artık Ogrenciler.ID FK'sına bağlı
		odevTeslimler = await DbContext.OdevTeslimler
			.Where(x => x.Ogrenci_ID == ogrenciId && (x.DelDate == null || x.DelDate == default(DateTime)))
			.ToListAsync();
	}

	bool TeslimEdildi(int odevId)
	{
		return odevTeslimler.Any(x => x.Odev_ID == odevId);
	}

	async Task OdevTeslimEt(int odevId)
	{
		var result = await ModalService.OpenAsync<OdevTeslimTnm>("Ödevi Teslim Et",
			new Dictionary<string, object>()
			{
				{ "OdevId", odevId },
			},
			new ModalOptions() { CssClass = "modal-md" });
		if (result is true)
		{
			await Listele();
			StateHasChanged();
		}
	}
	async Task TeslimDetay(int odevId)
	{
		await ModalService.OpenAsync<OdevTeslimDetay>("Teslim Detayı",
			new Dictionary<string, object>()
			{
				{ "OdevId", odevId },
			},
			new ModalOptions() { CssClass = "modal-md" });
	}
}
