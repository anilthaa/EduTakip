@page "/ogrenci/odevlerim"
@attribute [Authorize(Roles ="Öğrenci")]
@inject AuthStateService AuthStateService
@inject DialogService DialogService

<RadzenCard>
		<h4>Ödevlerim</h4>
	<RadzenDataGrid Data="@odevlerim" TItem="ItemOdev" ColumnWidth="200px" AllowPaging="true" PageSize="10">
		<Columns>
			<RadzenDataGridColumn Title="Ders">
				<Template Context="item">
					@item.Ders.Adi
				</Template>
			</RadzenDataGridColumn>
			<RadzenDataGridColumn Property="Baslik" Title="Başlık"></RadzenDataGridColumn>
			<RadzenDataGridColumn Title="Son Teslim Tarihi">
				<Template Context="item">
					@item.SonTeslimTarihi.ToString("dd.MM.yyyy HH:mm")
				</Template>
			</RadzenDataGridColumn>
			<RadzenDataGridColumn Title="Durum">
				<Template Context="item">
					@if (TeslimEdildi(item.ID))
					{
						<span style="color:green;">Teslim Edildi</span>
					}
					else
					{
						<span style="color:red;">Teslim Edilmedi</span>
					}
				</Template>
			</RadzenDataGridColumn>

			<RadzenDataGridColumn Title="İşlem">
				<Template Context="item">
					@if (!TeslimEdildi(item.ID))
					{
						<RadzenButton Icon="upload_file" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Success" Click="@(() => OdevTeslimEt(item.ID))"></RadzenButton>
					}
					else
					{
						<RadzenButton Icon="description" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" Click="@(()=>TeslimDetay(item.ID))"></RadzenButton>
					}
				</Template>
			</RadzenDataGridColumn>
		</Columns>
	</RadzenDataGrid>
</RadzenCard>

@code {
	int? kullaniciId;

	List<ItemOdev> odevlerim = new();
	List<ItemOdevTeslim> odevTeslimler = new();

	protected override async Task OnInitializedAsync()
	{
		if (AuthStateService.CurrentUser == null)
		{
			return;
		}

		kullaniciId = AuthStateService.CurrentUser.ID;
		await Listele();
	}


	async Task Listele()
	{
		if (!kullaniciId.HasValue)
		{
			return;
		}

		// Öğrenci ID'sini bul
		var ogrenciId = await DbContext.Ogrenciler
			.Where(x => x.Kullanici_ID == kullaniciId.Value && x.DelDate == null)
			.Select(x => x.ID)
			.FirstOrDefaultAsync();

		if (ogrenciId == 0)
		{
			odevlerim = new List<ItemOdev>();
			odevTeslimler = new List<ItemOdevTeslim>();
			return;
		}

		// Öğrencinin kayıtlı olduğu sınıfların ID'lerini bul
		// Ana sınıf (nullable olabilir)
		var anaSinifId = await DbContext.Ogrenciler
			.Where(x => x.ID == ogrenciId && x.DelDate == null)
			.Select(x => x.Sinif_ID)
			.FirstOrDefaultAsync();

		// Katıldığı diğer sınıflar (SinifKullanicilar tablosundan)
		var katildigiSinifIdleri = await DbContext.SinifKullanicilar
			.Where(x => x.Kullanici_ID == kullaniciId.Value && x.Tip == "Öğrenci" && x.DelDate == null)
			.Select(x => x.Sinif_ID)
			.ToListAsync();

		// SinifOgrenciler tablosundan katıldığı sınıflar
		var sinifOgrenciSinifIdleri = await DbContext.SinifOgrenciler
			.Where(x => x.Ogrenci_ID == ogrenciId && x.DelDate == null)
			.Select(x => x.Sinif_ID)
			.ToListAsync();

		// Tüm sınıf ID'lerini birleştir
		var tumSinifIdleri = new List<int>();
		if (anaSinifId.HasValue && anaSinifId.Value > 0)
		{
			tumSinifIdleri.Add(anaSinifId.Value);
		}
		tumSinifIdleri.AddRange(katildigiSinifIdleri);
		tumSinifIdleri.AddRange(sinifOgrenciSinifIdleri);
		tumSinifIdleri = tumSinifIdleri.Distinct().ToList();

		if (!tumSinifIdleri.Any())
		{
			odevlerim = new List<ItemOdev>();
			odevTeslimler = new List<ItemOdevTeslim>();
			return;
		}

		// Öğrencinin katıldığı sınıflardaki ders programlarından ders ID'lerini al
		// Sadece öğrencinin gerçekten katıldığı sınıflardaki ders programlarına bağlı ödevleri göster
		var ogrenciDersIdleri = new List<int>();
		if (tumSinifIdleri.Any())
		{
			ogrenciDersIdleri = await DbContext.DersProgramlari
				.Where(x => tumSinifIdleri.Contains(x.Sinif_ID) && x.DelDate == null && x.Aktif)
				.Select(x => x.Ders_ID)
				.Distinct()
				.ToListAsync();
		}

		if (!ogrenciDersIdleri.Any())
		{
			odevlerim = new List<ItemOdev>();
			odevTeslimler = new List<ItemOdevTeslim>();
			return;
		}

		// Sadece öğrencinin katıldığı sınıflardaki ders programlarına bağlı ödevleri göster
		// Öğrenci, sadece kendi katıldığı sınıflardaki derslerin ödevlerini görmeli
		odevlerim = await DbContext.Odevler
			.Include(x => x.Ders)
			.Where(x => ogrenciDersIdleri.Contains(x.Ders_ID) && x.DelDate == null)
			.OrderByDescending(x => x.SonTeslimTarihi)
			.ToListAsync();
		
		// ItemOdevTeslim'de Ogrenci_ID aslında Kullanici_ID olarak kullanılıyor
		odevTeslimler = await DbContext.OdevTeslimler
			.Where(x => x.Ogrenci_ID == kullaniciId.Value && x.DelDate == null)
			.ToListAsync();
	}

	bool TeslimEdildi(int odevId)
	{
		return odevTeslimler.Any(x => x.Odev_ID == odevId);
	}

	async Task OdevTeslimEt(int odevId)
	{
		var result = await DialogService.OpenAsync<OdevTeslimTnm>("Ödevi Teslim Et",
			new Dictionary<string, object>()
			{
				{ "OdevId", odevId },
			},
			new DialogOptions() { Width = "600px"});
		if (result == true)
		{
			await Listele();
			StateHasChanged();
		}
	}
	async Task TeslimDetay(int odevId)
	{
		await DialogService.OpenAsync<OdevTeslimDetay>("Teslim Detayı",
			new Dictionary<string, object>()
			{
				{ "OdevId", odevId },
			},
			new DialogOptions() { Width = "600px", Height = "auto" });
	}
}
