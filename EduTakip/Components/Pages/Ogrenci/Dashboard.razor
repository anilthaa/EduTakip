@page "/ogrenci/dashboard"

<RadzenRow Gap="20px" Style="margin-bottom:15px;">

	<RadzenColumn Size="3">
		<RadzenCard Style="background:#f44336; color:white;">
			<h5>Bekleyen Ödevler</h5>
			<h2>@bekleyenOdevSayisi</h2>
		</RadzenCard>
	</RadzenColumn>

	<RadzenColumn Size="3">
		<RadzenCard Style="background:#ff9800; color:white;">
			<h5>Yaklaşan Teslimler</h5>
			<h2>@yaklasanTeslimSayisi</h2>
		</RadzenCard>
	</RadzenColumn>

	<RadzenColumn Size="3">
		<RadzenCard Style="background:#2196f3; color:white;">
			<h5>Bugünkü Dersler</h5>
			<h2>@bugunkuDersSayisi</h2>
		</RadzenCard>
	</RadzenColumn>

	<RadzenColumn Size="3">
		<RadzenCard Style="background:#4caf50; color:white;">
			<h5>Not Ortalaması</h5>
			<h2>@ortalamaNot</h2>
		</RadzenCard>
	</RadzenColumn>
</RadzenRow>

<RadzenRow Gap="20px">
	<RadzenColumn Size="6">
		<RadzenCard>
			<h4>Bugünkü Ders Programı</h4>
			<RadzenDataGrid TItem="ItemDersProgrami" Data="@bugunkuDersler" AllowPaging="true" PageSize="5">
				<Columns>
					<RadzenDataGridColumn Title="Ders">
						<Template Context="item">
							@item.Ders.Adi
						</Template>
					</RadzenDataGridColumn>
					<RadzenDataGridColumn Title="Saat">
						<Template Context="item">
							@item.BaslangicSaati.ToString("HH:mm") - @item.BitisSaati.ToString("HH:mm")
						</Template>
					</RadzenDataGridColumn>
				</Columns>
			</RadzenDataGrid>
		</RadzenCard>
	</RadzenColumn>
	<RadzenColumn Size="6">
		<RadzenCard>
			<h4>Son Ödevler</h4>
			<RadzenDataGrid TItem="ItemOdev" Data="@sonOdevler" AllowPaging="true" PageSize="5">
				<Columns>
					<RadzenDataGridColumn Title="Ödev Adı" Property="Baslik"></RadzenDataGridColumn>
					<RadzenDataGridColumn Property="SonTeslimTarihi" Title="Teslim Tarihi"></RadzenDataGridColumn>
				</Columns>
			</RadzenDataGrid>
		</RadzenCard>
	</RadzenColumn>
</RadzenRow>

@code {
	int ogrenciId = 1; // Simdilik sabit

	int bekleyenOdevSayisi;
	int yaklasanTeslimSayisi;
	int bugunkuDersSayisi;
	decimal ortalamaNot;

	List<ItemDersProgrami> bugunkuDersler = new();
	List<ItemOdev> sonOdevler = new();

	protected override async Task OnInitializedAsync()
	{
		await Yukle();
	}

	async Task Yukle()
	{
		var bugun = DateTime.Today;
		var gun = bugun.DayOfWeek;
		bekleyenOdevSayisi = await DbContext.Odevler
			.Where(x=>!DbContext.OdevTeslimler.Any(t=>t.Odev_ID==x.ID && t.Ogrenci_ID==ogrenciId))
			.CountAsync();
		yaklasanTeslimSayisi = await DbContext.Odevler
			.Where(x=> x.DelDate == null && x.SonTeslimTarihi >= bugun && x.SonTeslimTarihi <= bugun.AddDays(3))
			.CountAsync();
		bugunkuDersler = await DbContext.DersProgramlari
			.Include(x => x.Ders)
			.Where(x => x.Gun == gun && x.DelDate == null)
			.OrderBy(x => x.BaslangicSaati)
			.ToListAsync();
		bugunkuDersSayisi = bugunkuDersler.Count;
		ortalamaNot = await DbContext.OdevTeslimler
			.Where(x => x.Ogrenci_ID == ogrenciId && x.DelDate == null && x.Not != null)
			.AverageAsync(x => (decimal?)x.Not) ?? 0;
		sonOdevler = await DbContext.Odevler
			.OrderByDescending(x => x.CreDate)
			.Take(5)
			.ToListAsync();
	}
}
