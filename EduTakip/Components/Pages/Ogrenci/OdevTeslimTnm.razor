<RadzenTemplateForm Data="@model" TItem="ItemOdevTeslim" Submit="@Kaydet">
	<RadzenUpload Url="upload" Change="@OnUpload" Style="width:100%"></RadzenUpload>

	<div class="mt-3 text-center">
		<RadzenButton Text="Teslim Et" ButtonType="ButtonType.Submit" Style="background-color:green; margin-right:10px;"></RadzenButton>
		<RadzenButton Text="İptal" Style="background-color:red" Click="@(args=>DialogService.Close(false))"></RadzenButton>
	</div>
</RadzenTemplateForm>

@code {
	ItemOdevTeslim model = new();
	[Parameter] public int OdevId { get; set; }
	int ogrenciId = 1; // Bu değeri oturum açan öğrencinin ID'si ile değiştirin.
	protected override void OnInitialized()
	{
		model.Odev_ID = OdevId;
		model.Ogrenci_ID = ogrenciId;
		model.TeslimTarihi = DateTime.UtcNow;
	}

	void OnUpload(UploadChangeEventArgs args)
	{
		model.DosyaYolu = "/uploads/" + args.Files.First().Name;
	}

	async Task Kaydet()
	{
		try
		{
			model.CreDate = DateTime.UtcNow;
			model.CreUser = 1;
			DbContext.OdevTeslimler.Add(model);
			await DbContext.SaveChangesAsync();
			NotificationService.Notify(NotificationSeverity.Success, "Başarılı", "Ödev başarıyla teslim edildi.");
			DialogService.Close(true);
		}
		catch (Exception ex)
		{
			NotificationService.Notify(NotificationSeverity.Error, "Hata", $"Bir hata oluştu: {ex.Message}");
		}
	}
}
