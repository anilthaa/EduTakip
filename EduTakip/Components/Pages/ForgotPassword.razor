@page "/forgot-password"

@layout EmptyLayout

<PageTitle>Şifremi Unuttum</PageTitle>

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <h2>Şifremi Unuttum</h2>
            <p>E-posta adresinize şifre sıfırlama linki gönderilecektir</p>
        </div>

        <RadzenTemplateForm Data="@forgotPasswordModel" TItem="ForgotPasswordModel" Submit="@OnForgotPassword" class="auth-form">
            <div class="auth-form-inner">
                <RadzenFormField Text="E-posta" Style="width:100%;">
                    <ChildContent>
                        <RadzenTextBox @bind-Value="forgotPasswordModel.EPosta" Placeholder="ornek@email.com" Style="width:100%;" />
                    </ChildContent>
                </RadzenFormField>

                @if (!string.IsNullOrWhiteSpace(forgotPasswordModel.EPosta) && !IsValidEmail(forgotPasswordModel.EPosta))
                {
                    <div class="auth-alert auth-alert-warning">
                        <strong>Uyarı:</strong> Lütfen geçerli bir e-posta adresi girin.
                    </div>
                }

                <div class="auth-actions">
                    <RadzenButton ButtonType="ButtonType.Submit"
                                  Text="Şifre Sıfırlama Linki Gönder"
                                  Icon="email"
                                  IsBusy="@isLoading"
                                  ButtonStyle="ButtonStyle.Primary"
                                  class="w-100"
                                  Style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);" />
                </div>
            </div>
        </RadzenTemplateForm>

        <div class="auth-footer">
            <RadzenLink Path="/login" Text="Giriş sayfasına dön" />
        </div>
    </div>
</div>

@code {
    private ForgotPasswordModel forgotPasswordModel = new();
    private bool isLoading = false;

    public class ForgotPasswordModel
    {
        public string EPosta { get; set; } = "";
    }

    private bool IsValidEmail(string email)
    {
        if (string.IsNullOrWhiteSpace(email))
            return false;

        try
        {
            var emailRegex = new System.Text.RegularExpressions.Regex(
                @"^[^@\s]+@[^@\s]+\.[^@\s]+$",
                System.Text.RegularExpressions.RegexOptions.IgnoreCase |
                System.Text.RegularExpressions.RegexOptions.Compiled);
            return emailRegex.IsMatch(email.Trim());
        }
        catch
        {
            return false;
        }
    }

    private async Task OnForgotPassword(ForgotPasswordModel model)
    {
        if (isLoading) return;

        // E-posta validasyonu
        if (string.IsNullOrWhiteSpace(model.EPosta))
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Uyarı", "Lütfen e-posta adresinizi girin.", 4000);
            return;
        }

        if (!IsValidEmail(model.EPosta))
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Uyarı", "Lütfen geçerli bir e-posta adresi girin.", 4000);
            return;
        }

        isLoading = true;
        StateHasChanged();

        try
        {
            var request = new ForgotPasswordRequest(model.EPosta);
            var result = await AuthService.ForgotPasswordAsync(request);

            if (result)
            {
                NotificationService.Notify(NotificationSeverity.Success, "Başarılı", "Şifre sıfırlama linki e-posta adresinize gönderildi. Lütfen e-posta kutunuzu kontrol edin.", 5000);

                await Task.Delay(2000);
                NavigationManager.NavigateTo("/login");
            }
            else
            {
                NotificationService.Notify(NotificationSeverity.Error, "Hata", "Şifre sıfırlama linki gönderilemedi. Lütfen tekrar deneyin.", 4000);
            }
        }
        catch (HttpRequestException ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Hata", $"Sunucuya bağlanırken bir hata oluştu: {ex.Message}", 5000);
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Hata", $"Bir hata oluştu: {ex.Message}", 5000);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}
