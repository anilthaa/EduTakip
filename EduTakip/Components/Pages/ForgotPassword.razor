@page "/forgot-password"
@rendermode InteractiveServer
@layout EmptyLayout
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IToastService ToastService

<PageTitle>Şifremi Unuttum</PageTitle>

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <h2>Şifremi Unuttum</h2>
            <p>E-posta adresinize şifre sıfırlama linki gönderilecektir</p>
        </div>

        <RadzenTemplateForm Data="@forgotPasswordModel" TItem="ForgotPasswordModel" Submit="@OnForgotPassword" class="auth-form">
            <RadzenFieldset Text="E-posta Bilgileri" class="w-100">
                <RadzenStack Gap="1.5rem">
                    <RadzenFormField Text="E-posta" Style="width:100%">
                        <RadzenTextBox @bind-Value="forgotPasswordModel.EPosta" Placeholder="ornek@email.com" class="w-100" />
                        <RadzenFormFieldValidator />
                    </RadzenFormField>

                    @if (!string.IsNullOrWhiteSpace(forgotPasswordModel.EPosta) && !IsValidEmail(forgotPasswordModel.EPosta))
                    {
                        <div style="padding: 0.75rem; background-color: #fff3cd; border-left: 4px solid #ffc107; border-radius: 4px; font-size: 0.875rem; color: #856404;">
                            <strong>Uyarı:</strong> Lütfen geçerli bir e-posta adresi girin.
                        </div>
                    }

                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" class="w-100">
                        <RadzenButton ButtonType="ButtonType.Submit" 
                                     Text="Şifre Sıfırlama Linki Gönder" 
                                     Icon="email" 
                                     IsBusy="@isLoading"
                                     ButtonStyle="ButtonStyle.Primary" 
                                     class="w-100"
                                     Style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);" />
                    </RadzenStack>

                    <div class="text-center w-100" style="margin-top: 0.5rem;">
                        <RadzenLink Path="/login" Text="Giriş sayfasına dön" Style="font-size: 0.9rem; color: #667eea;" />
                    </div>
                </RadzenStack>
            </RadzenFieldset>
        </RadzenTemplateForm>
    </div>
</div>

@code {
    private ForgotPasswordModel forgotPasswordModel = new();
    private bool isLoading = false;

    public class ForgotPasswordModel
    {
        public string EPosta { get; set; } = "";
    }

    private bool IsValidEmail(string email)
    {
        if (string.IsNullOrWhiteSpace(email))
            return false;

        try
        {
            var emailRegex = new System.Text.RegularExpressions.Regex(
                @"^[^@\s]+@[^@\s]+\.[^@\s]+$",
                System.Text.RegularExpressions.RegexOptions.IgnoreCase | 
                System.Text.RegularExpressions.RegexOptions.Compiled);
            return emailRegex.IsMatch(email.Trim());
        }
        catch
        {
            return false;
        }
    }

    private async Task OnForgotPassword(ForgotPasswordModel model)
    {
        if (isLoading) return;

        // E-posta validasyonu
        if (string.IsNullOrWhiteSpace(model.EPosta))
        {
            ToastService.ShowWarning("Uyarı", "Lütfen e-posta adresinizi girin.", 4000);
            return;
        }

        if (!IsValidEmail(model.EPosta))
        {
            ToastService.ShowWarning("Uyarı", "Lütfen geçerli bir e-posta adresi girin.", 4000);
            return;
        }

        isLoading = true;
        StateHasChanged();
        
        try
        {
            var request = new ForgotPasswordRequest(model.EPosta);
            var result = await AuthService.ForgotPasswordAsync(request);
            
            if (result)
            {
                ToastService.ShowSuccess("Başarılı", "Şifre sıfırlama linki e-posta adresinize gönderildi. Lütfen e-posta kutunuzu kontrol edin.", 5000);
                
                await Task.Delay(2000);
                Navigation.NavigateTo("/login");
            }
            else
            {
                ToastService.ShowError("Hata", "Şifre sıfırlama linki gönderilemedi. Lütfen tekrar deneyin.", 4000);
            }
        }
        catch (HttpRequestException ex)
        {
            ToastService.ShowError("Hata", ex.Message, 5000);
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Hata", $"Bir hata oluştu: {ex.Message}", 5000);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}
