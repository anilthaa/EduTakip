@page "/forgot-password"

@layout EmptyLayout

<PageTitle>Şifremi Unuttum</PageTitle>

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <h2>Şifremi Unuttum</h2>
            <p>E-posta adresinize şifre sıfırlama linki gönderilecektir</p>
        </div>

        <form @onsubmit="OnForgotPassword" @onsubmit:preventDefault class="auth-form">
            <div class="auth-form-inner">
                <div class="form-group">
                    <label class="form-label">E-posta</label>
                    <input type="text" class="form-control" @bind="forgotPasswordModel.EPosta" placeholder="ornek@email.com" />
                </div>

                @if (!string.IsNullOrWhiteSpace(forgotPasswordModel.EPosta) && !IsValidEmail(forgotPasswordModel.EPosta))
                {
                    <div class="alert alert-warning">
                        <strong>Uyarı:</strong> Lütfen geçerli bir e-posta adresi girin.
                    </div>
                }

                <div class="auth-actions">
                    <button type="submit"
                            class="btn btn-gradient btn-auth-primary @(isLoading ? "btn-loading" : "")"
                            disabled="@isLoading">
                        Şifre Sıfırlama Linki Gönder
                    </button>
                </div>
            </div>
        </form>

        <div class="auth-footer">
            <a href="/login">Giriş sayfasına dön</a>
        </div>
    </div>
</div>

@code {
    private ForgotPasswordModel forgotPasswordModel = new();
    private bool isLoading = false;

    public class ForgotPasswordModel
    {
        public string EPosta { get; set; } = "";
    }

    private bool IsValidEmail(string email)
    {
        if (string.IsNullOrWhiteSpace(email))
            return false;

        try
        {
            var emailRegex = new System.Text.RegularExpressions.Regex(
                @"^[^@\s]+@[^@\s]+\.[^@\s]+$",
                System.Text.RegularExpressions.RegexOptions.IgnoreCase |
                System.Text.RegularExpressions.RegexOptions.Compiled);
            return emailRegex.IsMatch(email.Trim());
        }
        catch
        {
            return false;
        }
    }

    private async Task OnForgotPassword()
    {
        if (isLoading) return;

        if (string.IsNullOrWhiteSpace(forgotPasswordModel.EPosta))
        {
            ToastService.Notify(ToastSeverity.Warning, "Uyarı", "Lütfen e-posta adresinizi girin.", 4000);
            return;
        }

        if (!IsValidEmail(forgotPasswordModel.EPosta))
        {
            ToastService.Notify(ToastSeverity.Warning, "Uyarı", "Lütfen geçerli bir e-posta adresi girin.", 4000);
            return;
        }

        isLoading = true;
        StateHasChanged();

        try
        {
            var request = new ForgotPasswordRequest(forgotPasswordModel.EPosta);
            var result = await AuthService.ForgotPasswordAsync(request);

            if (result)
            {
                ToastService.Notify(ToastSeverity.Success, "Başarılı", "Şifre sıfırlama linki e-posta adresinize gönderildi. Lütfen e-posta kutunuzu kontrol edin.", 5000);

                await Task.Delay(2000);
                NavigationManager.NavigateTo("/login");
            }
            else
            {
                ToastService.Notify(ToastSeverity.Error, "Hata", "Şifre sıfırlama linki gönderilemedi. Lütfen tekrar deneyin.", 4000);
            }
        }
        catch (HttpRequestException ex)
        {
            ToastService.Notify(ToastSeverity.Error, "Hata", $"Sunucuya bağlanırken bir hata oluştu: {ex.Message}", 5000);
        }
        catch (Exception ex)
        {
            ToastService.Notify(ToastSeverity.Error, "Hata", $"Bir hata oluştu: {ex.Message}", 5000);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}
