@page "/confirm-email"
@using System.Net.Http.Json
@using Microsoft.AspNetCore.WebUtilities
@using System.Text.Json.Serialization
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject NotificationService NotificationService

<PageTitle>E-posta Doğrulama</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <RadzenCard>
                @if (isSuccess)
                {
                    <div style="text-align: center; padding: 20px;">
                        <RadzenIcon Icon="check_circle" Style="font-size: 48px; color: green; margin-bottom: 20px;" />
                        <h3>E-posta Başarıyla Onaylandı!</h3>
                        <p>Hesabınızın e-postası onaylandı. Hesabınızın admin tarafından onaylanması gerekmektedir.</p>
                        <p>Onaylandıktan sonra giriş yapabilirsiniz.</p>
                        <RadzenButton Text="Giriş Sayfasına Git" ButtonStyle="ButtonStyle.Primary" Click="@(() => NavigationManager.NavigateTo("/login"))" Style="margin-top: 20px;" />
                    </div>
                }
                else
                {
                    <div style="padding: 20px;">
                        <h3 style="text-align: center; margin-bottom: 20px;">E-posta Doğrulama</h3>
                        <p style="text-align: center; margin-bottom: 30px;">
                            @if (!string.IsNullOrWhiteSpace(userEmail))
                            {
                                <span>@userEmail adresine gönderilen 6 haneli doğrulama kodunu girin.</span>
                            }
                            else
                            {
                                <span>E-postanıza gönderilen 6 haneli doğrulama kodunu girin.</span>
                            }
                        </p>

                        <RadzenTemplateForm Data="@verificationModel" TItem="VerificationModel" Submit="@OnVerifyCode">
                            <RadzenStack Gap="1rem">
                                <RadzenFormField Text="E-posta" class="w-100">
                                    <RadzenTextBox @bind-Value="verificationModel.Email" Placeholder="E-posta adresinizi girin" class="w-100" Disabled="@(!string.IsNullOrWhiteSpace(userEmail))" />
                                    <RadzenFormFieldValidator />
                                </RadzenFormField>

                                <RadzenFormField Text="Doğrulama Kodu" class="w-100">
                                    <RadzenTextBox @bind-Value="verificationModel.Code" Placeholder="6 haneli kodu girin" class="w-100" MaxLength="6" Style="text-align: center; font-size: 24px; letter-spacing: 5px;" />
                                    <RadzenFormFieldValidator />
                                </RadzenFormField>

                                @if (hasError)
                                {
                                    <RadzenAlert AlertStyle="AlertStyle.Danger" Title="Hata" Text="@errorMessage" />
                                }

                                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem" Style="margin-top: 10px;">
                                    <RadzenButton Text="Kodu Doğrula" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" 
                                        Disabled="@(isVerifying || string.IsNullOrWhiteSpace(verificationModel.Code) || verificationModel.Code.Length != 6)" 
                                        class="flex-grow-1" />
                                    <RadzenButton Text="Kodu Tekrar Gönder" ButtonStyle="ButtonStyle.Secondary" 
                                        Disabled="@(isResending || string.IsNullOrWhiteSpace(verificationModel.Email))" 
                                        Click="@OnResendCode" />
                                </RadzenStack>

                                @if (isVerifying || isResending)
                                {
                                    <div style="text-align: center; padding: 10px;">
                                        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
                                    </div>
                                }
                            </RadzenStack>
                        </RadzenTemplateForm>
                    </div>
                }
            </RadzenCard>
        </div>
    </div>
</div>

@code {
    bool isSuccess = false;
    bool hasError = false;
    string errorMessage = string.Empty;
    bool isVerifying = false;
    bool isResending = false;
    string? userEmail = null;

    class VerificationModel
    {
        public string Email { get; set; } = string.Empty;
        public string Code { get; set; } = string.Empty;
    }

    VerificationModel verificationModel = new();

    class VerifyResponse
    {
        [JsonPropertyName("success")]
        public bool Success { get; set; }
        
        [JsonPropertyName("message")]
        public string? Message { get; set; }
        
        [JsonPropertyName("alreadyConfirmed")]
        public bool? AlreadyConfirmed { get; set; }
    }

    protected override Task OnInitializedAsync()
    {
        // Query string'den email'i al
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var queryParams = QueryHelpers.ParseQuery(uri.Query);
        
        if (queryParams.TryGetValue("email", out var emailValues) && emailValues.Count > 0 && !string.IsNullOrWhiteSpace(emailValues[0]))
        {
            userEmail = emailValues[0];
            verificationModel.Email = userEmail ?? string.Empty;
        }
        
        return Task.CompletedTask;
    }

    private async Task OnVerifyCode(VerificationModel model)
    {
        if (isVerifying) return;

        if (string.IsNullOrWhiteSpace(model.Email))
        {
            hasError = true;
            errorMessage = "Lütfen e-posta adresinizi girin.";
            StateHasChanged();
            return;
        }

        if (string.IsNullOrWhiteSpace(model.Code) || model.Code.Length != 6)
        {
            hasError = true;
            errorMessage = "Lütfen 6 haneli doğrulama kodunu girin.";
            StateHasChanged();
            return;
        }

        isVerifying = true;
        hasError = false;
        StateHasChanged();

        try
        {
            var baseUrl = NavigationManager.BaseUri.TrimEnd('/');
            var request = new
            {
                Email = model.Email.Trim(),
                Code = model.Code.Trim()
            };

            var response = await Http.PostAsJsonAsync($"{baseUrl}/api/auth/verify-confirmation-code", request);
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<VerifyResponse>();
                if (result != null && result.Success)
                {
                    isSuccess = true;
                    hasError = false;
                    NotificationService.Notify(NotificationSeverity.Success, "Başarılı", result.Message ?? "E-posta başarıyla onaylandı.");
                }
                else
                {
                    hasError = true;
                    errorMessage = result?.Message ?? "Kod doğrulanırken bir hata oluştu.";
                }
            }
            else
            {
                var errorResult = await response.Content.ReadFromJsonAsync<VerifyResponse>();
                hasError = true;
                errorMessage = errorResult?.Message ?? "Kod doğrulanırken bir hata oluştu.";
            }
        }
        catch (Exception ex)
        {
            hasError = true;
            errorMessage = $"Bir hata oluştu: {ex.Message}";
        }
        finally
        {
            isVerifying = false;
            StateHasChanged();
        }
    }

    private async Task OnResendCode()
    {
        if (isResending) return;

        if (string.IsNullOrWhiteSpace(verificationModel.Email))
        {
            hasError = true;
            errorMessage = "Lütfen e-posta adresinizi girin.";
            StateHasChanged();
            return;
        }

        isResending = true;
        hasError = false;
        StateHasChanged();

        try
        {
            var baseUrl = NavigationManager.BaseUri.TrimEnd('/');
            var request = new
            {
                Email = verificationModel.Email.Trim()
            };

            var response = await Http.PostAsJsonAsync($"{baseUrl}/api/auth/send-confirmation-code", request);
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<VerifyResponse>();
                if (result != null && result.Success)
                {
                    NotificationService.Notify(NotificationSeverity.Success, "Başarılı", result.Message ?? "Doğrulama kodu e-postanıza gönderildi.");
                    verificationModel.Code = string.Empty; // Kodu temizle
                }
                else
                {
                    hasError = true;
                    errorMessage = result?.Message ?? "Kod gönderilirken bir hata oluştu.";
                }
            }
            else
            {
                var errorResult = await response.Content.ReadFromJsonAsync<VerifyResponse>();
                hasError = true;
                errorMessage = errorResult?.Message ?? "Kod gönderilirken bir hata oluştu.";
            }
        }
        catch (Exception ex)
        {
            hasError = true;
            errorMessage = $"Bir hata oluştu: {ex.Message}";
        }
        finally
        {
            isResending = false;
            StateHasChanged();
        }
    }
}
