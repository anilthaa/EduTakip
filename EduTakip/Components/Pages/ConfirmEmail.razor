@page "/confirm-email"
@using System.Net.Http.Json
@using Microsoft.AspNetCore.WebUtilities
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject NotificationService NotificationService

<PageTitle>E-posta Onayı</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <RadzenCard>
                @if (isProcessing)
                {
                    <div style="text-align: center; padding: 20px;">
                        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
                        <p style="margin-top: 10px;">E-posta onaylanıyor...</p>
                    </div>
                }
                else if (isSuccess)
                {
                    <div style="text-align: center; padding: 20px;">
                        <RadzenIcon Icon="check_circle" Style="font-size: 48px; color: green; margin-bottom: 20px;" />
                        <h3>E-posta Başarıyla Onaylandı!</h3>
                        <p>Hesabınızın e-postası onaylandı. Hesabınızın admin tarafından onaylanması gerekmektedir.</p>
                        <p>Onaylandıktan sonra giriş yapabilirsiniz.</p>
                        <RadzenButton Text="Giriş Sayfasına Git" ButtonStyle="ButtonStyle.Primary" Click="@(() => NavigationManager.NavigateTo("/login"))" Style="margin-top: 20px;" />
                    </div>
                }
                else if (hasError)
                {
                    <div style="text-align: center; padding: 20px;">
                        <RadzenIcon Icon="error" Style="font-size: 48px; color: red; margin-bottom: 20px;" />
                        <h3>Onay Başarısız</h3>
                        <p>@errorMessage</p>
                        <RadzenButton Text="Giriş Sayfasına Git" ButtonStyle="ButtonStyle.Primary" Click="@(() => NavigationManager.NavigateTo("/login"))" Style="margin-top: 20px;" />
                    </div>
                }
            </RadzenCard>
        </div>
    </div>
</div>

@code {
    bool isProcessing = true;
    bool isSuccess = false;
    bool hasError = false;
    string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        // Query string'den token'ı al
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var queryParams = QueryHelpers.ParseQuery(uri.Query);
        
        if (!queryParams.TryGetValue("token", out var tokenValues) || tokenValues.Count == 0 || string.IsNullOrWhiteSpace(tokenValues[0]))
        {
            hasError = true;
            errorMessage = "Geçersiz token.";
            isProcessing = false;
            StateHasChanged();
            return;
        }

        var token = tokenValues[0];

        try
        {
            var baseUrl = NavigationManager.BaseUri.TrimEnd('/');
            var url = $"{baseUrl}/api/auth/confirm-email?token={Uri.EscapeDataString(token)}";
            var response = await Http.GetAsync(url);
            
            if (response.IsSuccessStatusCode)
            {
                // Response başarılı, direkt başarılı olarak işaretle
                isSuccess = true;
                hasError = false;
                isProcessing = false;
                
                // Notification'ı güvenli şekilde gönder
                try
                {
                    var result = await response.Content.ReadFromJsonAsync<dynamic>();
                    NotificationService.Notify(NotificationSeverity.Success, "Başarılı", "E-posta başarıyla onaylandı. Hesabınızın admin tarafından onaylanması gerekmektedir.");
                }
                catch
                {
                    // JSON parse hatası olsa bile, notification gönder
                    NotificationService.Notify(NotificationSeverity.Success, "Başarılı", "E-posta başarıyla onaylandı. Hesabınızın admin tarafından onaylanması gerekmektedir.");
                }
                
                // State'i güncelle ve çık - finally bloğu çalışmayacak
                StateHasChanged();
                return;
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                hasError = true;
                isSuccess = false;
                isProcessing = false;
                // Hata mesajını temizle (tırnak işaretlerini kaldır)
                errorMessage = errorContent?.Trim('"') ?? "E-posta onaylanırken bir hata oluştu.";
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            hasError = true;
            isSuccess = false;
            isProcessing = false;
            errorMessage = $"Bir hata oluştu: {ex.Message}";
            StateHasChanged();
        }
    }
}
