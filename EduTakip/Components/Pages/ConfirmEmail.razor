@page "/confirm-email"

<PageTitle>E-posta Doğrulama</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card confirm-card">
                <div class="card-body">
                    @if (isSuccess)
                    {
                        <div style="text-align: center; padding: 20px;">
                            <span class="material-icons" style="font-size: 48px; color: green; margin-bottom: 20px;">check_circle</span>
                            <h3>E-posta Başarıyla Onaylandı!</h3>
                            <p>Hesabınızın e-postası onaylandı. Hesabınızın admin tarafından onaylanması gerekmektedir.</p>
                            <p>Onaylandıktan sonra giriş yapabilirsiniz.</p>
                            <button type="button" class="btn btn-primary" @onclick='() => NavigationManager.NavigateTo("/login")' style="margin-top: 20px;">Giriş Sayfasına Git</button>
                        </div>
                    }
                    else
                    {
                        <div class="confirm-content">
                            <h3 class="confirm-title">E-posta Doğrulama</h3>
                            <p class="confirm-subtitle">
                                @if (!string.IsNullOrWhiteSpace(userEmail))
                                {
                                    <span>@userEmail adresine gönderilen 6 haneli doğrulama kodunu girin.</span>
                                }
                                else
                                {
                                    <span>E-postanıza gönderilen 6 haneli doğrulama kodunu girin.</span>
                                }
                            </p>

                            <form @onsubmit="() => OnVerifyCode(verificationModel)" @onsubmit:preventDefault class="confirm-form">
                                <div class="code-inputs">
                                    @for (var i = 0; i < codeDigits.Length; i++)
                                    {
                                        var idx = i;
                                        <input type="text"
                                               maxlength="1"
                                               class="code-input"
                                               value="@codeDigits[idx]"
                                               @ref="codeInputs[idx]"
                                               @oninput="e => OnDigitChanged(idx, e)" />
                                    }
                                </div>

                                    @if (hasError)
                                    {
                                        <div class="alert alert-danger confirm-error">
                                            <strong>Hata</strong> @errorMessage
                                        </div>
                                    }

                                    <div class="confirm-actions">
                                        <button type="submit"
                                                class="btn btn-gradient btn-auth-primary confirm-primary"
                                                disabled="@(isVerifying || string.IsNullOrWhiteSpace(verificationModel.Code) || verificationModel.Code.Length != 6)">
                                            Kodu Doğrula
                                        </button>
                                        <button type="button"
                                                class="btn btn-outline confirm-secondary"
                                            disabled="@(isResending || string.IsNullOrWhiteSpace(verificationModel.Email))"
                                            @onclick="OnResendCode">
                                            Kodu Tekrar Gönder
                                        </button>
                                    </div>

                                @if (isVerifying || isResending)
                                {
                                    <div class="confirm-spinner">
                                        <div class="spinner"></div>
                                    </div>
                                }
                            </form>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    bool isSuccess = false;
    bool hasError = false;
    string errorMessage = string.Empty;
    bool isVerifying = false;
    bool isResending = false;
    string? userEmail = null;

    class VerificationModel
    {
        public string Email { get; set; } = string.Empty;
        public string Code { get; set; } = string.Empty;
    }

    VerificationModel verificationModel = new();
    string[] codeDigits = new string[6];
    ElementReference[] codeInputs = new ElementReference[6];

    class VerifyResponse
    {
        [JsonPropertyName("success")]
        public bool Success { get; set; }
        
        [JsonPropertyName("message")]
        public string? Message { get; set; }
        
        [JsonPropertyName("alreadyConfirmed")]
        public bool? AlreadyConfirmed { get; set; }
    }

    protected override Task OnInitializedAsync()
    {
        // Query string'den email'i al
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var queryParams = QueryHelpers.ParseQuery(uri.Query);
        
        if (queryParams.TryGetValue("email", out var emailValues) && emailValues.Count > 0 && !string.IsNullOrWhiteSpace(emailValues[0]))
        {
            userEmail = emailValues[0];
            verificationModel.Email = userEmail ?? string.Empty;
        }

        SyncDigitsFromCode();
        
        return Task.CompletedTask;
    }

    private void SyncDigitsFromCode()
    {
        Array.Clear(codeDigits, 0, codeDigits.Length);
        var code = verificationModel.Code ?? string.Empty;
        var len = Math.Min(code.Length, codeDigits.Length);
        for (var i = 0; i < len; i++)
        {
            codeDigits[i] = code[i].ToString();
        }
    }

    private void SyncCodeFromDigits()
    {
        verificationModel.Code = string.Concat(codeDigits);
    }

    private async Task OnDigitChanged(int index, ChangeEventArgs e)
    {
        if (index < 0 || index >= codeDigits.Length) return;

        var value = e.Value?.ToString() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(value))
        {
            codeDigits[index] = string.Empty;
        }
        else
        {
            var c = value[0];
            if (!char.IsDigit(c))
            {
                return;
            }
            codeDigits[index] = c.ToString();
        }

        SyncCodeFromDigits();

        // Eğer bir rakam girildiyse otomatik olarak bir sonraki inputa geç
        if (!string.IsNullOrWhiteSpace(codeDigits[index]) && index < codeInputs.Length - 1)
        {
            await codeInputs[index + 1].FocusAsync();
        }
    }

    private async Task OnVerifyCode(VerificationModel model)
    {
        if (isVerifying) return;

        if (string.IsNullOrWhiteSpace(model.Email))
        {
            hasError = true;
            errorMessage = "Lütfen e-posta adresinizi girin.";
            StateHasChanged();
            return;
        }

        if (string.IsNullOrWhiteSpace(model.Code) || model.Code.Length != 6)
        {
            hasError = true;
            errorMessage = "Lütfen 6 haneli doğrulama kodunu girin.";
            StateHasChanged();
            return;
        }

        isVerifying = true;
        hasError = false;
        StateHasChanged();

        try
        {
            var baseUrl = NavigationManager.BaseUri.TrimEnd('/');
            var request = new
            {
                Email = model.Email.Trim(),
                Code = model.Code.Trim()
            };

            var response = await Http.PostAsJsonAsync($"{baseUrl}/api/auth/verify-confirmation-code", request);
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<VerifyResponse>();
                if (result != null && result.Success)
                {
                    isSuccess = true;
                    hasError = false;
                    ToastService.Notify(ToastSeverity.Success, "Başarılı", result.Message ?? "E-posta başarıyla onaylandı.");
                }
                else
                {
                    hasError = true;
                    errorMessage = result?.Message ?? "Kod doğrulanırken bir hata oluştu.";
                }
            }
            else
            {
                var errorResult = await response.Content.ReadFromJsonAsync<VerifyResponse>();
                hasError = true;
                errorMessage = errorResult?.Message ?? "Kod doğrulanırken bir hata oluştu.";
            }
        }
        catch (Exception ex)
        {
            hasError = true;
            errorMessage = $"Bir hata oluştu: {ex.Message}";
        }
        finally
        {
            isVerifying = false;
            StateHasChanged();
        }
    }

    private async Task OnResendCode()
    {
        if (isResending) return;

        if (string.IsNullOrWhiteSpace(verificationModel.Email))
        {
            hasError = true;
            errorMessage = "Lütfen e-posta adresinizi girin.";
            StateHasChanged();
            return;
        }

        isResending = true;
        hasError = false;
        StateHasChanged();

        try
        {
            var baseUrl = NavigationManager.BaseUri.TrimEnd('/');
            var request = new
            {
                Email = verificationModel.Email.Trim()
            };

            var response = await Http.PostAsJsonAsync($"{baseUrl}/api/auth/send-confirmation-code", request);
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<VerifyResponse>();
                if (result != null && result.Success)
                {
                    ToastService.Notify(ToastSeverity.Success, "Başarılı", result.Message ?? "Doğrulama kodu e-postanıza gönderildi.");
                    verificationModel.Code = string.Empty; // Kodu temizle
                    Array.Clear(codeDigits, 0, codeDigits.Length);
                }
                else
                {
                    hasError = true;
                    errorMessage = result?.Message ?? "Kod gönderilirken bir hata oluştu.";
                }
            }
            else
            {
                var errorResult = await response.Content.ReadFromJsonAsync<VerifyResponse>();
                hasError = true;
                errorMessage = errorResult?.Message ?? "Kod gönderilirken bir hata oluştu.";
            }
        }
        catch (Exception ex)
        {
            hasError = true;
            errorMessage = $"Bir hata oluştu: {ex.Message}";
        }
        finally
        {
            isResending = false;
            StateHasChanged();
        }
    }
}
