@page "/email-confirmed"
@layout EmptyLayout

<PageTitle>E-posta Onaylandı</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body" style="text-align: center; padding: 2rem;">
                    <span class="material-icons" style="font-size: 48px; color: green; margin-bottom: 20px;">check_circle</span>
                    <h3>E-posta Başarıyla Onaylandı!</h3>
                    <p>Hesabınızın e-postası onaylandı. Hesabınızın admin tarafından onaylanması gerekmektedir.</p>
                    <p>Admin onayından sonra giriş yapabilirsiniz.</p>
                    <button class="btn btn-primary" @onclick='() => NavigationManager.NavigateTo("/login")' style="margin-top: 20px;">
                        Giriş Sayfasına Git
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
}
