@page "/ogretmen/sinif/{sinifId:int}/odevler"
@attribute [Authorize(Roles ="Öğretmen")]

<h3>Sınıf Ödevleri</h3>

<button class="btn btn-primary btn-sm mb-3" @onclick="@YeniOdev">
	<span class="material-icons">add</span> Yeni Ödev Ver
</button>

<div class="data-table-wrapper">
	<table class="data-table">
		<thead>
			<tr>
				<th>Ödev Başlığı</th>
				<th>Son Teslim</th>
				<th>Teslim Durumu</th>
				<th>İşlem</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in odevler)
			{
				<tr>
					<td>@item.Baslik</td>
					<td>@item.SonTeslimTarihi.ToString("dd.MM.yyyy HH:mm")</td>
					<td>
						<span class="badge badge-info">@($"{item.TeslimEden}/{item.ToplamOgrenci}")</span>
					</td>
					<td>
						<button class="btn btn-info btn-sm" @onclick="@(() => Teslimler(item.OdevId))">
							<span class="material-icons">visibility</span>
						</button>
					</td>
				</tr>
			}
		</tbody>
	</table>
</div>

@code {
	[Parameter] public int sinifId { get; set; }
	List<SinifOdevListDto> odevler = new();
	protected override async Task OnInitializedAsync()
	{
		await Yukle();
	}

	async Task Yukle()
	{
		// Sınıfın ders programındaki ders ID'lerini bul
		var sinifDersIdleri = await DbContext.DersProgramlari
			.Where(dp => dp.Sinif_ID == sinifId && (dp.DelDate == null || dp.DelDate == default(DateTime)))
			.Select(dp => dp.Ders_ID)
			.Distinct()
			.ToListAsync();

		int toplamOgrenci = await DbContext.SinifKullanicilar
			.CountAsync(x => x.Sinif_ID == sinifId && x.Tip == SinifKullaniciTip.Ogrenci && (x.DelDate == null || x.DelDate == default(DateTime)));

		odevler = await DbContext.Odevler
			.Where(o => sinifDersIdleri.Contains(o.Ders_ID) && (o.DelDate == null || o.DelDate == default(DateTime)))
			.Select(o => new SinifOdevListDto
			{
				OdevId = o.ID,
				Baslik = o.Baslik,
				SonTeslimTarihi = o.SonTeslimTarihi,
				ToplamOgrenci = toplamOgrenci,
				TeslimEden = DbContext.OdevTeslimler.Count(t => t.Odev_ID == o.ID && (t.DelDate == null || t.DelDate == default(DateTime)))
			})
			.OrderByDescending(o => o.SonTeslimTarihi)
			.ToListAsync();
	}

	void YeniOdev()
	{
		NavigationManager.NavigateTo($"/ogretmen/sinif/{sinifId}/odev-ekle");
	}

	void Teslimler(int odevId)
	{
		NavigationManager.NavigateTo($"/ogretmen/odev-teslimleri/{odevId}");
	}
}
