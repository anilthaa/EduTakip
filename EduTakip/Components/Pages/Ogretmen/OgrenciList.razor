@page "/ogretmen/ogrenciler"

@attribute [Authorize(Roles = "Öğretmen")]

<PageTitle>Öğrenci Listesi</PageTitle>

<h3>Sınıflarımdaki Öğrenciler</h3>

<div class="card mb-3">
    <div class="card-body">
        <div class="flex-row gap-sm items-center">
            <label>Sınıf Filtresi:</label>
            <select class="form-select" style="width: 200px;" @bind="seciliSinifId" @bind:after="OnSinifFiltreDegisti">
                <option value="">Tüm Sınıflar</option>
                @foreach (var s in siniflar)
                {
                    <option value="@s.ID">@s.Adi</option>
                }
            </select>
            <button class="btn btn-outline btn-sm" @onclick="FiltreyiTemizle"><span class="material-icons">clear</span> Filtreyi Temizle</button>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="data-table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Öğrenci No</th>
                        <th>Ad</th>
                        <th>Soyad</th>
                        <th>E-Posta</th>
                        <th>Sınıf</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in filtrelenmisOgrenciler)
                    {
                        <tr>
                            <td>@item.OgrenciNo</td>
                            <td>@item.Kullanici.Adi</td>
                            <td>@item.Kullanici.Soyadi</td>
                            <td>@item.Kullanici.EPosta</td>
                            <td>@item.Sinif?.Adi</td>
                            <td>
                                <button class="btn btn-danger btn-sm" @onclick="@(() => OgrenciyiSiniftanCikar(item))"><span class="material-icons">person_remove</span> Sınıftan Çıkar</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private int? ogretmenId;
    private List<ItemOgrenci> ogrenciler = new();
    private List<ItemOgrenci> filtrelenmisOgrenciler = new();
    private List<ItemSinif> siniflar = new();
    private int? seciliSinifId;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateService.CurrentUser == null)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        // Öğretmen ID'sini bul
        ogretmenId = await DbContext.Ogretmenler
            .Where(x => x.Kullanici_ID == AuthStateService.CurrentUser.ID && (x.DelDate == null || x.DelDate == default(DateTime)))
            .Select(x => x.ID)
            .FirstOrDefaultAsync();

        if (!ogretmenId.HasValue)
        {
            return;
        }

        await YukleOgrenciler();
        await YukleSiniflar();
    }

    async Task YukleOgrenciler()
    {
        // Öğretmenin ders programlarındaki sınıf ID'lerini bul
        var ogretmenSinifIdleri = await DbContext.DersProgramlari
            .Include(x => x.Ders)
            .Where(x => x.Ders.Ogretmen_ID == ogretmenId!.Value && (x.DelDate == null || x.DelDate == default(DateTime)))
            .Select(x => x.Sinif_ID)
            .Distinct()
            .ToListAsync();

        // Bu sınıflardaki öğrencileri getir
        ogrenciler = await DbContext.Ogrenciler
            .Include(x => x.Kullanici)
            .Include(x => x.Sinif)
            .Where(x => (x.DelDate == null || x.DelDate == default(DateTime)) && x.Sinif_ID.HasValue && ogretmenSinifIdleri.Contains(x.Sinif_ID.Value))
            .OrderBy(x => x.Sinif != null ? x.Sinif.Adi : "")
            .ThenBy(x => x.Kullanici.Adi)
            .ThenBy(x => x.Kullanici.Soyadi)
            .ToListAsync();

        Filtrele();
    }

    async Task YukleSiniflar()
    {
        // Öğretmenin ders programlarındaki sınıf ID'lerini bul
        var ogretmenSinifIdleri = await DbContext.DersProgramlari
            .Include(x => x.Ders)
            .Where(x => x.Ders.Ogretmen_ID == ogretmenId!.Value && (x.DelDate == null || x.DelDate == default(DateTime)))
            .Select(x => x.Sinif_ID)
            .Distinct()
            .ToListAsync();

        // Bu sınıfları getir
        siniflar = await DbContext.Siniflar
            .Where(s => ogretmenSinifIdleri.Contains(s.ID) && (s.DelDate == null || s.DelDate == default(DateTime)) && s.Aktif)
            .OrderBy(s => s.Adi)
            .ToListAsync();
    }

    void OnSinifFiltreDegisti()
    {
        Filtrele();
    }

    void Filtrele()
    {
        if (seciliSinifId.HasValue)
        {
            filtrelenmisOgrenciler = ogrenciler
                .Where(x => x.Sinif_ID == seciliSinifId.Value)
                .ToList();
        }
        else
        {
            filtrelenmisOgrenciler = ogrenciler;
        }
    }

    void FiltreyiTemizle()
    {
        seciliSinifId = null;
        Filtrele();
    }

    async Task OgrenciyiSiniftanCikar(ItemOgrenci ogrenci)
    {
        if (!ogretmenId.HasValue) return;

        // Onay dialogu
        var result = await JSRuntime.InvokeAsync<bool>("confirm",
            $"{ogrenci.Kullanici.Adi} {ogrenci.Kullanici.Soyadi} adlı öğrenciyi sınıftan çıkarmak istediğinize emin misiniz?");

        if (!result) return;

        try
        {
            // Öğrencinin kullanıcı ID'sini al
            var kullaniciId = ogrenci.Kullanici_ID;

            // Öğretmenin derslerini bul
            var ogretmenDersleri = await DbContext.Dersler
                .Where(x => x.Ogretmen_ID == ogretmenId.Value && (x.DelDate == null || x.DelDate == default(DateTime)))
                .Select(x => x.ID)
                .ToListAsync();

            if (!ogretmenDersleri.Any())
            {
                ToastService.Notify(ToastSeverity.Warning, "Uyarı", "Bu öğretmenin aktif dersleri bulunmamaktadır.");
                return;
            }

            // Öğrencinin bu öğretmenin derslerindeki katılımlarını bul
            // Global query filter'ı bypass etmek için IgnoreQueryFilters kullan
            // Böylece soft delete yapılmış kayıtları da görebiliriz
            var katilimlar = await DbContext.DersKatilimcilar
                .IgnoreQueryFilters()
                .Where(x => x.Ogrenci_ID == kullaniciId && 
                           ogretmenDersleri.Contains(x.Ders_ID) && 
                           (x.DelDate == null || x.DelDate == default(DateTime)))
                .ToListAsync();

            if (!katilimlar.Any())
            {
                ToastService.Notify(ToastSeverity.Info, "Bilgi", $"Bu öğrenci sizin derslerinize kayıtlı değil. (Kullanıcı ID: {kullaniciId}, Öğretmen Ders Sayısı: {ogretmenDersleri.Count})");
                return;
            }

            // Soft delete yap
            int cikarilanDersSayisi = 0;
            foreach (var katilim in katilimlar)
            {
                // Entity state'i manuel olarak Modified yap
                var entry = DbContext.Entry(katilim);
                entry.Property(x => x.DelDate).CurrentValue = DateTime.UtcNow;
                entry.Property(x => x.DelUser).CurrentValue = 0;
                entry.Property(x => x.DelDate).IsModified = true;
                entry.Property(x => x.DelUser).IsModified = true;
                cikarilanDersSayisi++;
            }

            var saveResult = await DbContext.SaveChangesAsync();

            if (saveResult > 0 && cikarilanDersSayisi > 0)
            {
                ToastService.Notify(ToastSeverity.Success, "Başarılı", $"{ogrenci.Kullanici.Adi} {ogrenci.Kullanici.Soyadi} adlı öğrenci {cikarilanDersSayisi} dersten çıkarıldı.");

                // Listeyi yenile
                await YukleOgrenciler();
                StateHasChanged();
            }
            else
            {
                ToastService.Notify(ToastSeverity.Warning, "Uyarı", $"Öğrenci çıkarılamadı. (SaveResult: {saveResult}, Katılım Sayısı: {cikarilanDersSayisi})");
            }
        }
        catch (Exception ex)
        {
            ToastService.Notify(ToastSeverity.Error, "Hata", $"Öğrenci sınıftan çıkarılırken bir hata oluştu: {ex.Message}");
        }
    }
}
