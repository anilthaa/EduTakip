<form @onsubmit="Kaydet" @onsubmit:preventDefault>
	<div class="form-group">
		<label class="form-label">Ders</label>
		<select class="form-select" @bind="model.Ders_ID">
			<option value="0">Ders Seciniz</option>
			@foreach (var d in dersler)
			{
				<option value="@d.ID">@d.Adi</option>
			}
		</select>
	</div>
	<div class="form-group" style="margin-top:10px">
		<label class="form-label">Ödev Başlığı</label>
		<input type="text" class="form-control" @bind="model.Baslik" placeholder="Odev Basligi" />
	</div>
	<div class="form-group" style="margin-top:10px">
		<label class="form-label">Açıklama</label>
		<textarea class="form-control" @bind="model.Aciklama" placeholder="Aciklama"></textarea>
	</div>
	<div class="form-group" style="margin-top:10px">
		<label class="form-label">Son Teslim Tarihi</label>
		<input type="datetime-local" class="form-control" @bind="model.SonTeslimTarihi" />
	</div>
	<div class="mt-3 text-center">
		<button type="submit" class="btn btn-success btn-sm" style="margin-right:10px;">Kaydet</button>
		<button type="button" class="btn btn-danger btn-sm" @onclick="@(() => ModalService.Close(false))">Iptal</button>
	</div>
</form>

@code {

	ItemOdev model = new();
	List<ItemDers> dersler = new();
	[Parameter] public int? OdevId { get; set; }
	[Parameter] public int SinifId { get; set; }
	int ogretmenId;

	protected override async Task OnInitializedAsync()
	{
		try
		{
			var currentUser = AuthStateService.CurrentUser;
			if (currentUser == null)
			{
				ToastService.Notify(ToastSeverity.Error, "Hata", "Kullanıcı bilgisi bulunamadı.");
				ModalService.Close(false);
				return;
			}

			ogretmenId=await DbContext.Ogretmenler
			.Where(x => x.Kullanici_ID == currentUser.ID && x.DelDate==null)
			.Select(x => x.ID)
			.FirstAsync();

			if (SinifId > 0)
			{
				var sinifAdi = await DbContext.Siniflar
					.Where(s => s.ID == SinifId && (s.DelDate == null || s.DelDate == default(DateTime)))
					.Select(s => s.Adi)
					.FirstOrDefaultAsync();

				if (!string.IsNullOrEmpty(sinifAdi))
				{
					var sinifDersleri = await DbContext.DersProgramlari
						.Where(dp => dp.Sinif_ID == SinifId && (dp.DelDate == null || dp.DelDate == default(DateTime)) && dp.Aktif)
						.Select(dp => dp.Ders_ID)
						.Distinct()
						.ToListAsync();

					dersler = await DbContext.Dersler
						.Where(x => x.Ogretmen_ID == ogretmenId && 
								   (x.DelDate == null || x.DelDate == default(DateTime)) && 
								   sinifDersleri.Contains(x.ID))
						.OrderBy(x => x.Adi)
						.ToListAsync();
				}
				else
				{
					dersler = await DbContext.Dersler
						.Where(x => x.Ogretmen_ID == ogretmenId && (x.DelDate == null || x.DelDate == default(DateTime)))
						.OrderBy(x => x.Adi)
						.ToListAsync();
				}
			}
			else
			{
				dersler = await DbContext.Dersler
					.Where(x => x.Ogretmen_ID == ogretmenId && (x.DelDate == null || x.DelDate == default(DateTime)))
					.OrderBy(x => x.Adi)
					.ToListAsync();
			}

			if (OdevId.HasValue)
			{
				var odev = await DbContext.Odevler
					.FirstOrDefaultAsync(x => x.ID == OdevId.Value);
				if (odev == null)
				{
					ToastService.Notify(ToastSeverity.Error, "Hata", "Ödev bulunamadı veya silinmiş.");
					ModalService.Close(false);
					return;
				}
				model = odev;
			}
			else
			{
				model.VerilisTarihi = DateTime.UtcNow;
			}

		}
		catch (Exception ex)
		{
			ToastService.Notify(ToastSeverity.Error, "Hata", $"Bir hata oluştu: {ex.Message}");
			ModalService.Close(false);
		}
	}

	async Task Kaydet()
	{
		try
		{
			if (model.Ders_ID==0)
			{
				ToastService.Notify(ToastSeverity.Warning, "Uyarı", "Lütfen bir ders seçiniz.");
				return;
			}
			if(OdevId==null)
			{
				DbContext.Odevler.Add(model);
			}
			else
			{
				DbContext.Odevler.Update(model);
			}
			await DbContext.SaveChangesAsync();
			ToastService.Notify(ToastSeverity.Success, "Başarılı", "Ödev başarıyla kaydedildi.");
			ModalService.Close(true);
		}
		catch (Exception ex)
		{
			ToastService.Notify(ToastSeverity.Error, "Hata", $"Bir hata oluştu: {ex.Message}");
		}
	}
}
