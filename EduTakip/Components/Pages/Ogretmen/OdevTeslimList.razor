@page "/ogretmen/odev-teslimleri/{OdevId:int}"
@attribute [Authorize(Roles ="Öğretmen")]
@inject NavigationManager NavigationManager

<RadzenCard Style="margin:0; margin-left:0; padding:20px; width:100%; max-width:none; box-sizing:border-box">
	<h3>Odev Teslimleri</h3>

	@if (teslimler==null || !teslimler.Any())
	{
		<div style="text-align:center; padding:50px">
			<p style="color:#7f8c8d; font-style:italic">Kayıt Bulunamadı.</p>
		</div>
	}
	else
	{
		<RadzenDataGrid Data="@teslimler" TItem="ItemOdevTeslim" AllowPaging="true" PageSize="10">
			<Columns>
				<RadzenDataGridColumn TItem="ItemOdevTeslim" Title="Öğrenci Adı Soyadı">
					<Template Context="item">
						@item.Ogrenci.Adi @item.Ogrenci.Soyadi
					</Template>

				</RadzenDataGridColumn>

				<RadzenDataGridColumn TItem="ItemOdevTeslim" Title="Ödev">
					<Template Context="item">
						@item.Odev.Baslik
					</Template>
				</RadzenDataGridColumn>

				<RadzenDataGridColumn TItem="ItemOdevTeslim" Property="TeslimTarihi" Title="Teslim Tarihi"></RadzenDataGridColumn>



				<RadzenDataGridColumn TItem="ItemOdevTeslim" Title="Not">
					<Template Context="item">
						@if (item.Not.HasValue)
						{
							@item.Not
						}
						else
						{
							<span style="color: gray;">Not Verilmedi</span>
						}
					</Template>
				</RadzenDataGridColumn>

				<RadzenDataGridColumn TItem="ItemOdevTeslim" Title="Öğretmen Yorumu">
					<Template Context="item">
						@if (!string.IsNullOrEmpty(item.OgretmenYorumu))
						{
							@item.OgretmenYorumu
						}
						else
						{
							<span style="color: gray;">Yorum Yok</span>
						}
					</Template>
				</RadzenDataGridColumn>

				<RadzenDataGridColumn TItem="ItemOdevTeslim" Title="İşlem">
					<Template Context="item">
						<RadzenButton Icon="edit" Size="ButtonSize.Small" Click="@(() => NotVer(item))"></RadzenButton>
					</Template>
				</RadzenDataGridColumn>

				<RadzenDataGridColumn TItem="ItemOdevTeslim" Title="Dosya">
					<Template Context="item">
						@if (!string.IsNullOrEmpty(item.DosyaYolu))
						{
							<RadzenButton Icon="download" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary" Click="@(() => DosyaIndir(item.DosyaYolu))"></RadzenButton>
						}
					</Template>
				</RadzenDataGridColumn>
			</Columns>
		</RadzenDataGrid>
	}

		
</RadzenCard>
@code {
	[Parameter] public int OdevId { get; set; }

	List<ItemOdevTeslim> teslimler = new();

	protected override async Task OnInitializedAsync()
	{
		await Listele();
	}

	async Task Listele()
	{
		teslimler = await DbContext.OdevTeslimler
			.Include(x => x.Ogrenci)
			.Where(x => x.Odev_ID == OdevId && x.DelDate == null)
			.ToListAsync();
	}

	async Task NotVer(ItemOdevTeslim teslim)
	{
		var result = await DialogService.OpenAsync<OdevNotTnm>("Not Ver", new Dictionary<string, object>()
		{
			{ "OdevTeslimId", teslim.ID }
		}, new DialogOptions() { Width = "400px", Height = "300px" });
		if (result == true)
		{
			await Listele();
			StateHasChanged();
		}
	}

	void DosyaIndir(string dosyaYolu)
	{
		if (!string.IsNullOrEmpty(dosyaYolu))
		{
			NavigationManager.NavigateTo(dosyaYolu, forceLoad: true);
		}
	}
}
