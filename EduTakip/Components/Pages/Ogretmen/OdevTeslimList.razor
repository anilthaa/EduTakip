@page "/ogretmen/odev-teslimleri/{OdevId:int}"
@attribute [Authorize(Roles ="Öğretmen")]

<div class="card" style="margin:0; margin-left:0; padding:0; width:100%; max-width:none; box-sizing:border-box">
	<div class="card-body" style="padding:20px;">
		<h3>Odev Teslimleri</h3>

		@if (teslimler==null || !teslimler.Any())
		{
			<div style="text-align:center; padding:50px">
				<p style="color:#7f8c8d; font-style:italic">Kayıt Bulunamadı.</p>
			</div>
		}
		else
		{
			<div class="data-table-wrapper">
				<table class="data-table">
					<thead>
						<tr>
							<th>Öğrenci Adı Soyadı</th>
							<th>Ödev</th>
							<th>Teslim Tarihi</th>
							<th>Not</th>
							<th>Öğretmen Yorumu</th>
							<th>İşlem</th>
							<th>Dosya</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var item in teslimler)
						{
							<tr>
								<td>@item.Ogrenci.Adi @item.Ogrenci.Soyadi</td>
								<td>@item.Odev.Baslik</td>
								<td>@item.TeslimTarihi</td>
								<td>
									@if (item.Not.HasValue)
									{
										@item.Not
									}
									else
									{
										<span style="color: gray;">Not Verilmedi</span>
									}
								</td>
								<td>
									@if (!string.IsNullOrEmpty(item.OgretmenYorumu))
									{
										@item.OgretmenYorumu
									}
									else
									{
										<span style="color: gray;">Yorum Yok</span>
									}
								</td>
								<td>
									<button class="btn btn-primary btn-sm" @onclick="@(() => NotVer(item))">
										<span class="material-icons">edit</span>
									</button>
								</td>
								<td>
									@if (!string.IsNullOrEmpty(item.DosyaYolu))
									{
										<button class="btn btn-primary btn-sm" @onclick="@(() => DosyaIndir(item.DosyaYolu))">
											<span class="material-icons">download</span>
										</button>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
</div>

@code {
	[Parameter] public int OdevId { get; set; }

	List<ItemOdevTeslim> teslimler = new();

	protected override async Task OnInitializedAsync()
	{
		await Listele();
	}

	async Task Listele()
	{
		teslimler = await DbContext.OdevTeslimler
			.Include(x => x.Ogrenci)
			.Where(x => x.Odev_ID == OdevId && (x.DelDate == null || x.DelDate == default(DateTime)))
			.ToListAsync();
	}

	async Task NotVer(ItemOdevTeslim teslim)
	{
		var result = await ModalService.OpenAsync<OdevNotTnm>("Not Ver", new Dictionary<string, object>()
		{
			{ "OdevTeslimId", teslim.ID }
		}, new ModalOptions() { CssClass = "modal-md" });
		if (result is true)
		{
			await Listele();
			StateHasChanged();
		}
	}

	void DosyaIndir(string dosyaYolu)
	{
		if (!string.IsNullOrEmpty(dosyaYolu))
		{
			NavigationManager.NavigateTo(dosyaYolu, forceLoad: true);
		}
	}
}
