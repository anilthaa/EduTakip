<form @onsubmit="Kaydet" @onsubmit:preventDefault>
	<div class="form-group">
		<label class="form-label">Not</label>
		<input type="number" class="form-control" @bind="model.Not" min="0" max="100" placeholder="Not" />
	</div>
	<div class="form-group" style="margin-top:10px">
		<label class="form-label">Öğretmen Yorumu</label>
		<textarea class="form-control" @bind="model.OgretmenYorumu" placeholder="Ogretmen Yorumu"></textarea>
	</div>
	<div class="mt-3 text-center">
		<button type="submit" class="btn btn-success btn-sm" style="margin-right:10px;">Kaydet</button>
		<button type="button" class="btn btn-danger btn-sm" @onclick="@(() => ModalService.Close(false))">Iptal</button>
	</div>
</form>

@code {

	ItemOdevTeslim model = new();
	[Parameter] public int OdevTeslimId { get; set; }

	protected override async Task OnInitializedAsync()
	{
		try
		{
			model = await DbContext.OdevTeslimler
				.FirstOrDefaultAsync(x => x.ID == OdevTeslimId);
			if (model == null)
			{
				ToastService.Notify(ToastSeverity.Error, "Hata", "Ödev teslimi bulunamadı veya silinmiş.");
				ModalService.Close(false);
				return;
			}
		}
		catch (Exception ex)
		{
			ToastService.Notify(ToastSeverity.Error, "Hata", $"Bir hata oluştu: {ex.Message}");
			ModalService.Close(false);
		}
	}

	async Task Kaydet()
	{
		try
		{
			DbContext.OdevTeslimler.Update(model);
			await DbContext.SaveChangesAsync();
			ToastService.Notify(ToastSeverity.Success, "Başarılı", "Not başarıyla kaydedildi.");
			ModalService.Close(true);
		}
		catch (Exception ex)
		{
			ToastService.Notify(ToastSeverity.Error, "Hata", $"Bir hata oluştu: {ex.Message}");
		}
	}
}
