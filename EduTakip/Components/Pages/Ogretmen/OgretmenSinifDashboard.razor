@page "/ogretmen/sinif/{sinifId:int}"

@attribute [Authorize(Roles ="Öğretmen")]

<h3>@detay?.SinifAdi</h3>

<div class="grid grid-3 mb-3" style="gap:1rem">
	<div>
		<div class="card">
			<div class="card-body">
				<h6>Öğrenci Sayısı</h6>
				<h2>@detay?.OgrenciSayisi</h2>

				<button class="btn btn-info btn-sm" @onclick="@(()=>Ogrenciler())"><span class="material-icons">group</span> Öğrencileri Gör</button>
			</div>
		</div>
	</div>

	<div>
		<div class="card">
			<div class="card-body">
				<h6>Ödevler</h6>
				<h2>@detay?.OdevSayisi</h2>

				<button class="btn btn-primary btn-sm" @onclick="@(()=>OdevVer())"><span class="material-icons">assignment</span> Ödev Ver</button>
			</div>
		</div>
	</div>

	<div>
		<div class="card">
			<div class="card-body">
				<h6>Duyurular</h6>
				<p class="text-muted">Henüz Yok</p>
			</div>
		</div>
	</div>
</div>
@code {
	[Parameter] public int sinifId { get; set; }
	SinifDashboardOgretmenDto detay;

	protected override async Task OnInitializedAsync()
	{
		await Yukle();
	}

	async Task Yukle()
	{
		var sinif = await DbContext.Siniflar
			.Where(s => s.ID == sinifId && (s.DelDate == null || s.DelDate == default(DateTime)))
			.FirstOrDefaultAsync();

		if (sinif == null) return;

		// Öğrenci sayısını ayrı sorgu ile al (EF Core projeksiyon içi subquery güvenilir değil)
		var ogrenciSayisi = await DbContext.SinifKullanicilar
			.CountAsync(o => o.Sinif_ID == sinifId
				&& o.Tip == SinifKullaniciTip.Ogrenci
				&& (o.DelDate == null || o.DelDate == default(DateTime)));

		// Bu sınıfta programlanmış derslerin ID'lerini bul
		var sinifDersleri = await DbContext.DersProgramlari
			.Where(dp => dp.Sinif_ID == sinifId && (dp.DelDate == null || dp.DelDate == default(DateTime)) && dp.Aktif)
			.Select(dp => dp.Ders_ID)
			.Distinct()
			.ToListAsync();

		var odevSayisi = await DbContext.Odevler
			.CountAsync(o => sinifDersleri.Contains(o.Ders_ID) && (o.DelDate == null || o.DelDate == default(DateTime)));

		detay = new SinifDashboardOgretmenDto
		{
			SinifId = sinif.ID,
			SinifAdi = sinif.Adi,
			OgrenciSayisi = ogrenciSayisi,
			OdevSayisi = odevSayisi
		};
	}
	void Ogrenciler()
	{
		NavigationManager.NavigateTo($"/ogretmen/sinif-ogrencileri/{sinifId}");
	}
	async Task OdevVer()
	{
		var result = await ModalService.OpenAsync<OdevTnm>("Yeni Ödev Ver",
		new Dictionary<string, object>
			{
			{"SinifId", sinifId }
			},
		new ModalOptions
			{
				CssClass = "modal-md",
			});

		if (result is true)
		{
			await Yukle();
			StateHasChanged();
		}
	}
}
