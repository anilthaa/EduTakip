@page "/ogretmen/odevler"
@attribute [Authorize(Roles ="Öğretmen")]
<h3>Ödevlerim</h3>

 <RadzenButton Icon="add" Text="Yeni Ödev Ekle" ButtonStyle="ButtonStyle.Success" Style="margin-bottom:10px; border-radius:10px;" Click="yeniOdev" Title="Yeni Ödev">
 </RadzenButton>


<RadzenDataGrid Data="@list" TItem="ItemOdev" ColumnWidth="200px" AllowPaging="true" PageSize="10">
	<Columns>
		<RadzenDataGridColumn TItem="ItemOdev" Property="Ders.Adi" Title="Ders"></RadzenDataGridColumn>
		<RadzenDataGridColumn TItem="ItemOdev" Property="Baslik" Title="Baslik"></RadzenDataGridColumn>
		<RadzenDataGridColumn TItem="ItemOdev" Property="SonTeslimTarihi" Title="Son Teslim"></RadzenDataGridColumn>


		<RadzenDataGridColumn TItem="ItemOdev" Title="Islemler">
			<Template Context="item">
				<RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Success" Style="margin-right:10px;" Click="@(args => duzenleOdev(item))" Title="Düzenle"></RadzenButton>
				<RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Style="margin-right:10px;" Click="@(args=>silOdev(item))" Title="Sil"></RadzenButton>
				<RadzenButton Icon="folder_open" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary" Click="@(()=> GitTeslimlere(item.ID))" Title="Teslimler"></RadzenButton>
			</Template>
		</RadzenDataGridColumn>
	</Columns>
</RadzenDataGrid>

@code {

	List<ItemOdev> list;

	int ogretmenId = 1; //Simdilik

	protected override async Task OnInitializedAsync()
	{
		await Listele();
	}

	async Task Listele()
	{
		list = await DbContext.Odevler
			.Include(x => x.Ders)
			.Where(x => x.Ders.Ogretmen_ID == ogretmenId && x.DelDate == null)
			.OrderByDescending(x=>x.VerilisTarihi)
			.ToListAsync();
	}

	async Task yeniOdev()
	{
		var result = await DialogService.OpenAsync<OdevTnm>("Yeni Odev", new Dictionary<string, object>(),

			new DialogOptions() { Width = "600px", Height = "400px" });
		if (result == true)
			await Listele();
	}

	async Task duzenleOdev(ItemOdev item)
	{
		var result= await DialogService.OpenAsync<OdevTnm>("Ödev Düzenle", new Dictionary<string, object>()
		{
			{ "OdevId", item.ID }
		}, new DialogOptions() { Width = "600px", Height = "400px" });
		if (result == true)
			await Listele();
	}

	async Task silOdev(ItemOdev item)
	{
		bool? result = await DialogService.Confirm("Ödevi silmek istediğinize emin misiniz?", "Onay",
			new ConfirmOptions() { OkButtonText = "Evet", CancelButtonText = "Hayır" });
		if (result == true)
		{
			item.DelDate = DateTime.Now;
			item.DelUser = 0; // TODO: Gerçek kullanıcı ID'si kullanılacak
			DbContext.Odevler.Update(item);
			await DbContext.SaveChangesAsync();
			await Listele();
		}
	}

	void GitTeslimlere(int odevId)
	{
		NavigationManager.NavigateTo($"/ogretmen/odev-teslimleri/{odevId}");
	}
}
