@page "/ogretmen/odevler"
@attribute [Authorize(Roles = "Öğretmen")]


<button class="btn btn-success btn-sm" style="margin-bottom:10px; border-radius:10px;" @onclick="yeniOdev">
	<span class="material-icons">add</span> Yeni Ödev Ekle
</button>

<div class="card" style="margin:0; margin-left:0; padding:0; width:100%; max-width:none; box-sizing:border-box">
	<div class="card-body" style="padding:20px;">
		<h3 style="text-align:center" class="mb-3">Ödevlerim</h3>
		@if (list == null || !list.Any())
		{
			<div style="text-align:center; padding:50px">
				<p style="color:#7f8c8d; font-style:italic">Kayıt Bulunamadı.</p>
			</div>
		}
		else
		{
			<div class="data-table-wrapper">
				<table class="data-table">
					<thead>
						<tr>
							<th>Ders</th>
							<th>Baslik</th>
							<th>Son Teslim</th>
							<th>İşlemler</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var item in list)
						{
							<tr>
								<td>@item.Ders.Adi</td>
								<td>@item.Baslik</td>
								<td>@item.SonTeslimTarihi.ToString("dd.MM.yyyy HH:mm")</td>
								<td>
									<button class="btn btn-success btn-sm" style="margin-right:10px;" @onclick="@(() => duzenleOdev(item))" title="Düzenle">
										<span class="material-icons">edit</span>
									</button>
									<button class="btn btn-danger btn-sm" style="margin-right:10px;" @onclick="@(() => silOdev(item))" title="Sil">
										<span class="material-icons">delete</span>
									</button>
									<button class="btn btn-primary btn-sm" @onclick="@(() => GitTeslimlere(item.ID))" title="Teslimler">
										<span class="material-icons">folder_open</span>
									</button>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
</div>


@code {

	List<ItemOdev> list;

	int ogretmenId = 1; //Simdilik

	protected override async Task OnInitializedAsync()
	{
		await Listele();
	}

	async Task Listele()
	{
		list = await DbContext.Odevler
			.Include(x => x.Ders)
			.Where(x => x.Ders.Ogretmen_ID == ogretmenId && (x.DelDate == null || x.DelDate == default(DateTime)))
			.OrderByDescending(x => x.VerilisTarihi)
			.ToListAsync();
	}

	async Task yeniOdev()
	{
		var result = await ModalService.OpenAsync<OdevTnm>("Yeni Odev", new Dictionary<string, object>(),
			new ModalOptions() { CssClass = "modal-md" });
		if (result is true)
			await Listele();
	}

	async Task duzenleOdev(ItemOdev item)
	{
		var result = await ModalService.OpenAsync<OdevTnm>("Ödev Düzenle", new Dictionary<string, object>()
		{
			{ "OdevId", item.ID }
		}, new ModalOptions() { CssClass = "modal-md" });
		if (result is true)
			await Listele();
	}

	async Task silOdev(ItemOdev item)
	{
		bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Ödevi silmek istediğinize emin misiniz?");
		if (confirmed)
		{
			item.DelDate = DateTime.Now;
			item.DelUser = 0;
			DbContext.Odevler.Update(item);
			await DbContext.SaveChangesAsync();
			await Listele();
		}
	}

	void GitTeslimlere(int odevId)
	{
		NavigationManager.NavigateTo($"/ogretmen/odev-teslimleri/{odevId}");
	}
}
