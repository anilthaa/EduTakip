@page "/ogretmen/sinif-ogrencileri/{sinifId:int}"
@attribute [Authorize(Roles="Öğretmen")]

<h3>Sınıftaki Öğrenciler</h3>

<div class="data-table-wrapper">
	<table class="data-table">
		<thead>
			<tr>
				<th>Ad Soyad</th>
				<th>Öğrenci No</th>
				<th>İşlem</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in ogrenciler)
			{
				<tr>
					<td>@item.Ad @item.Soyad</td>
					<td>@item.OgrenciNo</td>
					<td>
						<button class="btn btn-danger btn-sm" @onclick="@(() => OgrenciCikar(item.SinifKullaniciId))"><span class="material-icons">logout</span></button>
					</td>
				</tr>
			}
		</tbody>
	</table>
</div>
@code {
	[Parameter] public int sinifId { get; set; }
	List<SinifOgrenciDto> ogrenciler = new();
	protected override async Task OnInitializedAsync()
	{
		await Yukle();
	}

	async Task Yukle()
	{
		// SinifKullanicilar üzerinden Include ile Kullanici bilgisini al
		var sinifKullanicilar = await DbContext.SinifKullanicilar
			.Include(x => x.Kullanici)
			.Where(x => x.Sinif_ID == sinifId
				&& x.Tip == SinifKullaniciTip.Ogrenci
				&& (x.DelDate == null || x.DelDate == default(DateTime)))
			.ToListAsync();

		// Kullanici_ID listesini çıkar
		var kullaniciIds = sinifKullanicilar.Select(x => x.Kullanici_ID).ToList();

		// OgrenciNo bilgisini ayrı sorgu ile al
		var ogrenciNolar = await DbContext.Ogrenciler
			.IgnoreQueryFilters()
			.Where(o => kullaniciIds.Contains(o.Kullanici_ID) && (o.DelDate == null || o.DelDate == default(DateTime)))
			.ToDictionaryAsync(o => o.Kullanici_ID, o => o.OgrenciNo);

		ogrenciler = sinifKullanicilar.Select(sk => new SinifOgrenciDto
		{
			SinifKullaniciId = sk.ID,
			Ad = sk.Kullanici?.Adi ?? "",
			Soyad = sk.Kullanici?.Soyadi ?? "",
			OgrenciNo = ogrenciNolar.TryGetValue(sk.Kullanici_ID, out var no) ? no : "-"
		}).ToList();
	}

	async Task OgrenciCikar(int sinifOgrenciId)
	{
		var sinifKullanici = await DbContext.SinifKullanicilar.FindAsync(sinifOgrenciId);
		if (sinifKullanici != null)
		{
			try
			{
				// Öğrencinin ItemOgrenci kaydını bul
				var ogrenci = await DbContext.Ogrenciler
					.Where(x => x.Kullanici_ID == sinifKullanici.Kullanici_ID && (x.DelDate == null || x.DelDate == default(DateTime)))
					.FirstOrDefaultAsync();

				// Eğer bu öğrencinin ana sınıfı bu sınıfsa, Sinif_ID'yi null yap
				if (ogrenci != null && ogrenci.Sinif_ID == sinifKullanici.Sinif_ID)
				{
					ogrenci.Sinif_ID = null;
					ogrenci.UpdDate = DateTime.UtcNow;
					ogrenci.UpdUser = AuthStateService.CurrentUser.ID;
					DbContext.Ogrenciler.Update(ogrenci);
				}

				// SinifKullanicilar kaydını soft delete yap
				sinifKullanici.DelDate = DateTime.UtcNow;
				sinifKullanici.DelUser = AuthStateService.CurrentUser.ID;
				DbContext.SinifKullanicilar.Update(sinifKullanici);

				// SinifOgrenciler tablosundaki kayıtları da kontrol et ve soft delete yap (eğer öğrenci bulunduysa)
				if (ogrenci != null)
				{
					var sinifOgrenciKayitlari = await DbContext.SinifOgrenciler
						.IgnoreQueryFilters()
						.Where(x => x.Sinif_ID == sinifKullanici.Sinif_ID && 
								   x.Ogrenci_ID == ogrenci.ID && 
								   (x.DelDate == null || x.DelDate == default(DateTime)))
						.ToListAsync();

					foreach (var so in sinifOgrenciKayitlari)
					{
						so.DelDate = DateTime.UtcNow;
						so.DelUser = AuthStateService.CurrentUser.ID;
						DbContext.SinifOgrenciler.Update(so);
					}
				}

				await DbContext.SaveChangesAsync();
				ToastService.Notify(ToastSeverity.Success, "Başarılı", "Öğrenci sınıftan çıkarıldı.", 4000);
				await Yukle();
				StateHasChanged();
			}
			catch (Exception ex)
			{
			}
		}
	}
	public class SinifOgrenciDto
	{
		public int SinifKullaniciId { get; set; }
		public string Ad { get; set; }
		public string Soyad { get; set; }
		public string OgrenciNo { get; set; }
	}
}
