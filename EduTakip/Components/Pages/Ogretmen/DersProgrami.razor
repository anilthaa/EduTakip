@page "/ogretmen/dersprogrami"
@attribute [Authorize(Roles ="Öğretmen")]

<div class="card" style="margin-top:20px">
	<div class="card-body">
		<h3 style="text-align:center;" class="mb-4">Ders Programım</h3>
		@if (list==null ||!list.Any())
		{
			<div style="text-align:center; padding:50px">
				<p style="color:#7f8c8d; font-style:italic">Kayıt Bulunamadı.</p>
			</div>
		}
		else
		{
			<div class="data-table-wrapper">
				<table class="data-table">
					<thead>
						<tr>
							<th>Gün</th>
							<th>Saat</th>
							<th>Ders</th>
							<th>Sınıf</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var item in list)
						{
							<tr>
								<td>@GetGunAdi(item.Gun)</td>
								<td>@item.BaslangicSaati - @item.BitisSaati</td>
								<td>@item.Ders?.Adi</td>
								<td>@item.Sinif?.Adi</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
</div>

@code {

	List<ItemDersProgrami> list = new();
	int? ogretmenId;

	private string GetGunAdi(DayOfWeek gun)
	{
		return gun switch
		{
			DayOfWeek.Monday => "Pazartesi",
			DayOfWeek.Tuesday => "Salı",
			DayOfWeek.Wednesday => "Çarşamba",
			DayOfWeek.Thursday => "Perşembe",
			DayOfWeek.Friday => "Cuma",
			DayOfWeek.Saturday => "Cumartesi",
			DayOfWeek.Sunday => "Pazar",
			_ => gun.ToString()
		};
	}

	protected override async Task OnInitializedAsync()
	{
		if (AuthStateService.CurrentUser == null)
		{
			return;
		}

		ogretmenId = await DbContext.Ogretmenler
			.Where(x => x.Kullanici_ID == AuthStateService.CurrentUser.ID && (x.DelDate == null || x.DelDate == default(DateTime)))
			.Select(x => (int?)x.ID)
			.FirstOrDefaultAsync();

		if (!ogretmenId.HasValue)
		{
			return;
		}

		list = await DbContext.DersProgramlari
			.Include(x => x.Ders)
			.Include(x => x.Sinif)
			.Where(x => x.Ders.Ogretmen_ID == ogretmenId.Value && (x.DelDate == null || x.DelDate == default(DateTime)) && x.Aktif)
			.OrderBy(x => x.Gun)
			.ThenBy(x => x.BaslangicSaati)
			.ToListAsync();
	}
}
