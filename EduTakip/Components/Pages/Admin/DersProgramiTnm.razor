<form @onsubmit="Kaydet" @onsubmit:preventDefault>
	<fieldset class="border rounded p-3">
		<legend class="w-auto px-2 fs-6">Ders Programı Bilgileri</legend>
		<div class="row">
			<div class="col-12 mb-3">
				<label class="form-label">Ders</label>
				<select class="form-select" @bind="model.Ders_ID">
					<option value="">Ders Seçin</option>
					@foreach (var d in dersler)
					{
						<option value="@d.ID">@d.Adi</option>
					}
				</select>
			</div>
			<div class="col-12 mb-3">
				<label class="form-label">Gün</label>
				<select class="form-select" @bind="model.Gun">
					<option value="">Gün Seçin</option>
					@foreach (var g in gunler)
					{
						<option value="@g.Deger">@g.Adi</option>
					}
				</select>
			</div>
			<div class="col-6 mb-3">
				<label class="form-label">Başlangıç Saati</label>
				<input type="time" class="form-control" @bind="baslangicSaati" @bind:format="HH:mm" />
			</div>
			<div class="col-6 mb-3">
				<label class="form-label">Bitiş Saati</label>
				<input type="time" class="form-control" @bind="bitisSaati" @bind:format="HH:mm" />
			</div>
			<div class="col-12 mb-3">
				<label class="form-label">Sınıf</label>
				<select class="form-select" @bind="model.SinifID">
					<option value="">Sınıf Seçin</option>
					@foreach (var s in siniflar)
					{
						<option value="@s.ID">@s.Adi</option>
					}
				</select>
			</div>
			<div class="col-12 mb-3">
				<div class="form-check">
					<input type="checkbox" class="form-check-input" @bind="model.Aktif" id="chkAktif" />
					<label class="form-check-label" for="chkAktif">Aktif</label>
				</div>
			</div>
			<div class="col-12 text-center">
				<button type="submit" class="btn btn-success" style="margin-right:10px;">Kaydet</button>
				<button type="button" class="btn btn-danger" @onclick="@(() => ModalService.Close(false))">İptal</button>
			</div>
		</div>
	</fieldset>
</form>

@code {
	[Parameter] public int? Id { get; set; }

	ItemDersProgrami model = new();
	List<ItemDers> dersler = new();
	List<ItemSinif> siniflar = new();
	List<GunItem> gunler = new();
	DateTime baslangicSaati;
	DateTime bitisSaati;

	public class GunItem
	{
		public DayOfWeek Deger { get; set; }
		public string Adi { get; set; } = string.Empty;
	}

	protected override async Task OnInitializedAsync()
	{
		gunler = new List<GunItem>
		{
			new GunItem { Deger = DayOfWeek.Monday, Adi = "Pazartesi" },
			new GunItem { Deger = DayOfWeek.Tuesday, Adi = "Sali" },
			new GunItem { Deger = DayOfWeek.Wednesday, Adi = "Çarsamba" },
			new GunItem { Deger = DayOfWeek.Thursday, Adi = "Persembe" },
			new GunItem { Deger = DayOfWeek.Friday, Adi = "Cuma" },
			new GunItem { Deger = DayOfWeek.Saturday, Adi = "Cumartesi" },
			new GunItem { Deger = DayOfWeek.Sunday, Adi = "Pazar" }
		};
		dersler = await DbContext.Dersler
			.Where(d => d.DelDate == null || d.DelDate == default(DateTime))
			.OrderBy(d => d.Adi)
			.ToListAsync();

		siniflar = await DbContext.Siniflar
			.Where(s => s.Aktif && (s.DelDate == null || s.DelDate == default(DateTime)))
			.OrderBy(s => s.Adi)
			.ToListAsync();
		if (Id.HasValue && Id.Value > 0)
		{
			model = await DbContext.DersProgramlari
				.FirstOrDefaultAsync(x => x.ID == Id.Value);

			if (model == null)
			{
				ToastService.Notify(ToastSeverity.Error, "Hata", "Ders programı bulunamadı.");
				ModalService.Close(false);
				return;
			}

		}
		else
		{
			model.Aktif = true;
		}
		StateHasChanged();
	}

	async Task Kaydet()
	{
		try
		{
			if (model.Ders_ID == 0)
			{
				ToastService.Notify(ToastSeverity.Warning, "Uyarı", "Lütfen bir ders seçin.");
				return;
			}

			if (model.SinifID == 0)
			{
				ToastService.Notify(ToastSeverity.Warning, "Uyarı", "Lütfen bir sınıf seçin.");
				return;
			}

			var dersVarMi = await DbContext.Dersler.AnyAsync(d => d.ID == model.Ders_ID && (d.DelDate == null || d.DelDate == default(DateTime)));
			if (!dersVarMi)
			{
				ToastService.Notify(ToastSeverity.Error, "Hata", "Seçilen ders bulunamadı veya silinmiş. Lütfen geçerli bir ders seçin.");
				return;
			}

			var sinifVarMi = await DbContext.Siniflar.AnyAsync(s => s.ID == model.SinifID && (s.DelDate == null || s.DelDate == default(DateTime)) && s.Aktif);
			if (!sinifVarMi)
			{
				ToastService.Notify(ToastSeverity.Error, "Hata", "Seçilen sınıf bulunamadı veya pasif durumda. Lütfen geçerli bir sınıf seçin.");
				return;
			}

			if (baslangicSaati >= bitisSaati)
			{
				ToastService.Notify(ToastSeverity.Warning, "Uyarı", "Başlangıç saati bitiş saatinden büyük veya eşit olamaz.");
				return;
			}
			model.BaslangicSaati = baslangicSaati.TimeOfDay;
			model.BitisSaati = bitisSaati.TimeOfDay;

			model.Sinif_ID = model.SinifID;

			int ogretmenId=await DbContext.Dersler.Where(x => x.ID == model.Ders_ID).Select(x => x.Ogretmen_ID).FirstOrDefaultAsync();

			bool cakismavar=await DbContext.DersProgramlari.AnyAsync(x => x.ID != model.ID && x.DelDate == default && x.Gun == model.Gun && x.Ders.Ogretmen_ID ==ogretmenId && model.BaslangicSaati<x.BitisSaati && model.BitisSaati>x.BaslangicSaati);

			if (cakismavar)
			{
				ToastService.Notify(ToastSeverity.Warning, "Uyarı", "Seçilen öğretmenin aynı gün ve saat aralığında başka bir dersi bulunmaktadır.");
				return;
			}
			
			if (Id.HasValue && Id.Value > 0)
			{
				model.UpdDate = DateTime.UtcNow;
				model.UpdUser = AuthStateService.CurrentUser?.ID;
				DbContext.DersProgramlari.Update(model);
			}
			else
			{
				model.CreDate = DateTime.UtcNow;
				model.CreUser = AuthStateService.CurrentUser?.ID ?? 0;
				await DbContext.DersProgramlari.AddAsync(model);
			}
			await DbContext.SaveChangesAsync();
			ToastService.Notify(ToastSeverity.Success, "Başarılı", "Ders programı kaydedildi.");
			ModalService.Close(true);
		}
		catch (Exception ex)
		{
			ToastService.Notify(ToastSeverity.Error, "Hata", $"Bir hata oluştu: {ex.Message}");
		}
	}
}
