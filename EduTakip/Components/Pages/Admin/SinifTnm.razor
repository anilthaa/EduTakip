@if (model != null)
{
	<RadzenTemplateForm Data="@model" TItem="ItemSinif" Submit="@Kaydet">
		<RadzenFieldset Text="Sınıf Bilgileri">
			<div class="mb-3">
				<RadzenLabel Text="Sınıf Adı" Component="SinifAdi" />
				<RadzenTextBox @bind-Value="model.Adi" Name="SinifAdi" Style="width:100%" />
				<RadzenRequiredValidator Component="SinifAdi" Text="Sınıf Adı zorunludur." Style="color:red" />
			</div>

			<RadzenCheckBox @bind-Value="model.Aktif" Name="Aktif" />
			<RadzenLabel Text="Aktif" Component="Aktif" Style="margin-left:10px;" />
		</RadzenFieldset>

		<div class="mt-3 text-end">
			<RadzenButton Text="Kaydet" ButtonStyle="ButtonStyle.Primary" Type="Submit" Style="margin-right:10px;" />
			<RadzenButton Text="İptal" ButtonStyle="ButtonStyle.Light" Click="@(args => DialogService.Close(false))" />
		</div>
	</RadzenTemplateForm>
}

@code {
	[Parameter] public int? SinifId { get; set; }
	ItemSinif? model;

	protected override async Task OnInitializedAsync()
	{
		try
		{
			if (SinifId.HasValue && SinifId.Value > 0)
			{
				model = await DbContext.Siniflar.FirstOrDefaultAsync(x => x.ID == SinifId.Value);

				if (model == null)
				{
					NotificationService.Notify(NotificationSeverity.Error, "Hata", "Sınıf bulunamadı.");
					DialogService.Close(false);
					return;
				}
			}
			else
			{
				model = new ItemSinif()
				{
					Adi = string.Empty,
					Aktif = true,
					ID = 0,
					CreUser = 0,
					CreDate = DateTime.UtcNow
				};
			}
			StateHasChanged();
		}
		catch (Exception ex)
		{
			NotificationService.Notify(NotificationSeverity.Error, "Hata", $"Bir hata oluştu: {ex.Message}");
			DialogService.Close(false);
		}
	}

	async Task Kaydet(ItemSinif item)
	{
		try
		{
			if (item.ID == 0)
			{
				item.CreDate = DateTime.UtcNow;
				item.CreUser = 1; // Varsayılan kullanıcı ID
				DbContext.Siniflar.Add(item);
			}
			else
			{
				item.UpdDate = DateTime.UtcNow;
				item.UpdUser = 1; // Varsayılan kullanıcı ID
				DbContext.Siniflar.Update(item);
			}
			await DbContext.SaveChangesAsync();
			NotificationService.Notify(NotificationSeverity.Success, "Başarılı", "Kayıt kaydedildi.");
			DialogService.Close(true);
		}
		catch (Exception ex)
		{
			NotificationService.Notify(NotificationSeverity.Error, "Hata", $"Kayıt kaydedilirken bir hata oluştu: {ex.Message}");
		}
	}
}

