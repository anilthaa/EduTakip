@if (model != null)
{
	<form @onsubmit="Kaydet" @onsubmit:preventDefault>
		<fieldset class="border rounded p-3">
			<legend class="w-auto px-2 fs-6">Sınıf Bilgileri</legend>
			<div class="mb-3">
				<label class="form-label">Sınıf Adı</label>
				<input type="text" class="form-control" @bind="model.Adi" required />
			</div>

			<div class="form-check">
				<input type="checkbox" class="form-check-input" @bind="model.Aktif" id="chkAktif" />
				<label class="form-check-label" for="chkAktif">Aktif</label>
			</div>
		</fieldset>

		<div class="mt-3 text-center">
			<button type="submit" class="btn btn-success" style="margin-right:10px;">Kaydet</button>
			<button type="button" class="btn btn-danger" @onclick="@(() => ModalService.Close(false))">İptal</button>
		</div>
	</form>
}

@code {
	[Parameter] public int? SinifId { get; set; }
	ItemSinif? model;

	protected override async Task OnInitializedAsync()
	{
		try
		{
			if (SinifId.HasValue && SinifId.Value > 0)
			{
				model = await DbContext.Siniflar.FirstOrDefaultAsync(x => x.ID == SinifId.Value);

				if (model == null)
				{
					ToastService.Notify(ToastSeverity.Error, "Hata", "Sınıf bulunamadı.");
					ModalService.Close(false);
					return;
				}
			}
			else
			{
				model = new ItemSinif()
				{
					Adi = string.Empty,
					Aktif = true,
					ID = 0,
					CreUser = AuthStateService.CurrentUser?.ID ?? 0,
					CreDate = DateTime.UtcNow
				};
			}
			StateHasChanged();
		}
		catch (Exception ex)
		{
			ToastService.Notify(ToastSeverity.Error, "Hata", $"Bir hata oluştu: {ex.Message}");
			ModalService.Close(false);
		}
	}

	async Task Kaydet()
	{
		try
		{
			if (model.ID == 0)
			{
				model.CreDate = DateTime.UtcNow;
				model.CreUser = AuthStateService.CurrentUser?.ID ?? 0;
				DbContext.Siniflar.Add(model);
			}
			else
			{
				model.UpdDate = DateTime.UtcNow;
				model.UpdUser = AuthStateService.CurrentUser?.ID;
				DbContext.Siniflar.Update(model);
			}
			await DbContext.SaveChangesAsync();
			ToastService.Notify(ToastSeverity.Success, "Başarılı", "Kayıt kaydedildi.");
			ModalService.Close(true);
		}
		catch (Exception ex)
		{
			ToastService.Notify(ToastSeverity.Error, "Hata", $"Kayıt kaydedilirken bir hata oluştu: {ex.Message}");
		}
	}
}
