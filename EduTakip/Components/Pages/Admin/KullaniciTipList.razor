@page "/admin/kullanici-tipleri"
@attribute [Authorize(Roles ="Admin")]

<button class="btn btn-success btn-sm" style="margin-bottom:15px; border-radius:10px;" @onclick="YeniTip">
	<span class="material-icons">add</span> Yeni Kullanici Tipi Ekle
</button>
<div class="card" style="margin:0; margin-left:0; padding:20px; width:100%; max-width:none; box-sizing:border-box">
	<div class="card-body">
		<h3 style="text-align:center;">Kullanici Tipleri</h3>
		<div class="data-table-wrapper">
			<table class="data-table">
				<thead>
					<tr>
						<th style="width:80px;">ID</th>
						<th>Adi</th>
						<th>Aktif</th>
						<th>Islemler</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var model in tipler)
					{
						<tr>
							<td>@model.ID</td>
							<td>@model.Adi</td>
							<td>
								<span class="status-badge @(model.Aktif ? "status-active" : "status-inactive")"
									  @onclick="@(() => ToggleAktif(model))">
									@(model.Aktif ? "Aktif" : "Pasif")
								</span>
							</td>
							<td>
								<button class="btn btn-primary btn-sm" @onclick="@(() => EditKullaniciTip(model))" style="margin-right: 10px;">
									<span class="material-icons">edit</span>
								</button>
								<button class="btn btn-danger btn-sm" @onclick="@(() => DeleteKullaniciTip(model))">
									<span class="material-icons">delete</span>
								</button>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
</div>

@code {
	List<ItemKullaniciTip> tipler = new();
	protected override async Task OnInitializedAsync()
	{
		await Listele();
	}

	async Task Listele()
	{
		tipler = await DbContext.KullaniciTipleri
			.Where(x => x.DelDate == null || x.DelDate == default(DateTime))
			.OrderBy(x => x.Adi)
			.ToListAsync();
	}

	async Task YeniTip()
	{
		var result = await ModalService.OpenAsync<KullaniciTipTnm>("Yeni Kullanici Tipi Ekle", new Dictionary<string, object>()
		{

		}, new ModalOptions { CssClass = "modal-md" });
		if (result is true)
		{
			await Listele();
			StateHasChanged();
		}
	}

	async Task EditKullaniciTip(ItemKullaniciTip item)
	{
		var result = await ModalService.OpenAsync<KullaniciTipTnm>("Kullanici Tip Düzenle", new Dictionary<string, object>()
		{
			{ "KullaniciTipId", item.ID }
		}, new ModalOptions { CssClass = "modal-md" });
		if (result is true)
		{
			await Listele();
			StateHasChanged();
		}
	}

	async Task ToggleAktif(ItemKullaniciTip item)
	{
		var yeniDurum = !item.Aktif;
		item.Aktif = yeniDurum;
		item.UpdDate = DateTime.UtcNow;
		item.UpdUser = AuthStateService.CurrentUser?.ID;
		DbContext.KullaniciTipleri.Update(item);
		await DbContext.SaveChangesAsync();
		await Listele();
		ToastService.Notify(ToastSeverity.Success, "Başarılı", $"Birim {(yeniDurum ? "aktif" : "pasif")} yapıldı.");
		StateHasChanged();
	}

	async Task DeleteKullaniciTip(ItemKullaniciTip item)
	{
		var result = await JSRuntime.InvokeAsync<bool>("confirm", $"'{item.Adi}' birimini silmek istediginize emin misiniz?");
		if (result)
		{
			item.DelUser = AuthStateService.CurrentUser?.ID;
			item.DelDate = DateTime.UtcNow;
			item.Aktif = false;
			DbContext.KullaniciTipleri.Update(item);
			await DbContext.SaveChangesAsync();
			await Listele();
			ToastService.Notify(ToastSeverity.Success, "Başarılı", "Birim silindi.");
			StateHasChanged();
		}
	}
}
