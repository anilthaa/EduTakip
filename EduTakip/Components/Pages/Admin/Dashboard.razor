@page "/admin/dashboard"

<h3>Admin Dashboard</h3>
<RadzenRow Gap="20px" Style="margin-top:20px">
	<RadzenColumn Size="3">
		<RadzenCard Style="border-left:4px solid green">
			<h4>Toplam Ders</h4>
			<h2>@toplamDers</h2>
		</RadzenCard>
	</RadzenColumn>

	<RadzenColumn Size="3">
		<RadzenCard Style="border-left:4px solid red">
			<h4>Toplam Öğretmen</h4>
			<h2>@toplamOgretmen</h2>
		</RadzenCard>
	</RadzenColumn>

	<RadzenColumn Size="3">
		<RadzenCard Style="border-left:4px solid yellow">
			<h4>Toplam Öğrenci</h4>
			<h2>@toplamOgrenci</h2>
		</RadzenCard>
	</RadzenColumn>

	<RadzenColumn Size="3">
		<RadzenCard>
			<h4>Bugünkü Ders</h4>
			<h2>@bugunkuDers</h2>
		</RadzenCard>
	</RadzenColumn>
</RadzenRow>

@code {
	int toplamDers;
	int toplamOgretmen;
	int toplamOgrenci;
	int bugunkuDers;

	protected override async Task OnInitializedAsync()
	{
		await Yukle();
	}

	async Task Yukle()
	{
		toplamDers = await DbContext.Dersler.CountAsync(x=>x.DelDate==null);
		toplamOgretmen = await DbContext.Ogretmenler.CountAsync(x => x.DelDate == null);
		toplamOgrenci = await DbContext.Ogrenciler.CountAsync(x => x.DelDate == null);
		var bugun = DateTime.Today.DayOfWeek;
		bugunkuDers = await DbContext.DersProgramlari
			.CountAsync(x => x.DelDate == null && x.Gun == bugun && x.Aktif);
	}
}
