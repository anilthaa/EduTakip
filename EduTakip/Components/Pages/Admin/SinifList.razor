@page "/admin/siniflar"
@attribute [Authorize(Roles = "Admin")]

<button class="btn btn-success btn-sm" style="margin-bottom:15px; border-radius:10px;" @onclick="YeniSinif"><span class="material-icons">add</span> Yeni Sınıf Ekle</button>

<div class="card" style="margin:0; margin-left:0; padding:20px; width:100%; max-width:none; box-sizing:border-box">
	<div class="card-body">
		<h3 style="text-align:center;">Sınıflar</h3>
		<div class="data-table-wrapper">
			<table class="data-table">
				<thead>
					<tr>
						<th style="width:80px">ID</th>
						<th>Sınıf Adı</th>
						<th>Aktif</th>
						<th>İşlemler</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var item in siniflar)
					{
						<tr>
							<td>@item.ID</td>
							<td>@item.Adi</td>
							<td>
								<span
									class="status-badge @(item.Aktif ? "status-active" : "status-inactive")"
									@onclick="@(() => ToggleAktif(item))">
									@(item.Aktif ? "Aktif" : "Pasif")
								</span>
							</td>
							<td>
								<button class="btn btn-sm" style="margin-right: 10px; background-color:green; color:white;" @onclick="@(() => EditSinif(item))"><span class="material-icons">edit</span></button>
								<button class="btn btn-sm" style="background-color:red; color:white;" @onclick="@(() => DeleteSinif(item))"><span class="material-icons">delete</span></button>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
</div>

@code {
	List<ItemSinif> siniflar = new();

	protected override async Task OnInitializedAsync()
	{
		await Listele();
	}

	async Task Listele()
	{
		siniflar = await DbContext.Siniflar
			.Where(x => x.DelDate == null || x.DelDate == default(DateTime))
			.OrderBy(x => x.Adi)
			.ToListAsync();
	}

	async Task YeniSinif()
	{
		var result = await ModalService.OpenAsync<SinifTnm>("Yeni Sınıf Ekle", new Dictionary<string, object>()
		{
			{ "SinifId", 0 }
		}, new ModalOptions { CssClass = "modal-md" });
		if (result is true)
		{
			await Listele();
			StateHasChanged();
		}
	}

	async Task EditSinif(ItemSinif sinif)
	{
		var result = await ModalService.OpenAsync<SinifTnm>("Sınıf Düzenle", new Dictionary<string, object>()
		{
			{ "SinifId", sinif.ID }
		}, new ModalOptions { CssClass = "modal-md" });
		if (result is true)
		{
			await Listele();
			StateHasChanged();
		}
	}

	async Task ToggleAktif(ItemSinif sinif)
	{
		var yeniDurum = !sinif.Aktif;
		sinif.Aktif = yeniDurum;
		sinif.UpdDate = DateTime.UtcNow;
		sinif.UpdUser = AuthStateService.CurrentUser?.ID;
		DbContext.Siniflar.Update(sinif);

		await DbContext.SaveChangesAsync();
		await Listele();
		ToastService.Notify(ToastSeverity.Success, "Başarılı", $"Sınıf durumu {(yeniDurum ? "aktif" : "pasif")} yapıldı.");
		StateHasChanged();
	}

	async Task DeleteSinif(ItemSinif sinif)
	{
		bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"'{sinif.Adi}' sınıfını silmek istediğinize emin misiniz?");
		if (confirmed)
		{
			try
			{
				// O sınıftaki tüm öğrencilerin Sinif_ID alanını null yap (ana sınıf olarak bu sınıfı kullananlar)
				var ogrenciler = await DbContext.Ogrenciler
					.Where(x => x.Sinif_ID == sinif.ID && (x.DelDate == null || x.DelDate == default(DateTime)))
					.ToListAsync();

				foreach (var ogrenci in ogrenciler)
				{
					ogrenci.Sinif_ID = null;
					ogrenci.UpdDate = DateTime.UtcNow;
					ogrenci.UpdUser = AuthStateService.CurrentUser?.ID ?? 0;
					DbContext.Ogrenciler.Update(ogrenci);
				}

				// SinifKullanicilar tablosundaki kayıtları soft delete yap
				var sinifKullanicilar = await DbContext.SinifKullanicilar
					.IgnoreQueryFilters()
					.Where(x => x.Sinif_ID == sinif.ID && (x.DelDate == null || x.DelDate == default(DateTime)))
					.ToListAsync();

				foreach (var sk in sinifKullanicilar)
				{
					sk.DelDate = DateTime.UtcNow;
					sk.DelUser = AuthStateService.CurrentUser?.ID ?? 0;
					DbContext.SinifKullanicilar.Update(sk);
				}

				// SinifOgrenciler tablosundaki kayıtları soft delete yap
				var sinifOgrenciler = await DbContext.SinifOgrenciler
					.IgnoreQueryFilters()
					.Where(x => x.Sinif_ID == sinif.ID && (x.DelDate == null || x.DelDate == default(DateTime)))
					.ToListAsync();

				foreach (var so in sinifOgrenciler)
				{
					so.DelDate = DateTime.UtcNow;
					so.DelUser = AuthStateService.CurrentUser?.ID ?? 0;
					DbContext.SinifOgrenciler.Update(so);
				}

				// Sınıfı soft delete yap
				sinif.DelUser = AuthStateService.CurrentUser?.ID ?? 0;
				sinif.DelDate = DateTime.UtcNow;
				sinif.Aktif = false;
				DbContext.Siniflar.Update(sinif);

				await DbContext.SaveChangesAsync();
				await Listele();
                ToastService.Notify(ToastSeverity.Success, "Başarılı", $"Sınıf silindi. {ogrenciler.Count} öğrencinin sınıf bilgisi güncellendi.");
				StateHasChanged();
			}
			catch (Exception ex)
			{
			}
		}
	}
}
