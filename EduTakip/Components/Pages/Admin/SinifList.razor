@page "/admin/siniflar"
@attribute [Authorize(Roles = "Admin")]
@inject IToastService ToastService
@inject AuthStateService AuthStateService

	
	<RadzenButton Text="Yeni Sınıf Ekle" Icon="add" Style="margin-bottom:15px; border-radius:10px;" ButtonStyle="ButtonStyle.Success" Click="@YeniSinif" />
<RadzenCard Style="margin:0; margin-left:0; padding:20px; width:100%; max-width:none; box-sizing:border-box">
	<h3 style="text-align:center;">Sınıflar</h3>
	<RadzenDataGrid TItem="ItemSinif" Data="@siniflar" AllowPaging="true" PageSize="10">
		<Columns>
			<RadzenDataGridColumn TItem="ItemSinif" Property="ID" Title="ID" Width="80px"></RadzenDataGridColumn>
			<RadzenDataGridColumn TItem="ItemSinif" Property="Adi" Title="Sınıf Adı" />
			<RadzenDataGridColumn TItem="ItemSinif" Title="Aktif">
				<Template Context="item">
					<span 
						class="status-badge @(item.Aktif ? "status-active" : "status-inactive")"
						@onclick="@(() => ToggleAktif(item))">
						@(item.Aktif ? "Aktif" : "Pasif")
					</span>
				</Template>
			</RadzenDataGridColumn>

			<RadzenDataGridColumn TItem="ItemSinif" Title="İşlemler">
				<Template Context="item">
					<RadzenButton Icon="edit"  Size="ButtonSize.Small" Click="@(() => EditSinif(item))" Style="margin-right: 10px; background-color:green;" />
					<RadzenButton Icon="delete"  Size="ButtonSize.Small" Click="@(() => DeleteSinif(item))" Style="background-color:red;" />
				</Template>
			</RadzenDataGridColumn>
		</Columns>
	</RadzenDataGrid>
</RadzenCard>

@code {
	List<ItemSinif> siniflar = new();

	protected override async Task OnInitializedAsync()
	{
		await Listele();
	}

	async Task Listele()
	{
		siniflar = await DbContext.Siniflar
			.OrderBy(x => x.Adi)
			.ToListAsync();
	}

	async Task YeniSinif()
	{
		var result = await DialogService.OpenAsync<SinifTnm>("Yeni Sınıf Ekle", new Dictionary<string, object>()
		{
			{ "SinifId", 0 }
		}, new DialogOptions() { Width = "600px"});
		if (result == true)
		{
			await Listele();
			StateHasChanged();
		}
	}

	async Task EditSinif(ItemSinif sinif)
	{
		var result = await DialogService.OpenAsync<SinifTnm>("Sınıf Düzenle", new Dictionary<string, object>()
		{
			{ "SinifId", sinif.ID }
		}, new DialogOptions() { Width = "600px"});
		if (result == true)
		{
			await Listele();
			StateHasChanged();
		}
	}

	async Task ToggleAktif(ItemSinif sinif)
	{
		var yeniDurum = !sinif.Aktif;
		sinif.Aktif = yeniDurum;
		sinif.UpdDate = DateTime.UtcNow;
		sinif.UpdUser = 0; // TODO: Gerçek kullanıcı ID'si kullanılacak
		DbContext.Siniflar.Update(sinif);

		await DbContext.SaveChangesAsync();
		await Listele();
		NotificationService.Notify(NotificationSeverity.Success,"Başarılı", $"Sınıf durumu {(yeniDurum ? "aktif" : "pasif")} yapıldı.");
		StateHasChanged();
	}

	async Task DeleteSinif(ItemSinif sinif)
	{
		bool? result = await DialogService.Confirm($"'{sinif.Adi}' sınıfını silmek istediğinize emin misiniz?", "Sınıf Silme Onayı", new ConfirmOptions() { OkButtonText = "Evet", CancelButtonText = "Hayır" });
		if (result == true)
		{
			try
			{
				// O sınıftaki tüm öğrencilerin Sinif_ID alanını null yap (ana sınıf olarak bu sınıfı kullananlar)
				var ogrenciler = await DbContext.Ogrenciler
					.Where(x => x.Sinif_ID == sinif.ID && x.DelDate == null)
					.ToListAsync();

				foreach (var ogrenci in ogrenciler)
				{
					ogrenci.Sinif_ID = null;
					ogrenci.UpdDate = DateTime.UtcNow;
					ogrenci.UpdUser = AuthStateService.CurrentUser?.ID ?? 0;
					DbContext.Ogrenciler.Update(ogrenci);
				}

				// SinifKullanicilar tablosundaki kayıtları soft delete yap
				var sinifKullanicilar = await DbContext.SinifKullanicilar
					.IgnoreQueryFilters()
					.Where(x => x.Sinif_ID == sinif.ID && x.DelDate == null)
					.ToListAsync();

				foreach (var sk in sinifKullanicilar)
				{
					sk.DelDate = DateTime.UtcNow;
					sk.DelUser = AuthStateService.CurrentUser?.ID ?? 0;
					DbContext.SinifKullanicilar.Update(sk);
				}

				// SinifOgrenciler tablosundaki kayıtları soft delete yap
				var sinifOgrenciler = await DbContext.SinifOgrenciler
					.IgnoreQueryFilters()
					.Where(x => x.Sinif_ID == sinif.ID && x.DelDate == null)
					.ToListAsync();

				foreach (var so in sinifOgrenciler)
				{
					so.DelDate = DateTime.UtcNow;
					so.DelUser = AuthStateService.CurrentUser?.ID ?? 0;
					DbContext.SinifOgrenciler.Update(so);
				}

				// Sınıfı soft delete yap
				sinif.DelUser = AuthStateService.CurrentUser?.ID ?? 0;
				sinif.DelDate = DateTime.UtcNow;
				sinif.Aktif = false; // Soft delete yapıldığında aktifliği de pasif yap
				DbContext.Siniflar.Update(sinif);

				await DbContext.SaveChangesAsync();
				await Listele();
				ToastService.ShowSuccess("Başarılı", $"Sınıf silindi. {ogrenciler.Count} öğrencinin sınıf bilgisi güncellendi.");
				StateHasChanged();
			}
			catch (Exception ex)
			{
			}
		}
	}
}

