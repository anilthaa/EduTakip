@using System.Net.Http.Headers

<div class="card">
	<div class="card-body" style="padding: 20px;">
		<h3 style="margin-bottom: 20px;">Hesap Aktifleştirme</h3>
		
		@if (kullanici != null)
		{
			<div style="margin-bottom: 20px;">
				<p><strong>Kullanıcı:</strong> @kullanici.Adi @kullanici.Soyadi</p>
				<p><strong>E-posta:</strong> @kullanici.EPosta</p>
			</div>

			<div style="display: flex; flex-direction: column; gap: 1rem;">
				<div class="form-group">
					<label class="form-label">Aktifleştirme Yöntemi</label>
					@foreach (var method in activationMethods)
					{
						<div class="form-check">
							<input class="form-check-input" type="radio" name="activationMethod"
								   id="@method.Value" value="@method.Value"
								   checked="@(selectedMethod == method.Value)"
								   @onchange="@(() => selectedMethod = method.Value)" />
							<label class="form-check-label" for="@method.Value">@method.Label</label>
						</div>
					}
				</div>

				@if (hasError)
				{
					<div class="alert alert-danger">
						<strong>Hata:</strong> @errorMessage
					</div>
				}

				@if (isProcessing)
				{
					<div style="text-align: center; padding: 10px;">
						<div class="spinner"></div>
						<p style="margin-top: 10px;">İşlem yapılıyor...</p>
					</div>
				}

				<div style="display: flex; gap: 10px; justify-content: flex-end; margin-top: 20px;">
					<button class="btn btn-outline btn-sm" @onclick="@(() => ModalService.Close(false))" disabled="@isProcessing">
						İptal
					</button>
					<button class="btn btn-primary btn-sm" @onclick="OnSubmit" disabled="@(isProcessing || selectedMethod == null)">
						Gönder
					</button>
				</div>
			</div>
		}
		else
		{
			<p>Kullanıcı bilgisi yükleniyor...</p>
		}
	</div>
</div>

@code {
	[Parameter] public ItemKullanici? Kullanici { get; set; }

	ItemKullanici? kullanici;
	string? selectedMethod;
	bool isProcessing = false;
	bool hasError = false;
	string errorMessage = string.Empty;

	class ActivationMethod
	{
		public string Value { get; set; } = string.Empty;
		public string Label { get; set; } = string.Empty;
	}

	List<ActivationMethod> activationMethods = new()
	{
		new ActivationMethod { Value = "link", Label = "Aktifleştirme Linki Gönder (Kullanıcı linke tıklayarak aktifleştirecek)" },
		new ActivationMethod { Value = "password", Label = "Geçici Şifre ile Aktifleştir (Hesap otomatik aktif olur, geçici şifre gönderilir)" }
	};

	class ApiResponse
	{
		[JsonPropertyName("success")]
		public bool Success { get; set; }
		
		[JsonPropertyName("message")]
		public string? Message { get; set; }
	}

	protected override Task OnInitializedAsync()
	{
		kullanici = Kullanici;
		return Task.CompletedTask;
	}

	private async Task OnSubmit()
	{
		if (kullanici == null || string.IsNullOrWhiteSpace(selectedMethod))
		{
			return;
		}

		isProcessing = true;
		hasError = false;
		StateHasChanged();

		try
		{
			string? token = null;
			try
			{
				token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "authToken");
			}
			catch { }

			var baseUrl = NavigationManager.BaseUri.TrimEnd('/');
			ApiResponse? result = null;

			HttpRequestMessage CreateRequest(HttpMethod method, string url, object? content = null)
			{
				var request = new HttpRequestMessage(method, url);
				if (!string.IsNullOrWhiteSpace(token))
				{
					request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
				}
				if (content != null)
				{
					request.Content = JsonContent.Create(content);
				}
				return request;
			}

			if (selectedMethod == "link")
			{
				var request = CreateRequest(HttpMethod.Post, $"{baseUrl}/api/auth/send-activation-link", new { Email = kullanici.EPosta });
				var response = await Http.SendAsync(request);
				
				if (response.IsSuccessStatusCode)
				{
					try
					{
						result = await response.Content.ReadFromJsonAsync<ApiResponse>();
					}
					catch (System.Text.Json.JsonException)
					{
						result = new ApiResponse { Success = true, Message = "İşlem başarıyla tamamlandı." };
					}
				}
				else
				{
					try
					{
						result = await response.Content.ReadFromJsonAsync<ApiResponse>();
						hasError = true;
					}
					catch (System.Text.Json.JsonException)
					{
						result = new ApiResponse { Success = false, Message = $"Sunucu hatası: {response.StatusCode}. Lütfen giriş yaptığınızdan emin olun." };
						hasError = true;
					}
				}
			}
			else if (selectedMethod == "password")
			{
				var request = CreateRequest(HttpMethod.Post, $"{baseUrl}/api/auth/activate-account-with-password", new { Email = kullanici.EPosta });
				var response = await Http.SendAsync(request);
				
				if (response.IsSuccessStatusCode)
				{
					try
					{
						result = await response.Content.ReadFromJsonAsync<ApiResponse>();
					}
					catch (System.Text.Json.JsonException)
					{
						result = new ApiResponse { Success = true, Message = "İşlem başarıyla tamamlandı." };
					}
				}
				else
				{
					try
					{
						result = await response.Content.ReadFromJsonAsync<ApiResponse>();
						hasError = true;
					}
					catch (System.Text.Json.JsonException)
					{
						result = new ApiResponse { Success = false, Message = $"Sunucu hatası: {response.StatusCode}. Lütfen giriş yaptığınızdan emin olun." };
						hasError = true;
					}
				}
			}

			if (result != null)
			{
				if (result.Success)
				{
					ToastService.Notify(ToastSeverity.Success, "Başarılı", result.Message ?? "İşlem başarıyla tamamlandı.");
					ModalService.Close(true);
				}
				else
				{
					hasError = true;
					errorMessage = result.Message ?? "İşlem sırasında bir hata oluştu.";
				}
			}
			else
			{
				hasError = true;
				errorMessage = "Sunucudan yanıt alınamadı.";
			}
		}
		catch (Exception ex)
		{
			hasError = true;
			errorMessage = $"Bir hata oluştu: {ex.Message}";
		}
		finally
		{
			isProcessing = false;
			StateHasChanged();
		}
	}
}
