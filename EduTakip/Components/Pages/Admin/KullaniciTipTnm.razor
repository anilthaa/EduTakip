@if (model != null)
{
	<RadzenTemplateForm Data="@model" TItem="ItemKullaniciTip" Submit="@Kaydet">
		<RadzenFieldset Text="Kullanıcı Tip Bilgileri">
			<div class="mb-3">
				<RadzenLabel Text="Kullanıcı Tip Adı" Component="Adi" />
				<RadzenTextBox @bind-Value="model.Adi" Name="Adi" Style="width:100%" />
				<RadzenRequiredValidator Component="Adi" Text="Kullanıcı Tip Adı zorunludur." Style="color:red" />
			</div>

			<div style="display:flex; align-items:center; margin-bottom:15px; margin-top:10px">
				<RadzenCheckBox @bind-Value="model.Aktif" Name="Aktif"></RadzenCheckBox>
				<RadzenLabel Text="Aktif" Component="Aktif" Style="margin-left:10px;" />
			</div>
		</RadzenFieldset>

		<div class="mt-3 text-center">
			<RadzenButton Text="Kaydet" ButtonType="ButtonType.Submit" Style="margin-right:10px; background-color:green;" />
			<RadzenButton Text="İptal" Style="background-color:red;" Click="@(args => DialogService.Close(false))" />
		</div>
	</RadzenTemplateForm>
}

@code {
	[Parameter] public int? KullaniciTipId { get; set; }
	ItemKullaniciTip? model;
	
	protected override async Task OnInitializedAsync()
	{
		try
		{
			if (KullaniciTipId.HasValue && KullaniciTipId.Value > 0)
			{
				model = await DbContext.KullaniciTipleri
					.FirstOrDefaultAsync(k => k.ID == KullaniciTipId.Value);
				if (model == null)
				{
					NotificationService.Notify(NotificationSeverity.Error, "Hata", "Kullanıcı Tipi bulunamadı veya silinmiş.");
					DialogService.Close(false);
					return;
				}
			}
			else
			{
				model = new ItemKullaniciTip()
				{
					Adi = string.Empty,
					Aktif = true,
					ID = 0,
					CreUser = 0,
					CreDate = DateTime.UtcNow
				};
			}
			StateHasChanged();
		}
		catch (Exception ex)
		{
			NotificationService.Notify(NotificationSeverity.Error, "Hata", $"Bir hata oluştu: {ex.Message}");
			DialogService.Close(false);
		}
	}

	async Task Kaydet(ItemKullaniciTip item)
	{
		try
		{
			if (item.ID == 0)
			{
				item.CreDate = DateTime.UtcNow;
				item.CreUser = 1; // TODO: Gerçek kullanıcı ID'si kullanılacak
				DbContext.KullaniciTipleri.Add(item);
			}
			else
			{
				item.UpdDate = DateTime.UtcNow;
				item.UpdUser = 1; // TODO: Gerçek kullanıcı ID'si kullanılacak
				DbContext.KullaniciTipleri.Update(item);
			}
			await DbContext.SaveChangesAsync();
			NotificationService.Notify(NotificationSeverity.Success, "Başarılı", "Kayıt kaydedildi.");
			DialogService.Close(true);
		}
		catch (Exception ex)
		{
			NotificationService.Notify(NotificationSeverity.Error, "Hata", $"Kayıt kaydedilirken bir hata oluştu: {ex.Message}");
		}
	}
}
