<form @onsubmit="Kaydet" @onsubmit:preventDefault>
	<fieldset class="border rounded p-3">
		<legend class="w-auto px-2 fs-6">Ders Bilgileri</legend>
		<div class="mb-3">
			<label class="form-label">Ders Adı</label>
			<input type="text" class="form-control" @bind="model.Adi" required />
		</div>
		<div class="mb-3">
			<label class="form-label">Açıklama</label>
			<textarea class="form-control" @bind="model.Aciklama"></textarea>
		</div>
		<div class="mb-3">
			<label class="form-label">Öğretmen</label>
			<select class="form-select" @bind="model.Ogretmen_ID" required>
				<option value="">Öğretmen Seçin</option>
				@foreach (var o in ogretmenler)
				{
					<option value="@o.ID">@o.Kullanici?.Adi</option>
				}
			</select>
		</div>
	</fieldset>

	<div class="mt-3 text-center">
		<button type="submit" class="btn btn-success" style="margin-right:10px;">Kaydet</button>
		<button type="button" class="btn btn-danger" @onclick="@(() => ModalService.Close(false))">İptal</button>
	</div>
</form>

@code {
	[Parameter] public int? DersId { get; set; }
	ItemDers? model=new();
	List<ItemOgretmen> ogretmenler = new();

	protected override async Task OnInitializedAsync()
	{
		try
		{
			ogretmenler = await DbContext.Ogretmenler
				.Include(o => o.Kullanici)
				.Where(o => (o.DelDate == null || o.DelDate == default(DateTime)) 
					&& (o.Kullanici.DelDate == null || o.Kullanici.DelDate == default(DateTime)) 
					&& o.Kullanici.Aktif)
				.OrderBy(o => o.Kullanici.Adi)
				.ToListAsync();
			if (DersId.HasValue && DersId.Value > 0)
			{
				model = await DbContext.Dersler
					.FirstOrDefaultAsync(x => x.ID == DersId.Value);
				if (model == null)
				{
					ToastService.Notify(ToastSeverity.Error, "Hata", "Ders bulunamadı veya silinmiş.");
					ModalService.Close(false);
					return;
				}
			}
			else
			{
				model = new ItemDers();
			}
			StateHasChanged();
		}
		catch (Exception ex)
		{
			ToastService.Notify(ToastSeverity.Error, "Hata", $"Bir hata oluştu: {ex.Message}");
			ModalService.Close(false);
		}
	}

	async Task Kaydet()
	{
		try
		{
			if (model != null)
			{
				if (model.ID == 0)
				{
					model.CreDate = DateTime.UtcNow;
					model.CreUser = AuthStateService.CurrentUser?.ID ?? 0;
					DbContext.Dersler.Add(model);
				}
				else
				{
					model.UpdDate = DateTime.UtcNow;
					model.UpdUser = AuthStateService.CurrentUser?.ID;
					DbContext.Dersler.Update(model);
				}
				await DbContext.SaveChangesAsync();
				ToastService.Notify(ToastSeverity.Success, "Başarılı", "Ders başarıyla kaydedildi.");
				ModalService.Close(true);
			}
		}
		catch (Exception ex)
		{
			ToastService.Notify(ToastSeverity.Error, "Hata", $"Bir hata oluştu: {ex.Message}");
		}
	}
}
