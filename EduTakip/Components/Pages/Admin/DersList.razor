@page "/admin/dersler"
@attribute [Authorize(Roles = "Admin")]

<button class="btn btn-success btn-sm" style="margin-bottom:15px; border-radius:10px;" @onclick="YeniDers"><span class="material-icons">add</span> Yeni Ders Ekle</button>

<div class="card" style="margin:0; margin-left:0; padding:20px; width:100%; max-width:none; box-sizing:border-box">
	<div class="card-body">
		<h3 style="text-align:center;">Dersler</h3>
		@if (dersler == null || !dersler.Any())
		{
			<p>Henüz ders eklenmemis.</p>
		}
		else
		{
			<div class="data-table-wrapper">
				<table class="data-table">
					<thead>
						<tr>
							<th style="width:80px">ID</th>
							<th>Ders Adi</th>
							<th>Açiklama</th>
							<th>Ögretmen</th>
							<th>Islemler</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var item in dersler)
						{
							<tr>
								<td>@item.ID</td>
								<td>@item.Adi</td>
								<td>@item.Aciklama</td>
								<td>@item.Ogretmen?.Kullanici?.Adi @item.Ogretmen?.Kullanici?.Soyadi</td>
								<td>
									<button class="btn btn-primary btn-sm" style="margin-right: 10px;" @onclick="@(() => EditDers(item))"><span class="material-icons">edit</span></button>
									<button class="btn btn-danger btn-sm" @onclick="@(() => DeleteBirim(item))"><span class="material-icons">delete</span></button>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
</div>

@code {
	List<ItemDers> dersler = new();

	protected override async Task OnInitializedAsync()
	{
		await Listele();
	}

	async Task Listele()
	{
		dersler = await DbContext.Dersler
			.Include(d => d.Ogretmen)
			.ThenInclude(o => o.Kullanici)
			.Where(d => d.DelDate == null || d.DelDate == default(DateTime))
			.OrderBy(x => x.Adi)
			.ToListAsync();
	}

	async Task YeniDers()
	{
		var result = await ModalService.OpenAsync<DersTnm>("Yeni Ders", new Dictionary<string, object>(),
			new ModalOptions { CssClass = "modal-md" });
		if (result is true)
			await Listele();
	}

	async Task EditDers(ItemDers ders)
	{
		var result = await ModalService.OpenAsync<DersTnm>("Ders Düzenle", new Dictionary<string, object>()
		{
			{ "DersId", ders.ID }
		}, new ModalOptions { CssClass = "modal-md" });
		if (result is true)
			await Listele();
	}

	async Task DeleteBirim(ItemDers item)
	{
		bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"'{item.Adi}' birimini silmek istediginize emin misiniz?");
		if (confirmed)
		{
			item.DelUser = 0;
			item.DelDate = DateTime.UtcNow;
			DbContext.Dersler.Update(item);
			ToastService.Notify(ToastSeverity.Success, "Ba?ar?l?", "Birim ba?ar?yla silindi.");
			await DbContext.SaveChangesAsync();
			await Listele();
			StateHasChanged();
		}
	}
}
