@page "/admin/bekleyen-hesaplar"
@attribute [Authorize(Roles = "Admin")]

<div class="card" style="margin:0; margin-left:0; padding:20px; width:100%; max-width:none; box-sizing:border-box">
	<div class="card-body">
		<h3 style="text-align:center;">Onay Bekleyen Hesaplar</h3>
		<div class="data-table-wrapper">
			<table class="data-table">
				<thead>
					<tr>
						<th>Ad</th>
						<th>Soyad</th>
						<th>E-Posta</th>
						<th>Kullanıcı Tipi</th>
						<th>Kayıt Tarihi</th>
						<th>İşlemler</th>
					</tr>
				</thead>
				<tbody>
					@if (bekleyenHesaplar.Any())
					{
						@foreach (var item in bekleyenHesaplar)
						{
							<tr>
								<td>@item.Adi</td>
								<td>@item.Soyadi</td>
								<td>@item.EPosta</td>
								<td>@(item.KullaniciTip?.Adi ?? "")</td>
								<td>@item.CreDate.ToString("dd.MM.yyyy HH:mm")</td>
								<td>
									<div style="display: flex; gap: 8px;">
										<button class="btn btn-success btn-sm" @onclick="@(() => OnaylaHesap(item))">
											<span class="material-icons">check</span>
										</button>
										<button class="btn btn-danger btn-sm" @onclick="@(() => ReddetHesap(item))">
											<span class="material-icons">close</span>
										</button>
									</div>
								</td>
							</tr>
						}
					}
					else
					{
						<tr>
							<td colspan="6" style="text-align: center; padding: 20px;">
								<p>Onay bekleyen hesap bulunmamaktadır.</p>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
</div>

@code {
	List<ItemKullanici> bekleyenHesaplar = new();

	protected override async Task OnInitializedAsync()
	{
		await Listele();
	}

	async Task Listele()
	{
		try
		{
			bekleyenHesaplar = await DbContext.Kullanicilar
				.Include(k => k.KullaniciTip)
				.Where(k => (k.DelDate == null || k.DelDate == default(DateTime))
					&& k.EmailConfirmed 
					&& !k.Aktif
					&& !k.Reddedildi)
				.OrderBy(k => k.CreDate)
				.ToListAsync();
		}
		catch (Exception ex)
		{
			ToastService.Notify(ToastSeverity.Error, "Hata", $"Bir hata oluştu: {ex.Message}");
		}
	}

	async Task OnaylaHesap(ItemKullanici kullanici)
	{
		var result = await JSRuntime.InvokeAsync<bool>("confirm", "Bu hesabı onaylamak istediğinize emin misiniz?");
		
		if (result)
		{
			try
			{
				if (!kullanici.EmailConfirmed)
				{
					ToastService.Notify(ToastSeverity.Warning, "Uyarı", "Kullanıcının önce e-postasını onaylaması gerekmektedir.");
					return;
				}

				if (kullanici.Aktif)
				{
					ToastService.Notify(ToastSeverity.Info, "Bilgi", "Hesap zaten aktif.");
					await Listele();
					return;
				}

				kullanici.Aktif = true;
				kullanici.UpdDate = DateTime.UtcNow;
				kullanici.UpdUser = AuthStateService.CurrentUser?.ID ?? 0;
				
				DbContext.Kullanicilar.Update(kullanici);
				await DbContext.SaveChangesAsync();

				ToastService.Notify(ToastSeverity.Success, "Başarılı", "Hesap başarıyla onaylandı.");
				await Listele();
			}
			catch (Exception ex)
			{
				ToastService.Notify(ToastSeverity.Error, "Hata", $"Bir hata oluştu: {ex.Message}");
			}
		}
	}

	async Task ReddetHesap(ItemKullanici kullanici)
	{
		var result = await JSRuntime.InvokeAsync<bool>("confirm", "Bu hesabı reddetmek istediğinize emin misiniz? Reddedilen kullanıcı giriş yapamayacaktır.");
		
		if (result)
		{
			try
			{
				kullanici.Reddedildi = true;
				kullanici.UpdDate = DateTime.UtcNow;
				kullanici.UpdUser = AuthStateService.CurrentUser?.ID ?? 0;
				
				DbContext.Kullanicilar.Update(kullanici);
				await DbContext.SaveChangesAsync();

				ToastService.Notify(ToastSeverity.Success, "Başarılı", "Hesap başarıyla reddedildi.");
				await Listele();
			}
			catch (Exception ex)
			{
				ToastService.Notify(ToastSeverity.Error, "Hata", $"Bir hata oluştu: {ex.Message}");
			}
		}
	}
}
