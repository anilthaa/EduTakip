@page "/admin/kullanicilar"

@attribute [Authorize(Roles = "Admin")]

<button class="btn btn-success btn-sm" style="margin-bottom:15px; border-radius:10px" @onclick="yeniKullanici"><span class="material-icons">add</span> Yeni Kullanici Ekle</button>

<div class="card" style="margin:0; margin-left:0; padding:20px; width:100%; max-width:none; box-sizing:border-box">
	<div class="card-body">
		<h3 style="text-align:center;">Kullanici Listesi</h3>
		<div class="data-table-wrapper">
			<table class="data-table">
				<thead>
					<tr>
						<th>Ad</th>
						<th>Soyad</th>
						<th>E-Posta</th>
						<th>Tip</th>
						<th>Durum</th>
						<th>Islemler</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var item in kullanicilar)
					{
						var durum = GetDurum(item);
						var durumRenk = GetDurumRenk(item);
						<tr>
							<td>@item.Adi</td>
							<td>@item.Soyadi</td>
							<td>@item.EPosta</td>
							<td>@(item.KullaniciTip?.Adi ?? "")</td>
							<td>
								<span class="badge" style="background:@durumRenk">@durum</span>
							</td>
							<td>
								<div style="display: flex; gap: 8px; flex-wrap: wrap;">
									<button class="btn btn-primary btn-sm" @onclick="@(() => duzenleKullanici(item))"><span class="material-icons">edit</span></button>
									@if (!item.Aktif)
									{
										<button class="btn btn-success btn-sm" @onclick="@(() => HesapAktiflestir(item))"><span class="material-icons">check_circle</span></button>
									}
									@if (item.Aktif && item.EmailConfirmed)
									{
										<button class="btn btn-warning btn-sm" @onclick="@(() => OnayiGeriAl(item))"><span class="material-icons">undo</span></button>
									}
									@if (item.Reddedildi)
									{
										<button class="btn btn-info btn-sm" @onclick="@(() => ReddiGeriAl(item))"><span class="material-icons">undo</span></button>
									}
									<button class="btn btn-danger btn-sm" @onclick="@(() => silKullanici(item))"><span class="material-icons">delete</span></button>
								</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
</div>
@code {
	List<ItemKullanici> kullanicilar = new();

	protected override async Task OnInitializedAsync()
	{
		await Listele();
	}

	async Task Listele()
	{
		kullanicilar = await DbContext.Kullanicilar
			.Include(k => k.KullaniciTip)
			.Where(k => k.DelDate==null)
			.ToListAsync();
	}
	async Task yeniKullanici()
	{
		var result = await ModalService.OpenAsync<KullaniciTnm>("Yeni Kullanici",
			new Dictionary<string, object>(),
			new ModalOptions { CssClass = "modal-md" });

		if (result is true)
		{
			await Listele();
		}
	}

	async Task duzenleKullanici(ItemKullanici kullanici)
	{
		var result = await ModalService.OpenAsync<KullaniciTnm>("Kullanici Düzenle",
			new Dictionary<string, object>() { { "KullaniciId", kullanici.ID } },
			new ModalOptions { CssClass = "modal-md" });
		if (result is true)
		{
			await Listele();
		}
	}

	async Task silKullanici(ItemKullanici kullanici)
	{
		bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Kullaniciyi silmek istediginize emin misiniz?");
		if (confirmed)
		{
			try
			{
				// Kullaniciyi soft delete yap
				kullanici.DelDate = DateTime.UtcNow;
				kullanici.DelUser = AuthStateService.CurrentUser?.ID ?? 1;
				DbContext.Kullanicilar.Update(kullanici);

				// Ögrenci ise, ilgili tablolardaki kayitlari da soft delete yap
				var kullaniciTip = kullanici.KullaniciTip?.Adi?.ToLower() ?? "";
				if (kullaniciTip.Contains("ögrenci") || kullaniciTip.Contains("ogrenci") || kullaniciTip.Contains("student"))
				{
					// Ögrenci ID'sini bul
					var ogrenci = await DbContext.Ogrenciler
						.IgnoreQueryFilters()
						.Where(x => x.Kullanici_ID == kullanici.ID && (x.DelDate == null || x.DelDate == default(DateTime)))
						.FirstOrDefaultAsync();

					if (ogrenci != null)
					{
						// ItemOgrenci'yi soft delete yap
						ogrenci.DelDate = DateTime.UtcNow;
						ogrenci.DelUser = AuthStateService.CurrentUser?.ID ?? 1;
						DbContext.Ogrenciler.Update(ogrenci);

						// SinifKullanicilar tablosundaki kayitlari soft delete yap
						var sinifKullanicilar = await DbContext.SinifKullanicilar
							.IgnoreQueryFilters()
							.Where(x => x.Kullanici_ID == kullanici.ID && (x.DelDate == null || x.DelDate == default(DateTime)))
							.ToListAsync();

						foreach (var sk in sinifKullanicilar)
						{
							sk.DelDate = DateTime.UtcNow;
							sk.DelUser = AuthStateService.CurrentUser?.ID ?? 1;
							DbContext.SinifKullanicilar.Update(sk);
						}

						// SinifOgrenciler tablosundaki kayitlari soft delete yap
						var sinifOgrenciler = await DbContext.SinifOgrenciler
							.IgnoreQueryFilters()
							.Where(x => x.Ogrenci_ID == ogrenci.ID && (x.DelDate == null || x.DelDate == default(DateTime)))
							.ToListAsync();

						foreach (var so in sinifOgrenciler)
						{
							so.DelDate = DateTime.UtcNow;
							so.DelUser = AuthStateService.CurrentUser?.ID ?? 1;
							DbContext.SinifOgrenciler.Update(so);
						}

						// DersKatilimcilar tablosundaki kayitlari soft delete yap (Ogrenci_ID aslinda Kullanici_ID)
						var dersKatilimcilar = await DbContext.DersKatilimcilar
							.IgnoreQueryFilters()
							.Where(x => x.Ogrenci_ID == kullanici.ID && (x.DelDate == null || x.DelDate == default(DateTime)))
							.ToListAsync();

						foreach (var dk in dersKatilimcilar)
						{
							dk.DelDate = DateTime.UtcNow;
							dk.DelUser = AuthStateService.CurrentUser?.ID ?? 1;
							DbContext.DersKatilimcilar.Update(dk);
						}
					}
				}

				await DbContext.SaveChangesAsync();
				ToastService.Notify(ToastSeverity.Success, "Başarılı", "Kullanıcı ve ilgili kayıtlar başarıyla silindi.");
				await Listele();
			}
			catch (Exception ex)
			{
				ToastService.Notify(ToastSeverity.Error, "Hata", $"Kullanıcı silinirken bir hata oluştu: {ex.Message}");
			}
		}
	}

	string GetDurum(ItemKullanici kullanici)
	{
		if (!kullanici.EmailConfirmed)
		{
			return "E-posta Onaylanmamış";
		}
		if (kullanici.Reddedildi)
		{
			return "Reddedilmiş";
		}
		if (kullanici.Aktif)
		{
			return "Onaylanmış";
		}
		return "Bekleyen";
	}

	string GetDurumRenk(ItemKullanici kullanici)
	{
		if (!kullanici.EmailConfirmed)
		{
			return "gray";
		}
		if (kullanici.Reddedildi)
		{
			return "red";
		}
		if (kullanici.Aktif)
		{
			return "green";
		}
		return "orange";
	}

	async Task OnayiGeriAl(ItemKullanici kullanici)
	{
		bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Bu hesabın onayını geri almak istediğinize emin misiniz? Kullanıcı tekrar bekleyen duruma dönecek ve giriş yapamayacaktır.");
		
		if (confirmed)
		{
			try
			{
				// Hesap zaten aktif değilse
				if (!kullanici.Aktif)
				{
					ToastService.Notify(ToastSeverity.Info, "Bilgi", "Hesap zaten aktif değil.");
					await Listele();
					return;
				}

				// Onayı geri al
				kullanici.Aktif = false;
				kullanici.UpdDate = DateTime.UtcNow;
				kullanici.UpdUser = AuthStateService.CurrentUser?.ID ?? 0;
				
				DbContext.Kullanicilar.Update(kullanici);
				await DbContext.SaveChangesAsync();

				ToastService.Notify(ToastSeverity.Success, "Başarılı", "Hesap onayı başarıyla geri alındı. Kullanıcı tekrar bekleyen duruma döndü.");
				await Listele();
			}
			catch (Exception ex)
			{
				ToastService.Notify(ToastSeverity.Error, "Hata", $"Bir hata oluştu: {ex.Message}");
			}
		}
	}

	async Task ReddiGeriAl(ItemKullanici kullanici)
	{
		bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Bu hesabın reddini geri almak istediğinize emin misiniz? Kullanıcı tekrar bekleyen duruma dönecek ve onay bekleyecektir.");
		
		if (confirmed)
		{
			try
			{
				// Hesap zaten reddedilmemişse
				if (!kullanici.Reddedildi)
				{
					ToastService.Notify(ToastSeverity.Info, "Bilgi", "Hesap zaten reddedilmemiş.");
					await Listele();
					return;
				}

				// Reddi geri al
				kullanici.Reddedildi = false;
				kullanici.Aktif = false; // Bekleyen duruma döndürmek için Aktif'i false yap
				kullanici.UpdDate = DateTime.UtcNow;
				kullanici.UpdUser = AuthStateService.CurrentUser?.ID ?? 0;
				
				DbContext.Kullanicilar.Update(kullanici);
				await DbContext.SaveChangesAsync();

				ToastService.Notify(ToastSeverity.Success, "Başarılı", "Hesap reddi başarıyla geri alındı. Kullanıcı tekrar bekleyen duruma döndü.");
				await Listele();
			}
			catch (Exception ex)
			{
				ToastService.Notify(ToastSeverity.Error, "Hata", $"Bir hata oluştu: {ex.Message}");
			}
		}
	}

	async Task HesapAktiflestir(ItemKullanici kullanici)
	{
		var result = await ModalService.OpenAsync<AccountActivationDialog>("Hesap Aktifleştirme",
			new Dictionary<string, object>() { { "Kullanici", kullanici } },
			new ModalOptions { CssClass = "modal-md" });
		
		if (result is true)
		{
			await Listele();
		}
	}
}
