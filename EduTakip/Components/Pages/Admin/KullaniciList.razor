@page "/admin/kullanicilar"
@using System.Threading.Tasks
@attribute [Authorize(Roles = "Admin")]
@inject AuthStateService AuthStateService
@inject NotificationService NotificationService


<RadzenButton Text="Yeni Kullanıcı Ekle" Icon="add" ButtonStyle="ButtonStyle.Success" Click="@yeniKullanici" Style="margin-bottom:15px; border-radius:10px"></RadzenButton>

<RadzenCard Style="margin:0; margin-left:0; padding:20px; width:100%; max-width:none; box-sizing:border-box">
	<h3 style="text-align:center;">Kullanıcı Listesi</h3>
	<RadzenDataGrid Data="@kullanicilar" TItem="ItemKullanici" AllowPaging="true" PageSize="10">
		<Columns>
			<RadzenDataGridColumn Property="Adi" Title="Ad"></RadzenDataGridColumn>
			<RadzenDataGridColumn Property="Soyadi" Title="Soyad"></RadzenDataGridColumn>
			<RadzenDataGridColumn Property="EPosta" Title="E-Posta"></RadzenDataGridColumn>
			<RadzenDataGridColumn Title="Tip">
				<Template Context="item">
					@(item.KullaniciTip?.Adi ?? "")
				</Template>
			</RadzenDataGridColumn>
			<RadzenDataGridColumn Title="Durum">
				<Template Context="item">
					<RadzenBadge Text="@(item.Aktif ? "Aktif" : "Pasif")" Style="@(item.Aktif ? "background:green" : "background:red")"></RadzenBadge>
				</Template>
			</RadzenDataGridColumn>

			<RadzenDataGridColumn Title="İşlemler">
				<Template Context="item">
					<RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@(() => duzenleKullanici(item))"></RadzenButton>
					<RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@(() => silKullanici(item))"></RadzenButton>
				</Template>
			</RadzenDataGridColumn>
		</Columns>
	</RadzenDataGrid>
</RadzenCard>
@code {
	List<ItemKullanici> kullanicilar = new();

	protected override async Task OnInitializedAsync()
	{
		await Listele();
	}

	async Task Listele()
	{
		kullanicilar = await DbContext.Kullanicilar
			.Include(k => k.KullaniciTip)
			.Where(k => k.DelDate==null)
			.ToListAsync();
	}
	async Task yeniKullanici()
	{
		var result=await DialogService.OpenAsync<KullaniciTnm>("Yeni Kullanıcı",
			new Dictionary<string, object>(),
			new DialogOptions() { Width = "600px", Height = "400px" });

		if (result == true)
		{
			await Listele();
		}
	}

	async Task duzenleKullanici(ItemKullanici kullanici)
	{
		var result = await DialogService.OpenAsync<KullaniciTnm>("Kullanıcı Düzenle",
			new Dictionary<string, object>() { { "KullaniciId", kullanici.ID } },
			new DialogOptions() { Width = "600px", Height = "400px" });
		if (result == true)
		{
			await Listele();
		}
	}

	async Task silKullanici(ItemKullanici kullanici)
	{
		bool? result = await DialogService.Confirm("Kullanıcıyı silmek istediğinize emin misiniz?", "Onay",
			new ConfirmOptions() { OkButtonText = "Evet", CancelButtonText = "Hayır" });
		if (result == true)
		{
			try
			{
				// Kullanıcıyı soft delete yap
				kullanici.DelDate = DateTime.UtcNow;
				kullanici.DelUser = AuthStateService.CurrentUser?.ID ?? 1;
				DbContext.Kullanicilar.Update(kullanici);

				// Öğrenci ise, ilgili tablolardaki kayıtları da soft delete yap
				var kullaniciTip = kullanici.KullaniciTip?.Adi?.ToLower() ?? "";
				if (kullaniciTip.Contains("öğrenci") || kullaniciTip.Contains("ogrenci") || kullaniciTip.Contains("student"))
				{
					// Öğrenci ID'sini bul
					var ogrenci = await DbContext.Ogrenciler
						.IgnoreQueryFilters()
						.Where(x => x.Kullanici_ID == kullanici.ID && x.DelDate == null)
						.FirstOrDefaultAsync();

					if (ogrenci != null)
					{
						// ItemOgrenci'yi soft delete yap
						ogrenci.DelDate = DateTime.UtcNow;
						ogrenci.DelUser = AuthStateService.CurrentUser?.ID ?? 1;
						DbContext.Ogrenciler.Update(ogrenci);

						// SinifKullanicilar tablosundaki kayıtları soft delete yap
						var sinifKullanicilar = await DbContext.SinifKullanicilar
							.IgnoreQueryFilters()
							.Where(x => x.Kullanici_ID == kullanici.ID && x.DelDate == null)
							.ToListAsync();

						foreach (var sk in sinifKullanicilar)
						{
							sk.DelDate = DateTime.UtcNow;
							sk.DelUser = AuthStateService.CurrentUser?.ID ?? 1;
							DbContext.SinifKullanicilar.Update(sk);
						}

						// SinifOgrenciler tablosundaki kayıtları soft delete yap
						var sinifOgrenciler = await DbContext.SinifOgrenciler
							.IgnoreQueryFilters()
							.Where(x => x.Ogrenci_ID == ogrenci.ID && x.DelDate == null)
							.ToListAsync();

						foreach (var so in sinifOgrenciler)
						{
							so.DelDate = DateTime.UtcNow;
							so.DelUser = AuthStateService.CurrentUser?.ID ?? 1;
							DbContext.SinifOgrenciler.Update(so);
						}

						// DersKatilimcilar tablosundaki kayıtları soft delete yap (Ogrenci_ID aslında Kullanici_ID)
						var dersKatilimcilar = await DbContext.DersKatilimcilar
							.IgnoreQueryFilters()
							.Where(x => x.Ogrenci_ID == kullanici.ID && x.DelDate == null)
							.ToListAsync();

						foreach (var dk in dersKatilimcilar)
						{
							dk.DelDate = DateTime.UtcNow;
							dk.DelUser = AuthStateService.CurrentUser?.ID ?? 1;
							DbContext.DersKatilimcilar.Update(dk);
						}
					}
				}

				await DbContext.SaveChangesAsync();
				NotificationService.Notify(NotificationSeverity.Success, "Başarılı", "Kullanıcı ve ilgili kayıtlar başarıyla silindi.");
				await Listele();
			}
			catch (Exception ex)
			{
				NotificationService.Notify(NotificationSeverity.Error, "Hata", $"Kullanıcı silinirken bir hata oluştu: {ex.Message}");
			}
		}
	}
}
