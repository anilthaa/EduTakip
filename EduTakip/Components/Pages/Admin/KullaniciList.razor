@page "/admin/kullanicilar"
@using System.Threading.Tasks
@using System.Net.Http.Json
@attribute [Authorize(Roles = "Admin")]
@inject AuthStateService AuthStateService
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject HttpClient Http
@inject NavigationManager NavigationManager


<RadzenButton Text="Yeni Kullanici Ekle" Icon="add" ButtonStyle="ButtonStyle.Success" Click="@yeniKullanici" Style="margin-bottom:15px; border-radius:10px"></RadzenButton>

<RadzenCard Style="margin:0; margin-left:0; padding:20px; width:100%; max-width:none; box-sizing:border-box">
	<h3 style="text-align:center;">Kullanici Listesi</h3>
	<RadzenDataGrid Data="@kullanicilar" TItem="ItemKullanici" AllowPaging="true" PageSize="10">
		<Columns>
			<RadzenDataGridColumn Property="Adi" Title="Ad"></RadzenDataGridColumn>
			<RadzenDataGridColumn Property="Soyadi" Title="Soyad"></RadzenDataGridColumn>
			<RadzenDataGridColumn Property="EPosta" Title="E-Posta"></RadzenDataGridColumn>
			<RadzenDataGridColumn Title="Tip">
				<Template Context="item">
					@(item.KullaniciTip?.Adi ?? "")
				</Template>
			</RadzenDataGridColumn>
			<RadzenDataGridColumn Title="Durum">
				<Template Context="item">
					@{
						var durum = GetDurum(item);
						var durumRenk = GetDurumRenk(item);
					}
					<RadzenBadge Text="@durum" Style="@($"background:{durumRenk}")"></RadzenBadge>
				</Template>
			</RadzenDataGridColumn>

			<RadzenDataGridColumn Title="Islemler">
				<Template Context="item">
					<div style="display: flex; gap: 8px; flex-wrap: wrap;">
						<RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@(() => duzenleKullanici(item))"></RadzenButton>
						@if (!item.Aktif)
						{
							<RadzenButton Icon="check_circle" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small" Click="@(() => HesapAktiflestir(item))"></RadzenButton>
						}
						@if (item.Aktif && item.EmailConfirmed)
						{
							<RadzenButton Icon="undo" ButtonStyle="ButtonStyle.Warning" Size="ButtonSize.Small" Click="@(() => OnayiGeriAl(item))"></RadzenButton>
						}
						@if (item.Reddedildi)
						{
							<RadzenButton Icon="undo" ButtonStyle="ButtonStyle.Info" Size="ButtonSize.Small" Click="@(() => ReddiGeriAl(item))"></RadzenButton>
						}
						<RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@(() => silKullanici(item))"></RadzenButton>
					</div>
				</Template>
			</RadzenDataGridColumn>
		</Columns>
	</RadzenDataGrid>
</RadzenCard>
@code {
	List<ItemKullanici> kullanicilar = new();

	protected override async Task OnInitializedAsync()
	{
		await Listele();
	}

	async Task Listele()
	{
		kullanicilar = await DbContext.Kullanicilar
			.Include(k => k.KullaniciTip)
			.Where(k => k.DelDate==null)
			.ToListAsync();
	}
	async Task yeniKullanici()
	{
		var result=await DialogService.OpenAsync<KullaniciTnm>("Yeni Kullanici",
			new Dictionary<string, object>(),
			new DialogOptions() { Width = "600px", Height = "400px" });

		if (result == true)
		{
			await Listele();
		}
	}

	async Task duzenleKullanici(ItemKullanici kullanici)
	{
		var result = await DialogService.OpenAsync<KullaniciTnm>("Kullanici Düzenle",
			new Dictionary<string, object>() { { "KullaniciId", kullanici.ID } },
			new DialogOptions() { Width = "600px", Height = "400px" });
		if (result == true)
		{
			await Listele();
		}
	}

	async Task silKullanici(ItemKullanici kullanici)
	{
		bool? result = await DialogService.Confirm("Kullaniciyi silmek istediginize emin misiniz?", "Onay",
			new ConfirmOptions() { OkButtonText = "Evet", CancelButtonText = "Hayir" });
		if (result == true)
		{
			try
			{
				// Kullaniciyi soft delete yap
				kullanici.DelDate = DateTime.UtcNow;
				kullanici.DelUser = AuthStateService.CurrentUser?.ID ?? 1;
				DbContext.Kullanicilar.Update(kullanici);

				// Ögrenci ise, ilgili tablolardaki kayitlari da soft delete yap
				var kullaniciTip = kullanici.KullaniciTip?.Adi?.ToLower() ?? "";
				if (kullaniciTip.Contains("ögrenci") || kullaniciTip.Contains("ogrenci") || kullaniciTip.Contains("student"))
				{
					// Ögrenci ID'sini bul
					var ogrenci = await DbContext.Ogrenciler
						.IgnoreQueryFilters()
						.Where(x => x.Kullanici_ID == kullanici.ID && x.DelDate == null)
						.FirstOrDefaultAsync();

					if (ogrenci != null)
					{
						// ItemOgrenci'yi soft delete yap
						ogrenci.DelDate = DateTime.UtcNow;
						ogrenci.DelUser = AuthStateService.CurrentUser?.ID ?? 1;
						DbContext.Ogrenciler.Update(ogrenci);

						// SinifKullanicilar tablosundaki kayitlari soft delete yap
						var sinifKullanicilar = await DbContext.SinifKullanicilar
							.IgnoreQueryFilters()
							.Where(x => x.Kullanici_ID == kullanici.ID && x.DelDate == null)
							.ToListAsync();

						foreach (var sk in sinifKullanicilar)
						{
							sk.DelDate = DateTime.UtcNow;
							sk.DelUser = AuthStateService.CurrentUser?.ID ?? 1;
							DbContext.SinifKullanicilar.Update(sk);
						}

						// SinifOgrenciler tablosundaki kayitlari soft delete yap
						var sinifOgrenciler = await DbContext.SinifOgrenciler
							.IgnoreQueryFilters()
							.Where(x => x.Ogrenci_ID == ogrenci.ID && x.DelDate == null)
							.ToListAsync();

						foreach (var so in sinifOgrenciler)
						{
							so.DelDate = DateTime.UtcNow;
							so.DelUser = AuthStateService.CurrentUser?.ID ?? 1;
							DbContext.SinifOgrenciler.Update(so);
						}

						// DersKatilimcilar tablosundaki kayitlari soft delete yap (Ogrenci_ID aslinda Kullanici_ID)
						var dersKatilimcilar = await DbContext.DersKatilimcilar
							.IgnoreQueryFilters()
							.Where(x => x.Ogrenci_ID == kullanici.ID && x.DelDate == null)
							.ToListAsync();

						foreach (var dk in dersKatilimcilar)
						{
							dk.DelDate = DateTime.UtcNow;
							dk.DelUser = AuthStateService.CurrentUser?.ID ?? 1;
							DbContext.DersKatilimcilar.Update(dk);
						}
					}
				}

				await DbContext.SaveChangesAsync();
				NotificationService.Notify(NotificationSeverity.Success, "Başarılı", "Kullanıcı ve ilgili kayıtlar başarıyla silindi.");
				await Listele();
			}
			catch (Exception ex)
			{
				NotificationService.Notify(NotificationSeverity.Error, "Hata", $"Kullanıcı silinirken bir hata oluştu: {ex.Message}");
			}
		}
	}

	string GetDurum(ItemKullanici kullanici)
	{
		if (!kullanici.EmailConfirmed)
		{
			return "E-posta Onaylanmamış";
		}
		if (kullanici.Reddedildi)
		{
			return "Reddedilmiş";
		}
		if (kullanici.Aktif)
		{
			return "Onaylanmış";
		}
		return "Bekleyen";
	}

	string GetDurumRenk(ItemKullanici kullanici)
	{
		if (!kullanici.EmailConfirmed)
		{
			return "gray";
		}
		if (kullanici.Reddedildi)
		{
			return "red";
		}
		if (kullanici.Aktif)
		{
			return "green";
		}
		return "orange";
	}

	async Task OnayiGeriAl(ItemKullanici kullanici)
	{
		bool? result = await DialogService.Confirm("Bu hesabın onayını geri almak istediğinize emin misiniz? Kullanıcı tekrar bekleyen duruma dönecek ve giriş yapamayacaktır.", "Onayı Geri Al",
			new ConfirmOptions() { OkButtonText = "Evet", CancelButtonText = "Hayır" });
		
		if (result == true)
		{
			try
			{
				// Hesap zaten aktif değilse
				if (!kullanici.Aktif)
				{
					NotificationService.Notify(NotificationSeverity.Info, "Bilgi", "Hesap zaten aktif değil.");
					await Listele();
					return;
				}

				// Onayı geri al
				kullanici.Aktif = false;
				kullanici.UpdDate = DateTime.UtcNow;
				kullanici.UpdUser = AuthStateService.CurrentUser?.ID ?? 0;
				
				DbContext.Kullanicilar.Update(kullanici);
				await DbContext.SaveChangesAsync();

				NotificationService.Notify(NotificationSeverity.Success, "Başarılı", "Hesap onayı başarıyla geri alındı. Kullanıcı tekrar bekleyen duruma döndü.");
				await Listele();
			}
			catch (Exception ex)
			{
				NotificationService.Notify(NotificationSeverity.Error, "Hata", $"Bir hata oluştu: {ex.Message}");
			}
		}
	}

	async Task ReddiGeriAl(ItemKullanici kullanici)
	{
		bool? result = await DialogService.Confirm("Bu hesabın reddini geri almak istediğinize emin misiniz? Kullanıcı tekrar bekleyen duruma dönecek ve onay bekleyecektir.", "Reddi Geri Al",
			new ConfirmOptions() { OkButtonText = "Evet", CancelButtonText = "Hayır" });
		
		if (result == true)
		{
			try
			{
				// Hesap zaten reddedilmemişse
				if (!kullanici.Reddedildi)
				{
					NotificationService.Notify(NotificationSeverity.Info, "Bilgi", "Hesap zaten reddedilmemiş.");
					await Listele();
					return;
				}

				// Reddi geri al
				kullanici.Reddedildi = false;
				kullanici.Aktif = false; // Bekleyen duruma döndürmek için Aktif'i false yap
				kullanici.UpdDate = DateTime.UtcNow;
				kullanici.UpdUser = AuthStateService.CurrentUser?.ID ?? 0;
				
				DbContext.Kullanicilar.Update(kullanici);
				await DbContext.SaveChangesAsync();

				NotificationService.Notify(NotificationSeverity.Success, "Başarılı", "Hesap reddi başarıyla geri alındı. Kullanıcı tekrar bekleyen duruma döndü.");
				await Listele();
			}
			catch (Exception ex)
			{
				NotificationService.Notify(NotificationSeverity.Error, "Hata", $"Bir hata oluştu: {ex.Message}");
			}
		}
	}

	async Task HesapAktiflestir(ItemKullanici kullanici)
	{
		var result = await DialogService.OpenAsync<AccountActivationDialog>("Hesap Aktifleştirme",
			new Dictionary<string, object>() { { "Kullanici", kullanici } },
			new DialogOptions() { Width = "500px", Height = "400px" });
		
		if (result == true)
		{
			await Listele();
		}
	}
}
