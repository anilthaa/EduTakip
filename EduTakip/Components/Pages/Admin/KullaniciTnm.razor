<form @onsubmit="Kaydet" @onsubmit:preventDefault>
	<div class="form-group mb-3">
		<input type="text" class="form-control" @bind="model.Adi" placeholder="Ad" required />
	</div>
	<div class="form-group mb-3">
		<input type="text" class="form-control" @bind="model.Soyadi" placeholder="Soyad" />
	</div>
	<div class="form-group mb-3">
		<input type="text" class="form-control" @bind="model.EPosta" placeholder="E-Posta" />
	</div>
	<div class="form-group mb-3">
		<select class="form-select" @bind="model.KullaniciTip_ID">
			<option value="">Kullanıcı Tipi</option>
			@foreach (var kt in kullaniciTipleri)
			{
				<option value="@kt.ID">@kt.Adi</option>
			}
		</select>
	</div>
	<div class="form-group mb-3">
		<input type="password" class="form-control" @bind="tempPassword" placeholder="Şifre (Opsiyonel - Boş bırakılırsa aktifleştirme sırasında geçici şifre gönderilir)" />
	</div>
	<p style="font-size: 12px; color: #666; margin-top: 5px;">Not: Yeni kullanıcılar otomatik olarak pasif durumda oluşturulur. Hesap aktifleştirme işlemi kullanıcı listesinden yapılabilir.</p>

	<div class="mt-3 text-center">
		<button type="submit" class="btn btn-success" style="margin-right:10px;">Kaydet</button>
		<button type="button" class="btn btn-danger" @onclick="@(() => ModalService.Close(false))">İptal</button>
	</div>
</form>

@code {
	[Parameter] public int? KullaniciId { get; set; }
	ItemKullanici model = new();
	List<ItemKullaniciTip> kullaniciTipleri = new();
	string tempPassword = string.Empty;

	protected override async Task OnInitializedAsync()
	{
		kullaniciTipleri = await DbContext.KullaniciTipleri
			.Where(kt => kt.DelDate == null || kt.DelDate == default(DateTime))
			.ToListAsync();
		if (KullaniciId!=null)
		{
			model = await DbContext.Kullanicilar
				.FirstOrDefaultAsync(k => k.ID == KullaniciId);
			if (model == null)
			{
				ToastService.Notify(ToastSeverity.Error, "Hata", "Kullanıcı bulunamadı veya silinmiş.");
				ModalService.Close(false);
			}
		}
		else
		{
			model.Aktif = false;
			model.EmailConfirmed = false;
		}
	}

	async Task Kaydet()
	{
		if (model.ID==0)
		{
			model.Aktif = false;
			model.EmailConfirmed = false;
			model.CreUser = AuthStateService.CurrentUser?.ID ?? 0;
			model.CreDate = DateTime.UtcNow;
			
			if (!string.IsNullOrWhiteSpace(tempPassword))
			{
				model.Sifre = PasswordHasher.Hash(tempPassword);
			}
			else
			{
				model.Sifre = PasswordHasher.Hash("TempPassword123!");
			}
			
			DbContext.Kullanicilar.Add(model);
		}
		else
		{
			model.UpdUser = AuthStateService.CurrentUser?.ID;
			model.UpdDate = DateTime.UtcNow;
			
			if (!string.IsNullOrWhiteSpace(tempPassword))
			{
				model.Sifre = PasswordHasher.Hash(tempPassword);
			}
			
			DbContext.Kullanicilar.Update(model);
		}
		
		await DbContext.SaveChangesAsync();
		ModalService.Close(true);
	}
}
