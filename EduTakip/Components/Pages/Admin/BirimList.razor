@page "/admin/birimler"
@attribute [Authorize(Roles ="Admin")]

<RadzenButton Text="Yeni Birim Ekle" Icon="add" ButtonStyle="ButtonStyle.Success" Style="margin-bottom:15px; border-radius:10px;" Click="@YeniBirim" />
<RadzenCard Style="margin:0; margin-left:0; padding:20px; width:100%; max-width:none; box-sizing:border-box">
	<h3 style="text-align:center;">Birimler</h3>
	@if (birimler==null || !birimler.Any())
	{
		<p style="text-align:center;">Veri yükleniyor... Veya birim eklenmemiş</p>	
	}
	else
	{
		<RadzenDataGrid TItem="ItemBirim" Data="@birimler" AllowPaging="true" PageSize="10">
			<Columns>
				<RadzenDataGridColumn TItem="ItemBirim" Property="ID" Title="ID" Width="80px"></RadzenDataGridColumn>
				<RadzenDataGridColumn TItem="ItemBirim" Property="Adi" Title="Birim Adı" />
				<RadzenDataGridColumn TItem="ItemBirim" Title="Aktif">
					<Template Context="item">
						<span class="status-badge @(item.Aktif ? "status-active" : "status-inactive")"
							  @onclick="@(() => ToggleAktif(item))">
							@(item.Aktif ? "Aktif" : "Pasif")
						</span>
					</Template>
				</RadzenDataGridColumn>

				<RadzenDataGridColumn TItem="ItemBirim" Title="İşlemler">
					<Template Context="item">
						<RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@(() => EditBirim(item))" Style="margin-right: 10px;" />
						<RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@(() => DeleteBirim(item))" />
					</Template>
				</RadzenDataGridColumn>
			</Columns>
		</RadzenDataGrid>
	}
	
</RadzenCard>

@code {

	List<ItemBirim> birimler = new();
	protected override async Task OnInitializedAsync()
	{
		await Listele();
	}

	async Task Listele()
	{
		
		birimler = await DbContext.Birimler
			.OrderBy(x => x.Adi)
			.ToListAsync();
	}
	async Task YeniBirim()
	{
		var result = await DialogService.OpenAsync<BirimTnm>("Yeni Birim Ekle", new Dictionary<string, object>()
		{
			{ "BirimId", 0 }
		}, new DialogOptions() { Width = "600px" });
		if (result == true)
		{
			await Listele();
			StateHasChanged();
		}
	}

	async Task EditBirim(ItemBirim birim)
	{
		var result = await DialogService.OpenAsync<BirimTnm>("Birim Düzenle", new Dictionary<string, object>()
		{
			{ "BirimId", birim.ID }
		}, new DialogOptions() { Width = "600px" });
		if (result == true)
		{
			await Listele();
			StateHasChanged();
		}
	}

	async Task ToggleAktif(ItemBirim birim)
	{
		var yeniDurum = !birim.Aktif;
		birim.Aktif = yeniDurum;
		birim.UpdDate = DateTime.UtcNow;
		birim.UpdUser = 0; // TODO: Gerçek kullanıcı ID'si kullanılacak
		DbContext.Birimler.Update(birim);
		await DbContext.SaveChangesAsync();
		await Listele();
		NotificationService.Notify(NotificationSeverity.Success,"Başarılı", $"Birim {(yeniDurum ? "aktif" : "pasif")} yapıldı.");
		StateHasChanged();
	}

	async Task DeleteBirim(ItemBirim birim)
	{
		bool? result = await DialogService.Confirm($"'{birim.Adi}' birimini silmek istediğinize emin misiniz?", "Birim Silme Onayı", new ConfirmOptions() { OkButtonText = "Evet", CancelButtonText = "Hayır" });
		if (result == true)
		{
			birim.DelUser = 0; // TODO: Gerçek kullanıcı ID'si kullanılacak
			birim.DelDate = DateTime.UtcNow;
			birim.Aktif = false;
			DbContext.Birimler.Update(birim);
			await DbContext.SaveChangesAsync();
			await Listele();
			NotificationService.Notify(NotificationSeverity.Success,"Başarılı", "Birim silindi.");
			StateHasChanged();
		}
	}
}
