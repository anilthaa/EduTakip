@page "/admin/birimler"
@attribute [Authorize(Roles ="Admin")]

<button class="btn btn-success btn-sm" style="margin-bottom:15px; border-radius:10px;" @onclick="YeniBirim">
	<span class="material-icons">add</span> Yeni Birim Ekle
</button>
<div class="card" style="margin:0; margin-left:0; padding:20px; width:100%; max-width:none; box-sizing:border-box">
	<div class="card-body">
		<h3 style="text-align:center;">Birimler</h3>
		@if (birimler == null || !birimler.Any())
		{
			<p style="text-align:center;">Veri yükleniyor... Veya birim eklenmemis</p>
		}
		else
		{
			<div class="data-table-wrapper">
				<table class="data-table">
					<thead>
						<tr>
							<th style="width:80px;">ID</th>
							<th>Birim Adi</th>
							<th>Aktif</th>
							<th>Islemler</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var item in birimler)
						{
							<tr>
								<td>@item.ID</td>
								<td>@item.Adi</td>
								<td>
									<span class="status-badge @(item.Aktif ? "status-active" : "status-inactive")"
										  @onclick="@(() => ToggleAktif(item))">
										@(item.Aktif ? "Aktif" : "Pasif")
									</span>
								</td>
								<td>
									<button class="btn btn-primary btn-sm" @onclick="@(() => EditBirim(item))" style="margin-right: 10px;">
										<span class="material-icons">edit</span>
									</button>
									<button class="btn btn-danger btn-sm" @onclick="@(() => DeleteBirim(item))">
										<span class="material-icons">delete</span>
									</button>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
</div>

@code {

	List<ItemBirim> birimler = new();
	protected override async Task OnInitializedAsync()
	{
		await Listele();
	}

	async Task Listele()
	{
		birimler = await DbContext.Birimler
			.Where(x => x.DelDate == null || x.DelDate == default(DateTime))
			.OrderBy(x => x.Adi)
			.ToListAsync();
	}

	async Task YeniBirim()
	{
		var result = await ModalService.OpenAsync<BirimTnm>("Yeni Birim Ekle", new Dictionary<string, object>()
		{
			{ "BirimId", 0 }
		}, new ModalOptions { CssClass = "modal-md" });
		if (result is true)
		{
			await Listele();
			StateHasChanged();
		}
	}

	async Task EditBirim(ItemBirim birim)
	{
		var result = await ModalService.OpenAsync<BirimTnm>("Birim Düzenle", new Dictionary<string, object>()
		{
			{ "BirimId", birim.ID }
		}, new ModalOptions { CssClass = "modal-md" });
		if (result is true)
		{
			await Listele();
			StateHasChanged();
		}
	}

	async Task ToggleAktif(ItemBirim birim)
	{
		var yeniDurum = !birim.Aktif;
		birim.Aktif = yeniDurum;
		birim.UpdDate = DateTime.UtcNow;
		birim.UpdUser = AuthStateService.CurrentUser?.ID;
		DbContext.Birimler.Update(birim);
		await DbContext.SaveChangesAsync();
		await Listele();
		ToastService.Notify(ToastSeverity.Success, "Başarılı", $"Birim {(yeniDurum ? "aktif" : "pasif")} yapıldı.");
		StateHasChanged();
	}

	async Task DeleteBirim(ItemBirim birim)
	{
		var result = await JSRuntime.InvokeAsync<bool>("confirm", $"'{birim.Adi}' birimini silmek istediginize emin misiniz?");
		if (result)
		{
			birim.DelUser = AuthStateService.CurrentUser?.ID;
			birim.DelDate = DateTime.UtcNow;
			birim.Aktif = false;
			DbContext.Birimler.Update(birim);
			await DbContext.SaveChangesAsync();
			await Listele();
			ToastService.Notify(ToastSeverity.Success, "Başarılı", "Birim silindi.");
			StateHasChanged();
		}
	}
}
