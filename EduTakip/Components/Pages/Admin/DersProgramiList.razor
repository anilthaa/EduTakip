@page "/admin/ders-programlari"
@attribute [Authorize(Roles = "Admin")]
	
	<RadzenButton Text="Yeni Ders Programı" Icon="add" Style="margin-bottom:15px; border-radius:10px;" ButtonStyle="ButtonStyle.Success" Click="@Yeni" />
<RadzenCard Style="margin:0; margin-left:0; padding:20px; width:100%; max-width:none; box-sizing:border-box">
	<h3 style="text-align:center;">Ders Programları</h3>
	<RadzenDataGrid TItem="ItemDersProgrami" Data="@list">
		<Columns>
			<RadzenDataGridColumn TItem="ItemDersProgrami" Property="ID" Title="ID" Width="80px"></RadzenDataGridColumn>
			<RadzenDataGridColumn TItem="ItemDersProgrami" Title="Ders Adı">
				<Template Context="item">
					@item.Ders?.Adi
				</Template>
			</RadzenDataGridColumn>

			<RadzenDataGridColumn TItem="ItemDersProgrami" Title="Gün">
				<Template Context="item">
					@GetGunAdi(item.Gun)
				</Template>
			</RadzenDataGridColumn>
			<RadzenDataGridColumn TItem="ItemDersProgrami" Title="Başlangıç Saati">
				<Template Context="item">
					@item.BaslangicSaati.ToString("hh\\:mm")
				</Template>
			</RadzenDataGridColumn>
			<RadzenDataGridColumn TItem="ItemDersProgrami" Title="Bitiş Saati">
				<Template Context="item">
					@item.BitisSaati.ToString("hh\\:mm")
				</Template>
			</RadzenDataGridColumn>
			<RadzenDataGridColumn TItem="ItemDersProgrami" Title="Sınıf">
				<Template Context="item">
					@item.Sinif?.Adi
				</Template>
			</RadzenDataGridColumn>

			<RadzenDataGridColumn TItem="ItemDersProgrami" Title="İşlemler">
				<Template Context="item">
					<RadzenButton Icon="edit" Size="ButtonSize.Small" Click="@(() => EditDersProg(item.ID))" Style="margin-right: 10px;" />
					<RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@(() => DeleteDersProg(item))" />
				</Template>
			</RadzenDataGridColumn>
		</Columns>
	</RadzenDataGrid>
</RadzenCard>

@code {
	List<ItemDersProgrami> list = new();

	protected override async Task OnInitializedAsync()
	{
		await Listele();
	}

	private string GetGunAdi(DayOfWeek gun)
	{
		return gun switch
		{
			DayOfWeek.Monday => "Pazartesi",
			DayOfWeek.Tuesday => "Salı",
			DayOfWeek.Wednesday => "Çarşamba",
			DayOfWeek.Thursday => "Perşembe",
			DayOfWeek.Friday => "Cuma",
			DayOfWeek.Saturday => "Cumartesi",
			DayOfWeek.Sunday => "Pazar",
			_ => gun.ToString()
		};
	}

	async Task Listele()
	{
		list = await DbContext.DersProgramlari
			.Include(x => x.Ders)
			.Include(x => x.Sinif)
			.ToListAsync();
	}

	async Task Yeni()
	{
		var result = await DialogService.OpenAsync<DersProgramiTnm>(
			"Ders Programı",
			null,
			new DialogOptions() { Width = "600px" });
		
		if (result == true)
		{
			await Listele();
		}
	}

	async Task EditDersProg(int id)
	{
		var result = await DialogService.OpenAsync<DersProgramiTnm>("Ders Programı Düzenle", new Dictionary<string, object>()
		{
			{ "Id", id }
		}, new DialogOptions() { Width = "600px"});
		if (result == true)
		{
			await Listele();
		}
	}

	async Task DeleteDersProg(ItemDersProgrami item)
	{
		bool? result = await DialogService.Confirm("Seçili ders programını silmek istediğinize emin misiniz?", "Ders Programı Sil", new ConfirmOptions() { OkButtonText = "Evet", CancelButtonText = "Hayır" });
		if (result == true)
		{
			try
			{
				item.DelDate = DateTime.UtcNow;
				item.DelUser = 0; // TODO: Gerçek kullanıcı ID'si kullanılacak
				DbContext.DersProgramlari.Update(item);
				await DbContext.SaveChangesAsync();
				NotificationService.Notify(NotificationSeverity.Success, "Başarılı", "Ders programı başarıyla silindi.");
				await Listele();
			}
			catch (Exception ex)
			{
				NotificationService.Notify(NotificationSeverity.Error, "Hata", $"Ders programı silinirken bir hata oluştu: {ex.Message}");
			}
		}
	}
}
