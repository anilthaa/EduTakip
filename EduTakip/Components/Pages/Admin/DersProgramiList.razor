@page "/admin/ders-programlari"
@attribute [Authorize(Roles = "Admin")]

<button class="btn btn-success btn-sm" style="margin-bottom:15px; border-radius:10px;" @onclick="Yeni"><span class="material-icons">add</span> Yeni Ders Programi</button>

<div class="card" style="margin:0; margin-left:0; padding:20px; width:100%; max-width:none; box-sizing:border-box">
	<div class="card-body">
		<h3 style="text-align:center;">Ders Programlari</h3>
		<div class="data-table-wrapper">
			<table class="data-table">
				<thead>
					<tr>
						<th style="width:80px">ID</th>
						<th>Ders Adi</th>
						<th>Gün</th>
						<th>Baslangiç Saati</th>
						<th>Bitis Saati</th>
						<th>Sinif</th>
						<th>Islemler</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var item in list)
					{
						<tr>
							<td>@item.ID</td>
							<td>@item.Ders?.Adi</td>
							<td>@GetGunAdi(item.Gun)</td>
							<td>@item.BaslangicSaati.ToString("hh\\:mm")</td>
							<td>@item.BitisSaati.ToString("hh\\:mm")</td>
							<td>@item.Sinif?.Adi</td>
							<td>
								<button class="btn btn-sm" style="margin-right: 10px;" @onclick="@(() => EditDersProg(item.ID))"><span class="material-icons">edit</span></button>
								<button class="btn btn-danger btn-sm" @onclick="@(() => DeleteDersProg(item))"><span class="material-icons">delete</span></button>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
</div>

@code {
	List<ItemDersProgrami> list = new();

	protected override async Task OnInitializedAsync()
	{
		await Listele();
	}

	private string GetGunAdi(DayOfWeek gun)
	{
		return gun switch
		{
			DayOfWeek.Monday => "Pazartesi",
			DayOfWeek.Tuesday => "Sali",
			DayOfWeek.Wednesday => "Çarsamba",
			DayOfWeek.Thursday => "Persembe",
			DayOfWeek.Friday => "Cuma",
			DayOfWeek.Saturday => "Cumartesi",
			DayOfWeek.Sunday => "Pazar",
			_ => gun.ToString()
		};
	}

	async Task Listele()
	{
		list = await DbContext.DersProgramlari
			.Include(x => x.Ders)
			.Include(x => x.Sinif)
			.Where(x => x.DelDate == null || x.DelDate == default(DateTime))
			.ToListAsync();
	}

	async Task Yeni()
	{
		// Ders var mı kontrolü
		var dersVarMi = await DbContext.Dersler.AnyAsync(d => d.DelDate == null || d.DelDate == default(DateTime));
		if (!dersVarMi)
		{
			ToastService.Notify(ToastSeverity.Warning, "Uyarı", "Henüz tanımlı ders yok. Lütfen önce bir ders ekleyin.");
			return;
		}

		// Sinıf var mı kontrolü
		var sinifVarMi = await DbContext.Siniflar.AnyAsync(s => (s.DelDate == null || s.DelDate == default(DateTime)) && s.Aktif);
		if (!sinifVarMi)
		{
			ToastService.Notify(ToastSeverity.Warning, "Uyarı", "Henüz tanımlı aktif sınıf yok. Lütfen önce bir sınıf ekleyin.");
			return;
		}

		var result = await ModalService.OpenAsync<DersProgramiTnm>(
			"Ders Programi",
			null,
			new ModalOptions { CssClass = "modal-md" });
		
		if (result is true)
		{
			await Listele();
		}
	}

	async Task EditDersProg(int id)
	{
		var result = await ModalService.OpenAsync<DersProgramiTnm>("Ders Programi Düzenle", new Dictionary<string, object>()
		{
			{ "Id", id }
		}, new ModalOptions { CssClass = "modal-md" });
		if (result is true)
		{
			await Listele();
		}
	}

	async Task DeleteDersProg(ItemDersProgrami item)
	{
		bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Seçili ders programini silmek istediginize emin misiniz?");
		if (confirmed)
		{
			try
			{
				item.DelDate = DateTime.UtcNow;
				item.DelUser = 0;
				DbContext.DersProgramlari.Update(item);
				await DbContext.SaveChangesAsync();
				ToastService.Notify(ToastSeverity.Success, "Başarılı", "Ders programı başarıyla silindi.");
				await Listele();
			}
			catch (Exception ex)
			{
				ToastService.Notify(ToastSeverity.Error, "Hata", $"Ders programı silinirken bir hata oluştu: {ex.Message}");
			}
		}
	}
}
