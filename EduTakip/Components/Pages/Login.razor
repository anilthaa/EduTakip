@page "/"
@page "/login"

@layout EmptyLayout

<PageTitle>Giriş Yap</PageTitle>

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <h2>EduTakip</h2>
            <p>Hesabınıza giriş yapın</p>
        </div>

        <form @onsubmit="OnLogin" @onsubmit:preventDefault class="auth-form">
            <div class="auth-form-inner">
                <div class="form-group">
                    <label class="form-label">E-Posta</label>
                    <input type="text" class="form-control" @bind="loginModel.EPosta" placeholder="ornek@email.com" />
                </div>

                <div class="form-group">
                    <label class="form-label">Şifre</label>
                    <input type="password" class="form-control" @bind="loginModel.Sifre" placeholder="Şifrenizi girin" />
                </div>

                <div class="auth-forgot">
                    <a href="/forgot-password">Şifremi Unuttum</a>
                </div>

                <div class="auth-actions">
                    <button type="submit"
                            class="btn btn-gradient btn-auth-primary @(isLoading ? "btn-loading" : "")"
                            disabled="@isLoading">
                        Giriş Yap
                    </button>
                </div>
            </div>
        </form>

        <div class="auth-footer">
            <span>Hesabınız yok mu? </span>
            <a href="/register">Kayıt Ol</a>
        </div>
    </div>
</div>

@code {
    private LoginModel loginModel = new();
    private bool isLoading = false;
    private bool isInitialized = false;

    public class LoginModel
    {
        public string EPosta { get; set; } = "";
        public string Sifre { get; set; } = "";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AuthStateService.InitializeAsync();
            isInitialized = true;
            StateHasChanged();
        }
    }

    private async Task OnLogin()
    {
        if (isLoading) return;

        if (string.IsNullOrWhiteSpace(loginModel.EPosta) || string.IsNullOrWhiteSpace(loginModel.Sifre))
        {
            ToastService.Notify(ToastSeverity.Warning, "Uyarı", "Lütfen e-posta ve şifre alanlarını doldurun.", 4000);
            return;
        }

        isLoading = true;
        StateHasChanged();

        try
        {
            var loginRequest = new LoginRequest(loginModel.EPosta, loginModel.Sifre);
            var response = await AuthService.LoginAsync(loginRequest);

            if (response != null && !string.IsNullOrEmpty(response.Token))
            {
                var success = await AuthStateService.LoginAsync(response.Token, response.Kullanici);

                if (success)
                {
                    ToastService.Notify(ToastSeverity.Success, "Başarılı", "Giriş yapıldı", 2000);

                    await Task.Delay(500);
                    NavigationManager.NavigateTo("/dashboard");
                }
                else
                {
                    ToastService.Notify(ToastSeverity.Error, "Hata", "Giriş yapılamadı", 4000);
                }
            }
            else
            {
                ToastService.Notify(ToastSeverity.Error, "Hata", "E-posta veya şifre hatalı", 4000);
            }
        }
        catch (HttpRequestException ex)
        {
            ToastService.Notify(ToastSeverity.Error, "Hata", ex.Message, 5000);
        }
        catch (Exception ex)
        {
            ToastService.Notify(ToastSeverity.Error, "Hata", $"Bir hata oluştu: {ex.Message}", 5000);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}
