@page "/activate-account"

<PageTitle>Hesap Aktifleştirme</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    @if (isProcessing)
                    {
                        <div style="text-align: center; padding: 20px;">
                            <div class="spinner"></div>
                            <p style="margin-top: 10px;">Hesap aktifleştiriliyor...</p>
                        </div>
                    }
                    else if (isSuccess)
                    {
                        <div style="text-align: center; padding: 20px;">
                            <span class="material-icons" style="font-size: 48px; color: green; margin-bottom: 20px;">check_circle</span>
                            <h3>Hesap Başarıyla Aktifleştirildi!</h3>
                            <p>Hesabınız aktifleştirildi. Artık giriş yapabilirsiniz.</p>
                            <button type="button"
                                    class="btn btn-gradient btn-auth-primary"
                                    @onclick='() => NavigationManager.NavigateTo("/login")'
                                    style="margin-top: 20px;">
                                Giriş Sayfasına Git
                            </button>
                        </div>
                    }
                    else if (hasError)
                    {
                        <div style="text-align: center; padding: 20px;">
                            <span class="material-icons" style="font-size: 48px; color: red; margin-bottom: 20px;">error</span>
                            <h3>Aktifleştirme Başarısız</h3>
                            <p>@errorMessage</p>
                            <button type="button"
                                    class="btn btn-gradient btn-auth-primary"
                                    @onclick='() => NavigationManager.NavigateTo("/login")'
                                    style="margin-top: 20px;">
                                Giriş Sayfasına Git
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    bool isProcessing = true;
    bool isSuccess = false;
    bool hasError = false;
    string errorMessage = string.Empty;

    class ActivateResponse
    {
        [JsonPropertyName("success")]
        public bool Success { get; set; }
        
        [JsonPropertyName("message")]
        public string? Message { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        // Query string'den token'ı al
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var queryParams = QueryHelpers.ParseQuery(uri.Query);
        
        if (!queryParams.TryGetValue("token", out var tokenValues) || tokenValues.Count == 0 || string.IsNullOrWhiteSpace(tokenValues[0]))
        {
            hasError = true;
            errorMessage = "Geçersiz token.";
            isProcessing = false;
            StateHasChanged();
            return;
        }

        var token = tokenValues[0];

        try
        {
            var baseUrl = NavigationManager.BaseUri.TrimEnd('/');
            var url = $"{baseUrl}/api/auth/activate-account?token={Uri.EscapeDataString(token)}";
            var response = await Http.GetAsync(url);
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ActivateResponse>();
                if (result != null && result.Success)
                {
                    isSuccess = true;
                    hasError = false;
                    ToastService.Notify(ToastSeverity.Success, "Başarılı", result.Message ?? "Hesap başarıyla aktifleştirildi.");
                }
                else
                {
                    hasError = true;
                    errorMessage = result?.Message ?? "Hesap aktifleştirilirken bir hata oluştu.";
                }
            }
            else
            {
                var errorResult = await response.Content.ReadFromJsonAsync<ActivateResponse>();
                hasError = true;
                errorMessage = errorResult?.Message ?? "Hesap aktifleştirilirken bir hata oluştu.";
            }
        }
        catch (Exception ex)
        {
            hasError = true;
            errorMessage = $"Bir hata oluştu: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }
}
