<div class="flex-stack gap-md">
    <label class="form-label">Katılmak istediğiniz sınıfı seçin:</label>
    
    <div class="data-table-wrapper" style="max-height: 400px; overflow-y: auto;">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Sınıf Adı</th>
                    <th>Durum</th>
                    <th>İşlem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in siniflar)
                {
                    <tr>
                        <td>@item.Adi</td>
                        <td>
                            <span class="badge" style="@(item.Aktif ? "background-color: #28a745; color: white;" : "background-color: #dc3545; color: white;")">
                                @(item.Aktif ? "Aktif" : "Pasif")
                            </span>
                        </td>
                        <td>
                            <button class="btn btn-success btn-sm" @onclick="@(() => OnSinifSecildi(item))">
                                <span class="material-icons">add</span> Katıl
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="flex-row gap-sm" style="justify-content:flex-end;">
        <button class="btn btn-outline btn-sm" @onclick="@(() => ModalService.Close(false))">İptal</button>
    </div>
</div>

@code {
    [Parameter] public int KullaniciId { get; set; }
    [Parameter] public string KullaniciTip { get; set; } = "";

    private List<ItemSinif> siniflar = new();

    protected override async Task OnInitializedAsync()
    {
        await YukleSiniflar();
    }

    async Task YukleSiniflar()
    {
        // Kullanıcının zaten katıldığı sınıfları al
        var katildigiSiniflar = await DbContext.SinifKullanicilar
            .Where(x => x.Kullanici_ID == KullaniciId && (x.DelDate == null || x.DelDate == default(DateTime)))
            .Select(x => x.Sinif_ID)
            .ToListAsync();

        // Katılmadığı aktif sınıfları göster
        siniflar = await DbContext.Siniflar
            .Where(s => s.Aktif && (s.DelDate == null || s.DelDate == default(DateTime)) && !katildigiSiniflar.Contains(s.ID))
            .OrderBy(s => s.Adi)
            .ToListAsync();
    }

    async Task OnSinifSecildi(ItemSinif sinif)
    {
        if (sinif == null) return;

        try
        {
            // Öğrenci ise ve ItemOgrenci.Sinif_ID null ise, ilk katıldığı sınıfı ana sınıf olarak ayarla
            if ((KullaniciTip.Contains("öğrenci") || KullaniciTip.Contains("ogrenci") || KullaniciTip.Contains("Öğrenci")) && 
                !string.IsNullOrEmpty(KullaniciTip))
            {
                var ogrenci = await DbContext.Ogrenciler
                    .Where(x => x.Kullanici_ID == KullaniciId && (x.DelDate == null || x.DelDate == default(DateTime)))
                    .FirstOrDefaultAsync();

                if (ogrenci != null && !ogrenci.Sinif_ID.HasValue)
                {
                    // İlk sınıfa katılıyor, ana sınıf olarak ayarla
                    ogrenci.Sinif_ID = sinif.ID;
                    ogrenci.UpdDate = DateTime.UtcNow;
                    ogrenci.UpdUser = KullaniciId;
                    DbContext.Ogrenciler.Update(ogrenci);
                }
            }

            // ItemSinifKullanici kaydı oluştur
            var yeniKayit = new ItemSinifKullanici
            {
                CreDate = DateTime.UtcNow,
                CreUser = KullaniciId,
                Sinif_ID = sinif.ID,
                Kullanici_ID = KullaniciId,
                Tip = KullaniciTip
            };

            DbContext.SinifKullanicilar.Add(yeniKayit);
            await DbContext.SaveChangesAsync();

            ToastService.Notify(ToastSeverity.Success, "Başarılı", $"{sinif.Adi} sınıfına başarıyla katıldınız.");
            ModalService.Close(true);
        }
        catch (Exception ex)
        {
            ToastService.Notify(ToastSeverity.Error, "Hata", $"Sınıfa katılırken bir hata oluştu: {ex.Message}");
        }
    }
}
