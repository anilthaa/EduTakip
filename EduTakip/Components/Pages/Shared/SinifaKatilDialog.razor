<div class="flex-stack gap-md">
    <label class="form-label">Katılmak istediğiniz sınıfı seçin:</label>
    
    <div class="data-table-wrapper" style="max-height: 400px; overflow-y: auto;">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Sınıf Adı</th>
                    <th>Durum</th>
                    <th>İşlem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in siniflar)
                {
                    <tr>
                        <td>@item.Adi</td>
                        <td>
                            <span class="badge" style="@(item.Aktif ? "background-color: #28a745; color: white;" : "background-color: #dc3545; color: white;")">
                                @(item.Aktif ? "Aktif" : "Pasif")
                            </span>
                        </td>
                        <td>
                            <button class="btn btn-success btn-sm" @onclick="@(() => OnSinifSecildi(item))">
                                <span class="material-icons">add</span> Katıl
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="flex-row gap-sm" style="justify-content:flex-end;">
        <button class="btn btn-outline btn-sm" @onclick="@(() => ModalService.Close(false))">İptal</button>
    </div>
</div>

@code {
    [Parameter] public string KullaniciTip { get; set; } = "";
    [Parameter] public int? OgrenciId { get; set; }
    [Parameter] public int? OgretmenId { get; set; }

    private List<ItemSinif> siniflar = new();

    protected override async Task OnInitializedAsync()
    {
        await YukleSiniflar();
    }

    async Task YukleSiniflar()
    {
        if (KullaniciTip.Contains("öğrenci") || KullaniciTip.Contains("ogrenci"))
        {
            // Öğrenci için: Kendi sınıfı hariç diğer aktif sınıfları göster
            var ogrenciSinifId = await DbContext.Ogrenciler
                .Where(x => x.ID == OgrenciId!.Value)
                .Select(x => x.Sinif_ID)
                .FirstOrDefaultAsync();

            siniflar = await DbContext.Siniflar
                .Where(s => s.Aktif && (s.DelDate == null || s.DelDate == default(DateTime)) && s.ID != ogrenciSinifId)
                .OrderBy(s => s.Adi)
                .ToListAsync();
        }
        else if (KullaniciTip.Contains("öğretmen") || KullaniciTip.Contains("ogretmen"))
        {
            // Öğretmen için: Tüm aktif sınıfları göster
            siniflar = await DbContext.Siniflar
                .Where(s => s.Aktif && (s.DelDate == null || s.DelDate == default(DateTime)))
                .OrderBy(s => s.Adi)
                .ToListAsync();
        }
    }

    async Task OnSinifSecildi(ItemSinif sinif)
    {
        if (sinif == null) return;

        try
        {
            if (KullaniciTip.Contains("öğrenci") || KullaniciTip.Contains("ogrenci"))
            {
                await OgrenciSinifaKatil(sinif.ID);
            }
            else if (KullaniciTip.Contains("öğretmen") || KullaniciTip.Contains("ogretmen"))
            {
                await OgretmenSinifaKatil(sinif.ID);
            }
        }
        catch (Exception ex)
        {
            ToastService.Notify(ToastSeverity.Error, "Hata", $"Sınıfa katılırken bir hata oluştu: {ex.Message}");
        }
    }

    async Task OgrenciSinifaKatil(int sinifId)
    {
        if (!OgrenciId.HasValue) return;

        // Öğrencinin kullanıcı ID'sini al
        var kullaniciId = await DbContext.Ogrenciler
            .Where(x => x.ID == OgrenciId.Value)
            .Select(x => x.Kullanici_ID)
            .FirstOrDefaultAsync();

        if (kullaniciId == 0) return;

        // Öğrencinin ItemOgrenci kaydını al ve Sinif_ID null ise güncelle
        var ogrenci = await DbContext.Ogrenciler
            .Where(x => x.ID == OgrenciId.Value && (x.DelDate == null || x.DelDate == default(DateTime)))
            .FirstOrDefaultAsync();

        bool sinifIdGuncellendi = false;
        if (ogrenci != null && !ogrenci.Sinif_ID.HasValue)
        {
            // İlk sınıfa katılıyor, ana sınıf olarak ayarla
            ogrenci.Sinif_ID = sinifId;
            ogrenci.UpdDate = DateTime.UtcNow;
            ogrenci.UpdUser = kullaniciId;
            DbContext.Ogrenciler.Update(ogrenci);
            sinifIdGuncellendi = true;
        }

        // Bu sınıftaki dersleri bul
        var sinifAdi = await DbContext.Siniflar
            .Where(x => x.ID == sinifId)
            .Select(x => x.Adi)
            .FirstOrDefaultAsync();

        var dersler = await DbContext.DersProgramlari
            .Where(x => x.Sinif_ID == sinifId && (x.DelDate == null || x.DelDate == default(DateTime)))
            .Select(x => x.Ders_ID)
            .Distinct()
            .ToListAsync();

        // Öğrencinin zaten katıldığı dersleri kontrol et
        var katildigiDersler = await DbContext.DersKatilimcilar
            .Where(x => x.Ogrenci_ID == kullaniciId && dersler.Contains(x.Ders_ID) && (x.DelDate == null || x.DelDate == default(DateTime)))
            .Select(x => x.Ders_ID)
            .ToListAsync();

        // Katılmadığı derslere katıl
        int katilimSayisi = 0;
        foreach (var dersId in dersler)
        {
            if (!katildigiDersler.Contains(dersId))
            {
                var katilim = new ItemDersKatilimci
                {
                    Ders_ID = dersId,
                    Ogrenci_ID = kullaniciId,
                    CreUser = kullaniciId,
                    CreDate = DateTime.UtcNow
                };

                DbContext.DersKatilimcilar.Add(katilim);
                katilimSayisi++;
            }
        }

        if (katilimSayisi > 0 || sinifIdGuncellendi)
        {
            await DbContext.SaveChangesAsync();
            ToastService.Notify(ToastSeverity.Success, "Başarılı", $"{sinifAdi} sınıfına başarıyla katıldınız. {katilimSayisi} derse kaydınız yapıldı.");
            ModalService.Close(true);
        }
        else
        {
            ToastService.Notify(ToastSeverity.Info, "Bilgi", "Bu sınıftaki tüm derslere zaten katılıyorsunuz.");
        }
    }

    async Task OgretmenSinifaKatil(int sinifId)
    {
        if (!OgretmenId.HasValue) return;

        // Öğretmenin derslerini bul
        var ogretmenDersleri = await DbContext.Dersler
            .Where(x => x.Ogretmen_ID == OgretmenId.Value && (x.DelDate == null || x.DelDate == default(DateTime)))
            .Select(x => x.ID)
            .ToListAsync();

        if (!ogretmenDersleri.Any())
        {
            ToastService.Notify(ToastSeverity.Warning, "Uyarı", "Henüz dersiniz bulunmamaktadır. Önce ders oluşturun.");
            return;
        }

        // Sınıf adını al
        var sinifAdi = await DbContext.Siniflar
            .Where(x => x.ID == sinifId)
            .Select(x => x.Adi)
            .FirstOrDefaultAsync();

        // Bu sınıfta zaten ders programı var mı kontrol et
        var mevcutProgramlar = await DbContext.DersProgramlari
            .Where(x => ogretmenDersleri.Contains(x.Ders_ID) && x.Sinif_ID == sinifId && (x.DelDate == null || x.DelDate == default(DateTime)))
            .Select(x => x.Ders_ID)
            .Distinct()
            .ToListAsync();

        // Henüz bu sınıfta programı olmayan dersleri göster
        var eklenebilecekDersler = ogretmenDersleri.Where(d => !mevcutProgramlar.Contains(d)).ToList();

        if (!eklenebilecekDersler.Any())
        {
            ToastService.Notify(ToastSeverity.Info, "Bilgi", "Bu sınıfta zaten tüm dersleriniz programlanmış.");
            return;
        }

        // Kullanıcıya hangi derslere program eklemek istediğini sor
        ToastService.Notify(ToastSeverity.Info, "Bilgi", $"{sinifAdi} sınıfında programı olmayan {eklenebilecekDersler.Count} dersiniz var. Ders programı sayfasına yönlendiriliyorsunuz.");
        ModalService.Close(sinifId);
    }
}
