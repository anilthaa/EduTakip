@page "/reset-password/{token}"
@rendermode InteractiveServer
@layout EmptyLayout
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IToastService ToastService

<PageTitle>Şifre Sıfırla</PageTitle>

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <h2>Şifre Sıfırla</h2>
            <p>Yeni şifrenizi belirleyin</p>
        </div>

        <RadzenTemplateForm Data="@resetPasswordModel" TItem="ResetPasswordModel" Submit="@OnResetPassword" class="auth-form">
            <div class="auth-form-inner">
                <RadzenFormField Text="Yeni Şifre" Style="width:100%;">
                    <ChildContent>
                        <RadzenPassword @bind-Value="resetPasswordModel.YeniSifre" Placeholder="En az 6 karakter" Style="width:100%;" />
                    </ChildContent>
                </RadzenFormField>

                <RadzenFormField Text="Yeni Şifre (Tekrar)" Style="width:100%;">
                    <ChildContent>
                        <RadzenPassword @bind-Value="resetPasswordModel.YeniSifreTekrar" Placeholder="Şifrenizi tekrar girin" Style="width:100%;" />
                    </ChildContent>
                </RadzenFormField>

                @if (!string.IsNullOrWhiteSpace(resetPasswordModel.YeniSifre))
                {
                    <div class="auth-alert auth-alert-info">
                        <strong>Şifre Gereksinimleri:</strong>
                        <ul style="margin: 0.5rem 0 0 1.25rem; padding-left: 0.5rem;">
                            <li style="color: @(resetPasswordModel.YeniSifre.Length >= 6 ? "#4caf50" : "#f44336");">
                                En az 6 karakter @(resetPasswordModel.YeniSifre.Length >= 6 ? "✓" : "")
                            </li>
                            <li style="color: @(resetPasswordModel.YeniSifre.Length <= 100 ? "#4caf50" : "#f44336");">
                                En fazla 100 karakter @(resetPasswordModel.YeniSifre.Length <= 100 ? "✓" : "")
                            </li>
                        </ul>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(resetPasswordModel.YeniSifre) && resetPasswordModel.YeniSifre.Length < 6)
                {
                    <div class="auth-alert auth-alert-warning">
                        <strong>Uyarı:</strong> Şifre en az 6 karakter olmalıdır.
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(resetPasswordModel.YeniSifre) && resetPasswordModel.YeniSifre.Length > 100)
                {
                    <div class="auth-alert auth-alert-danger">
                        <strong>Hata:</strong> Şifre en fazla 100 karakter olabilir.
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(resetPasswordModel.YeniSifre) &&
                                !string.IsNullOrWhiteSpace(resetPasswordModel.YeniSifreTekrar) &&
                                resetPasswordModel.YeniSifre != resetPasswordModel.YeniSifreTekrar)
                {
                    <div class="auth-alert auth-alert-danger">
                        <strong>Hata:</strong> Şifreler eşleşmiyor. Lütfen aynı şifreyi girin.
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(resetPasswordModel.YeniSifre) &&
                                !string.IsNullOrWhiteSpace(resetPasswordModel.YeniSifreTekrar) &&
                                resetPasswordModel.YeniSifre == resetPasswordModel.YeniSifreTekrar &&
                                resetPasswordModel.YeniSifre.Length >= 6 &&
                                resetPasswordModel.YeniSifre.Length <= 100)
                {
                    <div class="auth-alert auth-alert-success">
                        <strong>Hazır:</strong> Şifreler eşleşiyor ve gereksinimleri karşılıyor.
                    </div>
                }

                <div class="auth-actions">
                    <RadzenButton ButtonType="ButtonType.Submit"
                                  Text="Şifreyi Sıfırla"
                                  Icon="lock_reset"
                                  IsBusy="@isLoading"
                                  ButtonStyle="ButtonStyle.Primary"
                                  class="w-100"
                                  Style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);" />
                </div>
            </div>
        </RadzenTemplateForm>

        <div class="auth-footer">
            <RadzenLink Path="/login" Text="Giriş sayfasına dön" />
        </div>
    </div>
</div>

@code {
    [Parameter] public string Token { get; set; } = "";

    private ResetPasswordModel resetPasswordModel = new();
    private bool isLoading = false;

    public class ResetPasswordModel
    {
        public string YeniSifre { get; set; } = "";
        public string YeniSifreTekrar { get; set; } = "";
    }

    private async Task OnResetPassword(ResetPasswordModel model)
    {
        if (isLoading) return;

        // Token kontrolü
        if (string.IsNullOrWhiteSpace(Token))
        {
            ToastService.ShowError("Hata", "Geçersiz veya eksik token.", 4000);
            return;
        }

        // Şifre validasyonu
        if (string.IsNullOrWhiteSpace(model.YeniSifre))
        {
            ToastService.ShowWarning("Uyarı", "Lütfen yeni şifrenizi girin.", 4000);
            return;
        }

        if (model.YeniSifre.Length < 6)
        {
            ToastService.ShowWarning("Uyarı", "Şifre en az 6 karakter olmalıdır.", 4000);
            return;
        }

        if (model.YeniSifre.Length > 100)
        {
            ToastService.ShowWarning("Uyarı", "Şifre en fazla 100 karakter olabilir.", 4000);
            return;
        }

        if (model.YeniSifre != model.YeniSifreTekrar)
        {
            ToastService.ShowWarning("Uyarı", "Şifreler eşleşmiyor. Lütfen tekrar kontrol edin.", 4000);
            return;
        }

        isLoading = true;
        StateHasChanged();

        try
        {
            var request = new ResetPasswordRequest(Token, model.YeniSifre);
            var result = await AuthService.ResetPasswordAsync(request);

            if (result)
            {
                ToastService.ShowSuccess("Başarılı", "Şifreniz başarıyla sıfırlandı. Giriş yapabilirsiniz.", 4000);

                await Task.Delay(2000);
                Navigation.NavigateTo("/login");
            }
            else
            {
                ToastService.ShowError("Hata", "Şifre sıfırlanamadı. Token geçersiz veya süresi dolmuş olabilir.", 5000);
            }
        }
        catch (HttpRequestException ex)
        {
            ToastService.ShowError("Hata", ex.Message, 5000);
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Hata", $"Bir hata oluştu: {ex.Message}", 5000);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}
