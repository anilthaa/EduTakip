@page "/reset-password/{token}"
@layout EmptyLayout

<PageTitle>Şifre Sıfırla</PageTitle>

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <h2>Şifre Sıfırla</h2>
            <p>Yeni şifrenizi belirleyin</p>
        </div>

        <RadzenTemplateForm Data="@resetPasswordModel" TItem="ResetPasswordModel" Submit="@OnResetPassword" class="auth-form">
            <div class="auth-form-inner">
                <RadzenFormField Text="Yeni Şifre" Style="width:100%;">
                    <ChildContent>
                        <RadzenPassword @bind-Value="resetPasswordModel.YeniSifre" Placeholder="En az 6 karakter" Style="width:100%;" />
                    </ChildContent>
                </RadzenFormField>

                <RadzenFormField Text="Yeni Şifre (Tekrar)" Style="width:100%;">
                    <ChildContent>
                        <RadzenPassword @bind-Value="resetPasswordModel.YeniSifreTekrar" Placeholder="Şifrenizi tekrar girin" Style="width:100%;" />
                    </ChildContent>
                </RadzenFormField>

                <div class="password-requirements">
                    <span class="req-title">Şifre Gereksinimleri</span>
                    <ul class="req-list">
                        <li class="@(SifreVar && resetPasswordModel.YeniSifre.Length >= 6 ? "req-ok" : "req-fail")">
                            <span class="req-icon">@(SifreVar && resetPasswordModel.YeniSifre.Length >= 6 ? "✓" : "○")</span>
                            En az 6 karakter
                        </li>
                        <li class="@(SifreVar && resetPasswordModel.YeniSifre.Length <= 100 ? "req-ok" : "req-fail")">
                            <span class="req-icon">@(SifreVar && resetPasswordModel.YeniSifre.Length <= 100 ? "✓" : "○")</span>
                            En fazla 100 karakter
                        </li>
                        <li class="@(SifreTekrarVar && resetPasswordModel.YeniSifre == resetPasswordModel.YeniSifreTekrar ? "req-ok" : SifreTekrarVar ? "req-fail" : "req-pending")">
                            <span class="req-icon">@(SifreTekrarVar && resetPasswordModel.YeniSifre == resetPasswordModel.YeniSifreTekrar ? "✓" : SifreTekrarVar ? "✗" : "○")</span>
                            Şifreler eşleşiyor
                        </li>
                    </ul>
                </div>

                <div class="auth-actions">
                    <RadzenButton ButtonType="ButtonType.Submit"
                                  Text="Şifreyi Sıfırla"
                                  Icon="lock_reset"
                                  IsBusy="@isLoading"
                                  Disabled="@(!FormGecerli)"
                                  ButtonStyle="ButtonStyle.Primary"
                                  class="w-100"
                                  Style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);" />
                </div>
            </div>
        </RadzenTemplateForm>

        <div class="auth-footer">
            <RadzenLink Path="/login" Text="Giriş sayfasına dön" />
        </div>
    </div>
</div>

@code {
    [Parameter] public string Token { get; set; } = "";

    private ResetPasswordModel resetPasswordModel = new();
    private bool isLoading = false;

    private bool SifreVar => !string.IsNullOrWhiteSpace(resetPasswordModel.YeniSifre);
    private bool SifreTekrarVar => !string.IsNullOrWhiteSpace(resetPasswordModel.YeniSifreTekrar);
    private bool FormGecerli => SifreVar && SifreTekrarVar
        && resetPasswordModel.YeniSifre.Length >= 6
        && resetPasswordModel.YeniSifre.Length <= 100
        && resetPasswordModel.YeniSifre == resetPasswordModel.YeniSifreTekrar;

    public class ResetPasswordModel
    {
        public string YeniSifre { get; set; } = "";
        public string YeniSifreTekrar { get; set; } = "";
    }

    private async Task OnResetPassword(ResetPasswordModel model)
    {
        if (isLoading) return;

        // Token kontrolü
        if (string.IsNullOrWhiteSpace(Token))
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Hata",
                Detail = "Geçersiz veya eksik token.",
                Duration = 4000
            });
            return;
        }

        // Şifre validasyonu
        if (string.IsNullOrWhiteSpace(model.YeniSifre))
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Uyarı",
                Detail = "Lütfen yeni şifrenizi girin.",
                Duration = 4000
            });
            return;
        }

        if (model.YeniSifre.Length < 6)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Uyarı",
                Detail = "Şifre en az 6 karakter olmalıdır.",
                Duration = 4000
            });
            return;
        }

        if (model.YeniSifre.Length > 100)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Uyarı",
                Detail = "Şifre en fazla 100 karakter olabilir.",
                Duration = 4000
            });
            return;
        }

        if (model.YeniSifre != model.YeniSifreTekrar)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Uyarı",
                Detail = "Şifreler eşleşmiyor. Lütfen tekrar kontrol edin.",
                Duration = 4000
            });
            return;
        }

        isLoading = true;
        StateHasChanged();

        try
        {
            var request = new ResetPasswordRequest(Token, model.YeniSifre);
            var result = await AuthService.ResetPasswordAsync(request);

            if (result)
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Başarılı",
                    Detail = "Şifreniz başarıyla sıfırlandı. Giriş yapabilirsiniz.",
                    Duration = 4000
                });

                await Task.Delay(2000);
                NavigationManager.NavigateTo("/login");
            }
            else
            {
                NotificationService.Notify(NotificationSeverity.Error, "Hata", "Şifre sıfırlanamadı. Token geçersiz veya süresi dolmuş olabilir.", 5000);
            }
        }
        catch (HttpRequestException ex)
        {
            NotificationService.Notify(NotificationSeverity.Error,"Hata", "Sunucu ile ilgili bir hata oluştu lütfen daha sonra tekrar deneyin.",5000);
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Hata", $"Bir hata oluştu: {ex.Message}", 5000);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}
