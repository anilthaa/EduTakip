@page "/reset-password/{token}"
@layout EmptyLayout

<PageTitle>Şifre Sıfırla</PageTitle>

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <h2>Şifre Sıfırla</h2>
            <p>Yeni şifrenizi belirleyin</p>
        </div>

        <form @onsubmit="OnResetPassword" @onsubmit:preventDefault class="auth-form">
            <div class="auth-form-inner">
                <div class="form-group">
                    <label class="form-label">Yeni Şifre</label>
                    <PasswordInput @bind-Value="resetPasswordModel.YeniSifre" Placeholder="En az 6 karakter" />
                </div>

                <div class="form-group">
                    <label class="form-label">Yeni Şifre (Tekrar)</label>
                    <PasswordInput @bind-Value="resetPasswordModel.YeniSifreTekrar" Placeholder="Şifrenizi tekrar girin" />
                </div>

                <div class="password-requirements">
                    <span class="req-title">Şifre Gereksinimleri</span>
                    <ul class="req-list">
                        <li class="@(SifreVar && resetPasswordModel.YeniSifre.Length >= 6 ? "req-ok" : "req-fail")">
                            <span class="req-icon">@(SifreVar && resetPasswordModel.YeniSifre.Length >= 6 ? "✓" : "○")</span>
                            En az 6 karakter
                        </li>
                        <li class="@(SifreVar && resetPasswordModel.YeniSifre.Length <= 100 ? "req-ok" : "req-fail")">
                            <span class="req-icon">@(SifreVar && resetPasswordModel.YeniSifre.Length <= 100 ? "✓" : "○")</span>
                            En fazla 100 karakter
                        </li>
                        <li class="@(SifreTekrarVar && resetPasswordModel.YeniSifre == resetPasswordModel.YeniSifreTekrar ? "req-ok" : SifreTekrarVar ? "req-fail" : "req-pending")">
                            <span class="req-icon">@(SifreTekrarVar && resetPasswordModel.YeniSifre == resetPasswordModel.YeniSifreTekrar ? "✓" : SifreTekrarVar ? "✗" : "○")</span>
                            Şifreler eşleşiyor
                        </li>
                    </ul>
                </div>

                <div class="auth-actions">
                    <button type="submit"
                            class="btn btn-gradient btn-auth-primary @(isLoading ? "btn-loading" : "")"
                            disabled="@(isLoading || !FormGecerli)">
                        Şifreyi Sıfırla
                    </button>
                </div>
            </div>
        </form>

        <div class="auth-footer">
            <a href="/login">Giriş sayfasına dön</a>
        </div>
    </div>
</div>

@code {
    [Parameter] public string Token { get; set; } = "";

    private ResetPasswordModel resetPasswordModel = new();
    private bool isLoading = false;

    private bool SifreVar => !string.IsNullOrWhiteSpace(resetPasswordModel.YeniSifre);
    private bool SifreTekrarVar => !string.IsNullOrWhiteSpace(resetPasswordModel.YeniSifreTekrar);
    private bool FormGecerli => SifreVar && SifreTekrarVar
        && resetPasswordModel.YeniSifre.Length >= 6
        && resetPasswordModel.YeniSifre.Length <= 100
        && resetPasswordModel.YeniSifre == resetPasswordModel.YeniSifreTekrar;

    public class ResetPasswordModel
    {
        public string YeniSifre { get; set; } = "";
        public string YeniSifreTekrar { get; set; } = "";
    }

    private async Task OnResetPassword()
    {
        if (isLoading) return;

        if (string.IsNullOrWhiteSpace(Token))
        {
            ToastService.Notify(ToastSeverity.Error, "Hata", "Geçersiz veya eksik token.", 4000);
            return;
        }

        if (string.IsNullOrWhiteSpace(resetPasswordModel.YeniSifre))
        {
            ToastService.Notify(ToastSeverity.Warning, "Uyarı", "Lütfen yeni şifrenizi girin.", 4000);
            return;
        }

        if (resetPasswordModel.YeniSifre.Length < 6)
        {
            ToastService.Notify(ToastSeverity.Warning, "Uyarı", "Şifre en az 6 karakter olmalıdır.", 4000);
            return;
        }

        if (resetPasswordModel.YeniSifre.Length > 100)
        {
            ToastService.Notify(ToastSeverity.Warning, "Uyarı", "Şifre en fazla 100 karakter olabilir.", 4000);
            return;
        }

        if (resetPasswordModel.YeniSifre != resetPasswordModel.YeniSifreTekrar)
        {
            ToastService.Notify(ToastSeverity.Warning, "Uyarı", "Şifreler eşleşmiyor. Lütfen tekrar kontrol edin.", 4000);
            return;
        }

        isLoading = true;
        StateHasChanged();

        try
        {
            var request = new ResetPasswordRequest(Token, resetPasswordModel.YeniSifre);
            var result = await AuthService.ResetPasswordAsync(request);

            if (result)
            {
                ToastService.Notify(ToastSeverity.Success, "Başarılı", "Şifreniz başarıyla sıfırlandı. Giriş yapabilirsiniz.", 4000);

                await Task.Delay(2000);
                NavigationManager.NavigateTo("/login");
            }
            else
            {
                ToastService.Notify(ToastSeverity.Error, "Hata", "Şifre sıfırlanamadı. Token geçersiz veya süresi dolmuş olabilir.", 5000);
            }
        }
        catch (HttpRequestException ex)
        {
            ToastService.Notify(ToastSeverity.Error, "Hata", "Sunucu ile ilgili bir hata oluştu lütfen daha sonra tekrar deneyin.", 5000);
        }
        catch (Exception ex)
        {
            ToastService.Notify(ToastSeverity.Error, "Hata", $"Bir hata oluştu: {ex.Message}", 5000);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}
