@page "/siniflar"
@attribute [Authorize(Roles ="Öğretmen,Öğrenci")]
<PageTitle>Sınıflar</PageTitle>

<div class="flex-stack gap-lg">
    <div class="page-header">
        <h4 class="page-title">Sınıflar</h4>
        <button class="btn btn-success" @onclick="SinifaKatilDialogAc">
            <span class="material-icons">add</span> Sınıfa Katıl
        </button>
    </div>

    @if (katildigimSiniflar.Any())
    {
        <div class="grid grid-2">
            @foreach (var sinif in katildigimSiniflar)
            {
                <div class="card">
                    <div class="card-body">
                        <div class="flex-stack gap-md">
                            <div class="flex-row justify-between items-center">
                                <h5 style="margin: 0;">@sinif.Sinif.Adi</h5>
                                <span class="badge badge-success">Katıldınız</span>
                            </div>

                            <div class="flex-row gap-sm">
                                <button class="btn btn-primary btn-sm" @onclick="() => SinifaGit(sinif.Sinif_ID)">
                                    <span class="material-icons">dashboard</span> Sınıfa Git
                                </button>
                                <button class="btn btn-danger btn-sm" @onclick="() => Ayril(sinif.Sinif_ID)">
                                    <span class="material-icons">logout</span> Sınıftan Ayrıl
                                </button>

                                @if (isOgretmen)
                                {
                                    <button class="btn btn-info btn-sm" @onclick="() => Ogrenciler(sinif.Sinif_ID)">
                                        <span class="material-icons">group</span> Öğrenciler
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body">
                <div class="empty-state">
                    <span class="material-icons">class</span>
                    <p>Henüz hiçbir sınıfa katılmadınız. Üstteki "Sınıfa Katıl" butonuna tıklayarak sınıflara katılabilirsiniz.</p>
                </div>
            </div>
        </div>
    }
</div>

@code {
    List<ItemSinifKullanici> katildigimSiniflar = new();
    int kullaniciId;
    string tip = "";
    bool isOgretmen => tip == "Öğretmen";
    bool isOgrenci => tip == "Öğrenci";

    protected override async Task OnInitializedAsync()
    {
        var kullanici = AuthStateService.CurrentUser;
        if (kullanici == null)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }
        kullaniciId = kullanici.ID;
        tip = kullanici.KullaniciTip;

        await Yukle();
    }

    async Task Yukle()
    {
        katildigimSiniflar = await DbContext.SinifKullanicilar
            .Include(x => x.Sinif)
            .Where(x => x.Kullanici_ID == kullaniciId && (x.DelDate == null || x.DelDate == default(DateTime)))
            .OrderBy(x => x.Sinif.Adi)
            .ToListAsync();
    }

    async Task SinifaKatilDialogAc()
    {
        var result = await ModalService.OpenAsync<Components.Pages.Shared.SinifaKatilDialogBasit>("Sınıfa Katıl",
            new Dictionary<string, object>()
            {
                { "KullaniciId", kullaniciId },
                { "KullaniciTip", tip }
            },
            new ModalOptions() { CssClass = "modal-md" });

        if (result is true)
        {
            await Yukle();
            StateHasChanged();
        }
    }

    async Task Ayril(int sinifId)
    {
        var kayit = katildigimSiniflar.FirstOrDefault(x => x.Sinif_ID == sinifId);
        if (kayit == null)
            return;

        bool confirm = await JSRuntime.InvokeAsync<bool>("confirm",
            $"'{kayit.Sinif.Adi}' sınıfından ayrılmak istediğinize emin misiniz?");

        if (confirm)
        {
            kayit.DelDate = DateTime.UtcNow;
            kayit.DelUser = kullaniciId;
            DbContext.SinifKullanicilar.Update(kayit);
            await DbContext.SaveChangesAsync();
            await Yukle();
            ToastService.Notify(ToastSeverity.Success, "Başarılı", "Sınıftan ayrıldınız.", 4000);
            StateHasChanged();
        }
    }

    void Ogrenciler(int sinifId)
    {
        NavigationManager.NavigateTo($"/ogretmen/sinif-ogrencileri/{sinifId}");
    }

    void SinifaGit(int sinifId)
    {
        if (isOgretmen)
        {
            NavigationManager.NavigateTo($"/ogretmen/sinif/{sinifId}");
        }
        else
        {
            NavigationManager.NavigateTo($"/ogrenci/sinif/{sinifId}");
        }
    }
}
