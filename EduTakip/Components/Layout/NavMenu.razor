<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="/dashboard">EduTakip</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()" style="display:flex; flex-direction:column;">
    <nav class="nav flex-column" style="flex:1">
        @* Herkes için Anasayfa *@
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/dashboard" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Anasayfa
            </NavLink>
        </div>

        @* Admin menüleri *@
        @if (IsAdmin)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/admin/birimler" Match="NavLinkMatch.All">
                    <span class="bi bi-building" aria-hidden="true"></span> Birim Listesi
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/admin/siniflar" Match="NavLinkMatch.All">
                    <span class="bi bi-people" aria-hidden="true"></span> Sınıf Listesi
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/admin/dersler" Match="NavLinkMatch.All">
                    <span class="bi bi-book" aria-hidden="true"></span> Ders Listesi
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/admin/ders-programlari" Match="NavLinkMatch.All">
                    <span class="bi bi-calendar" aria-hidden="true"></span> Ders Programı Listesi
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/admin/kullanicilar" Match="NavLinkMatch.All">
                    <span class="bi bi-person" aria-hidden="true"></span> Kullanıcı Listesi
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/admin/bekleyen-hesaplar" Match="NavLinkMatch.All">
                    <span class="bi bi-hourglass-split" aria-hidden="true"></span> Onay Bekleyen
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/admin/kullanici-tipleri" Match="NavLinkMatch.All">
                    <span class="bi bi-person-badge" aria-hidden="true"></span> Kullanıcı Tip Listesi
                </NavLink>
            </div>
        }

        @* Öğrenci menüleri *@
        @if (IsOgrenci)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/ogrenci/dersprogrami" Match="NavLinkMatch.All">
                    <span class="bi bi-calendar" aria-hidden="true"></span> Ders Programım
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/siniflar" Match="NavLinkMatch.All">
                    <span class="bi bi-people" aria-hidden="true"></span> Sınıflar
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/ogrenci/derslerim" Match="NavLinkMatch.All">
                    <span class="bi bi-book" aria-hidden="true"></span> Derslerim
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/ogrenci/notlarim" Match="NavLinkMatch.All">
                    <span class="bi bi-clipboard-check" aria-hidden="true"></span> Notlarım
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/ogrenci/odevlerim" Match="NavLinkMatch.All">
                    <span class="bi bi-file-earmark-text" aria-hidden="true"></span> Ödevlerim
                </NavLink>
            </div>
        }

        @* Öğretmen menüleri *@
        @if (IsOgretmen)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/siniflar" Match="NavLinkMatch.All">
                    <span class="bi bi-people" aria-hidden="true"></span> Sınıflarım
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/ogretmen/dersler" Match="NavLinkMatch.All">
                    <span class="bi bi-book" aria-hidden="true"></span> Derslerim
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/ogretmen/dersprogrami" Match="NavLinkMatch.All">
                    <span class="bi bi-calendar" aria-hidden="true"></span> Ders Programım
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/ogretmen/yoklama" Match="NavLinkMatch.All">
                    <span class="bi bi-check2-square" aria-hidden="true"></span> Yoklama Al
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/ogretmen/yoklama-gecmisi" Match="NavLinkMatch.All">
                    <span class="bi bi-clock-history" aria-hidden="true"></span> Yoklama Geçmişi
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/ogretmen/odevler" Match="NavLinkMatch.All">
                    <span class="bi bi-file-earmark-text" aria-hidden="true"></span> Ödevlerim
                </NavLink>
            </div>
        }
        <div class="nav-item px-3" style="margin-top:auto; display:flex; flex-direction:column; gap:8px; align-items:stretch;">
        @if (AuthStateService.CurrentUser != null)
        {
            <a href="/profil" style="color: white; display: flex; align-items: center; gap: 8px; text-decoration: none; padding: 6px 0; cursor: pointer;"
               title="Profili Görüntüle">
                <span class="material-icons" style="font-size: 24px;">account_circle</span>
                <span>@AuthStateService.CurrentUser.Adi @AuthStateService.CurrentUser.Soyadi</span>
            </a>
            <button class="btn btn-danger btn-sm btn-block" @onclick="Logout" style="width:100%;">
                <span class="material-icons" style="font-size:16px;">logout</span> Çıkış
            </button>
        }
        </div>
        
    </nav>
</div>

@code {
    private bool IsAdmin => GetUserType().Contains("admin");
    private bool IsOgrenci => GetUserType().Contains("öğrenci") || GetUserType().Contains("ogrenci") || GetUserType().Contains("student");
    private bool IsOgretmen => GetUserType().Contains("öğretmen") || GetUserType().Contains("ogretmen") || GetUserType().Contains("teacher");

    private string GetUserType()
    {
        return AuthStateService.CurrentUser?.KullaniciTip?.ToLower() ?? "";
    }

    private async Task Logout()
    {
        await AuthStateService.LogoutAsync();
        NavigationManager.NavigateTo("/login", true);
    }
}
