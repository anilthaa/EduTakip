<div class="toast-container">
    @foreach (var toast in toasts)
    {
        <div class="toast @toast.Type" data-toast-id="@toast.Id">
            <div class="toast-content">
                <div class="toast-icon">
                    @if (toast.Type == "success")
                    {
                        <span>✓</span>
                    }
                    else if (toast.Type == "error")
                    {
                        <span>✕</span>
                    }
                    else if (toast.Type == "warning")
                    {
                        <span>⚠</span>
                    }
                    else
                    {
                        <span>ℹ</span>
                    }
                </div>
                <div class="toast-message">
                    <div class="toast-title">@toast.Title</div>
                    @if (!string.IsNullOrEmpty(toast.Message))
                    {
                        <div class="toast-text">@toast.Message</div>
                    }
                </div>
                <button class="toast-close" @onclick="@(() => RemoveToast(toast.Id))">×</button>
            </div>
        </div>
    }
</div>

@inject IToastService ToastService
@implements IDisposable
@rendermode InteractiveServer

@code {
    private List<ToastItem> toasts = new();
    private Action<ToastItem>? _toastHandler;

    protected override void OnInitialized()
    {
        _toastHandler = HandleToast;
        ToastService.OnShow += _toastHandler;
    }

    private async void HandleToast(ToastItem toast)
    {
        await InvokeAsync(() =>
        {
            toasts.Add(toast);
            StateHasChanged();

            if (toast.Duration > 0)
            {
                _ = Task.Run(async () =>
                {
                    await Task.Delay(toast.Duration);
                    await InvokeAsync(() =>
                    {
                        RemoveToast(toast.Id);
                    });
                });
            }
        });
    }

    private void RemoveToast(Guid id)
    {
        var toast = toasts.FirstOrDefault(t => t.Id == id);
        if (toast != null)
        {
            toasts.Remove(toast);
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        if (_toastHandler != null)
        {
            ToastService.OnShow -= _toastHandler;
        }
    }
}

